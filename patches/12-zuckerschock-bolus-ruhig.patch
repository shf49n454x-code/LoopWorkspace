+/// Uhrzeiten für Laufzeit-Ende und Bolus, gleich in App, Widget und Sperrbildschirm.
+enum ZSZeitText {
+    static func uhrzeit(_ datum: Date) -> String {
+        datum.formatted(.dateTime.hour(.twoDigits(amPM: .omitted)).minute(.twoDigits).locale(Locale(identifier: "de_DE")))
+    }
+
+    /// „heute 18:30“, „morgen 16:00“, „Sa. 16:00“ oder „abgelaufen“.
+    static func ende(_ ende: Date, jetzt: Date) -> String {
+        if ende <= jetzt { return "abgelaufen" }
+        let k = Calendar.current
+        let uhr = uhrzeit(ende)
+        if k.isDateInToday(ende) { return "heute \(uhr)" }
+        if k.isDateInTomorrow(ende) { return "morgen \(uhr)" }
+        return "\(ende.formatted(.dateTime.weekday(.abbreviated).locale(Locale(identifier: "de_DE")))) \(uhr)"
+    }
+
+    /// „4,5 IE“
+    static func einheiten(_ ie: Double) -> String {
+        "\(ie.formatted(.number.precision(.fractionLength(0...2)).locale(Locale(identifier: "de_DE")))) IE"
+    }
+}
