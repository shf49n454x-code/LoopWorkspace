diff --git a/Loop/Loop/Zuckerschock/ZuckerschockWidgetGemeinsam.swift b/Loop/Loop/Zuckerschock/ZuckerschockWidgetGemeinsam.swift
new file mode 100644
index 0000000..b69d648
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockWidgetGemeinsam.swift
@@ -0,0 +1,76 @@
+//
+//  ZuckerschockWidgetGemeinsam.swift
+//  Loop + Loop Widget Extension
+//
+//  Zuckerschock: kleiner Datenstand für Widgets. Die App schreibt ihn in die App-Gruppe,
+//  die Widgets lesen ihn nur. Werte immer mit Einheit, Trend und Alter.
+//
+
+import Foundation
+import LoopCore
+
+struct ZSWidgetStand: Codable, Equatable {
+    enum Zustand: String, Codable { case tief, ziel, hoch }
+
+    var erstellt: Date
+    var mgdl: Double?
+    var wertText: String
+    var einheitText: String
+    var trendPfeil: String
+    var aenderungText: String?
+    var wertDatum: Date?
+    var zustand: Zustand?
+    var insulinAktivText: String?
+    var khAktivText: String?
+    /// Letzte 3 Stunden, mg/dl, ältester zuerst; jeweils mit Sekunden vor `erstellt`.
+    var kurve: [Double]
+    var kurveSekundenVorher: [Double]
+    var letzteMahlzeit: String?
+    var vorratText: String?
+    var loopAktiv: Bool
+    /// Wert im gesperrten Zustand ausblenden (Einstellung in der App).
+    var wertVerbergen: Bool
+
+    static let schluessel = "Zuckerschock.WidgetStand"
+    static let kindSperr = "ZuckerschockSperrbildschirm"
+    static let kindHome = "ZuckerschockHome"
+
+    static func lesen() -> ZSWidgetStand? {
+        guard let daten = UserDefaults.appGroup?.data(forKey: schluessel) else { return nil }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        return try? decoder.decode(ZSWidgetStand.self, from: daten)
+    }
+
+    func schreiben() {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .secondsSince1970
+        guard let daten = try? encoder.encode(self) else { return }
+        UserDefaults.appGroup?.set(daten, forKey: Self.schluessel)
+    }
+
+    /// Älter als 10 Minuten?
+    func istAlt(am datum: Date) -> Bool {
+        guard let wertDatum else { return true }
+        return datum.timeIntervalSince(wertDatum) > 10 * 60
+    }
+
+    func alterText(am datum: Date) -> String? {
+        guard let wertDatum else { return nil }
+        let minuten = max(0, Int(datum.timeIntervalSince(wertDatum) / 60))
+        return minuten < 60 ? "vor \(minuten) Min" : "vor \(minuten / 60) Std"
+    }
+
+    static let beispiel = ZSWidgetStand(
+        erstellt: Date(), mgdl: 118, wertText: "118", einheitText: "mg/dl", trendPfeil: "→", aenderungText: "−2",
+        wertDatum: Date().addingTimeInterval(-120), zustand: .ziel, insulinAktivText: "1,35", khAktivText: "24",
+        kurve: [104, 108, 128, 156, 177, 180, 166, 137, 126, 119, 116, 117, 114, 118],
+        kurveSekundenVorher: (0..<14).map { Double(13 - $0) * 800 },
+        letzteMahlzeit: "Spaghetti Bolognese · 72 g", vorratText: "3 Pods · bis So, 8. Nov.", loopAktiv: true, wertVerbergen: false)
+}
+
+/// Öffnet die Kamera der Foto-KH (Kontrollzentrum, Action-Button, Widget).
+enum ZSDeeplink {
+    static let fotoKH = URL(string: "zuckerschock://foto-kh")!
+    static let heute = URL(string: "zuckerschock://heute")!
+}
diff --git a/Loop/Loop/Zuckerschock/ZuckerschockWidgets.swift b/Loop/Loop/Zuckerschock/ZuckerschockWidgets.swift
new file mode 100644
index 0000000..f64af85
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockWidgets.swift
@@ -0,0 +1,325 @@
+//
+//  ZuckerschockWidgets.swift
+//  Loop Widget Extension
+//
+//  Zuckerschock-Widgets: Sperrbildschirm (rund, rechteckig, inline), StandBy und Home (klein, mittel, groß),
+//  Kontrollzentrum „Foto-KH“. Überall: Wert, Einheit, Trend, Alter. Orange nur als kleiner Markenpunkt.
+//
+
+import AppIntents
+import SwiftUI
+import WidgetKit
+
+// MARK: - Zeitleiste
+
+struct ZSWidgetEintrag: TimelineEntry {
+    var date: Date
+    var stand: ZSWidgetStand?
+}
+
+struct ZSWidgetQuelle: TimelineProvider {
+    func placeholder(in context: Context) -> ZSWidgetEintrag {
+        ZSWidgetEintrag(date: Date(), stand: .beispiel)
+    }
+
+    func getSnapshot(in context: Context, completion: @escaping (ZSWidgetEintrag) -> Void) {
+        completion(ZSWidgetEintrag(date: Date(), stand: context.isPreview ? (ZSWidgetStand.lesen() ?? .beispiel) : ZSWidgetStand.lesen()))
+    }
+
+    func getTimeline(in context: Context, completion: @escaping (Timeline<ZSWidgetEintrag>) -> Void) {
+        let jetzt = Date()
+        let stand = ZSWidgetStand.lesen()
+        // Jede Minute ein Eintrag für die nächste halbe Stunde, damit das Alter mitläuft.
+        let eintraege = (0..<30).map { ZSWidgetEintrag(date: jetzt.addingTimeInterval(Double($0) * 60), stand: stand) }
+        completion(Timeline(entries: eintraege, policy: .after(jetzt.addingTimeInterval(30 * 60))))
+    }
+}
+
+// MARK: - Farben im Widget
+
+private enum ZSWFarbe {
+    static func zustand(_ zustand: ZSWidgetStand.Zustand?) -> Color {
+        switch zustand {
+        case .tief: return ZSFarbe.tief
+        case .hoch: return ZSFarbe.hoch
+        case .ziel: return ZSFarbe.ziel
+        case nil: return ZSFarbe.text3
+        }
+    }
+
+    static func wort(_ zustand: ZSWidgetStand.Zustand?) -> String {
+        switch zustand {
+        case .tief: return "Unter Ziel"
+        case .hoch: return "Über Ziel"
+        case .ziel: return "Im Ziel"
+        case nil: return "Kein Wert"
+        }
+    }
+}
+
+// MARK: - Sperrbildschirm
+
+struct ZSSperrWidget: Widget {
+    var body: some WidgetConfiguration {
+        StaticConfiguration(kind: ZSWidgetStand.kindSperr, provider: ZSWidgetQuelle()) { eintrag in
+            ZSSperrAnsicht(eintrag: eintrag)
+                .containerBackground(for: .widget) { Color.clear }
+                .widgetURL(ZSDeeplink.heute)
+        }
+        .configurationDisplayName("Zucker")
+        .description("Wert, Trend und Alter auf dem Sperrbildschirm.")
+        .supportedFamilies([.accessoryCircular, .accessoryRectangular, .accessoryInline])
+    }
+}
+
+private struct ZSSperrAnsicht: View {
+    var eintrag: ZSWidgetEintrag
+    @Environment(\.widgetFamily) private var familie
+
+    var body: some View {
+        let stand = eintrag.stand
+        let alt = stand?.istAlt(am: eintrag.date) ?? true
+        let verbergen = stand?.wertVerbergen ?? false
+
+        switch familie {
+        case .accessoryCircular:
+            ZStack {
+                AccessoryWidgetBackground()
+                VStack(spacing: -2) {
+                    Text(stand?.wertText ?? "–")
+                        .font(.system(size: 20, weight: .semibold, design: .rounded))
+                        .monospacedDigit()
+                        .minimumScaleFactor(0.6)
+                        .privacySensitive(verbergen)
+                    Text(alt ? (stand?.alterText(am: eintrag.date) ?? "") : (stand?.trendPfeil ?? ""))
+                        .font(.system(size: alt ? 10 : 14, weight: .semibold))
+                        .minimumScaleFactor(0.6)
+                }
+            }
+            .accessibilityElement(children: .combine)
+        case .accessoryInline:
+            Text(inlineText(stand: stand, alt: alt))
+                .privacySensitive(verbergen)
+        default:
+            HStack(spacing: 8) {
+                VStack(alignment: .leading, spacing: 0) {
+                    HStack(alignment: .firstTextBaseline, spacing: 3) {
+                        Text(stand?.wertText ?? "–")
+                            .font(.system(size: 26, weight: .semibold, design: .rounded))
+                            .monospacedDigit()
+                            .privacySensitive(verbergen)
+                        Text(stand?.trendPfeil ?? "")
+                            .font(.headline)
+                    }
+                    Text(alt ? (stand?.alterText(am: eintrag.date) ?? "kein Wert") : "\(stand?.einheitText ?? "") · \(ZSWFarbe.wort(stand?.zustand))")
+                        .font(.caption2.weight(.medium))
+                        .lineLimit(1)
+                }
+                ZSMiniKurve(werte: stand?.kurve ?? [], sekunden: stand?.kurveSekundenVorher ?? [], linie: .primary, flaeche: false)
+                    .frame(maxWidth: .infinity, maxHeight: .infinity)
+            }
+            .accessibilityElement(children: .combine)
+        }
+    }
+
+    private func inlineText(stand: ZSWidgetStand?, alt: Bool) -> String {
+        guard let stand else { return "Zuckerschock: kein Wert" }
+        var teile = ["\(stand.wertText) \(stand.trendPfeil)"]
+        if alt, let alter = stand.alterText(am: eintrag.date) { teile.append(alter) }
+        if let iob = stand.insulinAktivText { teile.append("IOB \(iob)") }
+        return teile.joined(separator: " · ")
+    }
+}
+
+// MARK: - Home und StandBy
+
+struct ZSHomeWidget: Widget {
+    var body: some WidgetConfiguration {
+        StaticConfiguration(kind: ZSWidgetStand.kindHome, provider: ZSWidgetQuelle()) { eintrag in
+            ZSHomeAnsicht(eintrag: eintrag)
+                .containerBackground(for: .widget) { ZSFarbe.grund }
+                .widgetURL(ZSDeeplink.heute)
+        }
+        .configurationDisplayName("Zuckerschock")
+        .description("Zucker, Kurve, aktives Insulin und KH, letzte Mahlzeit und Vorrat.")
+        .supportedFamilies([.systemSmall, .systemMedium, .systemLarge])
+    }
+}
+
+private struct ZSHomeAnsicht: View {
+    var eintrag: ZSWidgetEintrag
+    @Environment(\.widgetFamily) private var familie
+    @Environment(\.widgetRenderingMode) private var darstellung
+
+    private var vollfarbig: Bool { darstellung == .fullColor }
+
+    var body: some View {
+        let stand = eintrag.stand
+        switch familie {
+        case .systemSmall:
+            klein(stand)
+        case .systemMedium:
+            HStack(spacing: 12) {
+                klein(stand)
+                    .frame(maxWidth: 120)
+                kurveMitKennzahlen(stand)
+            }
+        default:
+            VStack(alignment: .leading, spacing: 12) {
+                HStack(spacing: 12) {
+                    klein(stand)
+                        .frame(maxWidth: 130)
+                    kurveMitKennzahlen(stand)
+                }
+                .frame(maxHeight: .infinity)
+                Divider().overlay(ZSFarbe.haarlinie)
+                zeile("Letzte Mahlzeit", stand?.letzteMahlzeit ?? "noch keine")
+                zeile("Vorrat", stand?.vorratText ?? "nicht eingetragen")
+            }
+        }
+    }
+
+    /// Großer Wert; StandBy nutzt diese Größe und tönt nachts selbst rot.
+    private func klein(_ stand: ZSWidgetStand?) -> some View {
+        let alt = stand?.istAlt(am: eintrag.date) ?? true
+        return VStack(alignment: .leading, spacing: 2) {
+            HStack(spacing: 4) {
+                Circle()
+                    .fill(vollfarbig ? ZSFarbe.orange : Color.primary)
+                    .frame(width: 6, height: 6)
+                    .accessibilityHidden(true)
+                Text("Zucker")
+                    .font(.caption2.weight(.medium))
+                    .foregroundStyle(vollfarbig ? ZSFarbe.text2 : Color.secondary)
+            }
+            Spacer(minLength: 0)
+            HStack(alignment: .firstTextBaseline, spacing: 3) {
+                Text(stand?.wertText ?? "–")
+                    .font(.system(size: 48, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .minimumScaleFactor(0.5)
+                    .lineLimit(1)
+                    .foregroundStyle(alt || !vollfarbig ? AnyShapeStyle(Color.primary.opacity(alt ? 0.6 : 1)) : AnyShapeStyle(ZSFarbe.text))
+                    .privacySensitive(stand?.wertVerbergen ?? false)
+                Text(stand?.trendPfeil ?? "")
+                    .font(.title3.weight(.semibold))
+                    .foregroundStyle(vollfarbig ? ZSFarbe.text : Color.primary)
+            }
+            Text(stand?.einheitText ?? "")
+                .font(.caption.weight(.medium))
+                .foregroundStyle(vollfarbig ? ZSFarbe.text2 : Color.secondary)
+            HStack(spacing: 4) {
+                if !alt {
+                    Circle()
+                        .fill(vollfarbig ? ZSWFarbe.zustand(stand?.zustand) : Color.primary)
+                        .frame(width: 7, height: 7)
+                }
+                Text(alt ? (stand?.alterText(am: eintrag.date) ?? "kein Wert") : ZSWFarbe.wort(stand?.zustand))
+                    .font(.caption.weight(.semibold))
+                    .foregroundStyle(vollfarbig ? (alt ? ZSFarbe.text3 : ZSWFarbe.zustand(stand?.zustand)) : Color.primary)
+            }
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .leading)
+        .accessibilityElement(children: .combine)
+    }
+
+    private func kurveMitKennzahlen(_ stand: ZSWidgetStand?) -> some View {
+        VStack(alignment: .leading, spacing: 6) {
+            ZSMiniKurve(werte: stand?.kurve ?? [], sekunden: stand?.kurveSekundenVorher ?? [],
+                        linie: vollfarbig ? ZSFarbe.orangeLinie : Color.primary, flaeche: vollfarbig)
+                .frame(maxHeight: .infinity)
+            HStack {
+                kennzahl("IE aktiv", stand?.insulinAktivText ?? "–")
+                Spacer()
+                kennzahl("KH aktiv", (stand?.khAktivText).map { "\($0) g" } ?? "–")
+            }
+        }
+    }
+
+    private func kennzahl(_ label: String, _ wert: String) -> some View {
+        VStack(alignment: .leading, spacing: 0) {
+            Text(wert)
+                .font(.system(.headline, design: .rounded))
+                .monospacedDigit()
+                .foregroundStyle(vollfarbig ? ZSFarbe.text : Color.primary)
+            Text(label)
+                .font(.caption2)
+                .foregroundStyle(vollfarbig ? ZSFarbe.text2 : Color.secondary)
+        }
+        .accessibilityElement(children: .combine)
+    }
+
+    private func zeile(_ label: String, _ wert: String) -> some View {
+        HStack {
+            Text(label)
+                .font(.caption)
+                .foregroundStyle(vollfarbig ? ZSFarbe.text2 : Color.secondary)
+            Spacer()
+            Text(wert)
+                .font(.caption.weight(.semibold))
+                .foregroundStyle(vollfarbig ? ZSFarbe.text : Color.primary)
+                .lineLimit(1)
+        }
+        .accessibilityElement(children: .combine)
+    }
+}
+
+/// Kleine Kurve der letzten 3 Stunden mit Zielband.
+private struct ZSMiniKurve: View {
+    var werte: [Double]
+    var sekunden: [Double]
+    var linie: Color
+    var flaeche: Bool
+
+    var body: some View {
+        GeometryReader { geo in
+            let r = CGRect(origin: .zero, size: geo.size)
+            let unten = min(60, (werte.min() ?? 60) - 10)
+            let oben = max(200, (werte.max() ?? 200) + 10)
+            let spanne = max(1, sekunden.max() ?? 10_800)
+            let punkt: (Int) -> CGPoint = { i in
+                let x = r.width * CGFloat(1 - sekunden[i] / spanne)
+                let y = r.height * CGFloat(1 - (werte[i] - unten) / (oben - unten))
+                return CGPoint(x: x, y: y)
+            }
+            ZStack(alignment: .topLeading) {
+                Rectangle()
+                    .fill(Color.primary.opacity(0.06))
+                    .frame(height: r.height * CGFloat((180 - 70) / (oben - unten)))
+                    .offset(y: r.height * CGFloat(1 - (180 - unten) / (oben - unten)))
+                if werte.count == sekunden.count, werte.count > 1 {
+                    if flaeche {
+                        Path { p in
+                            p.move(to: CGPoint(x: punkt(0).x, y: r.maxY))
+                            for i in werte.indices { p.addLine(to: punkt(i)) }
+                            p.addLine(to: CGPoint(x: punkt(werte.count - 1).x, y: r.maxY))
+                            p.closeSubpath()
+                        }
+                        .fill(LinearGradient(colors: [ZSFarbe.orange.opacity(0.3), ZSFarbe.orange.opacity(0)], startPoint: .top, endPoint: .bottom))
+                    }
+                    Path { p in
+                        p.move(to: punkt(0))
+                        for i in werte.indices.dropFirst() { p.addLine(to: punkt(i)) }
+                    }
+                    .stroke(linie, style: StrokeStyle(lineWidth: 2, lineCap: .round, lineJoin: .round))
+                }
+            }
+        }
+        .accessibilityHidden(true)
+    }
+}
