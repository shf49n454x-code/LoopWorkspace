@@ -0,0 +1,122 @@
+//
+//  ZuckerschockHypoGemeinsam.swift
+//  Loop + Loop Widget Extension
+//
+//  Zuckerschock: gemeinsame Teile des Hypo-Begleiters für App und Live Activity.
+//  Ruhig, ohne Marke: kein Orange, kein Blitz, kein Humor. Mengen nur aus dem Therapieplan.
+//
+
+import ActivityKit
+import AppIntents
+import Foundation
+import SwiftUI
+
+struct ZSHypoAttribute: ActivityAttributes {
+    struct ContentState: Codable, Hashable {
+        /// Aktueller Wert in mg/dl und als fertiger Text in der Einheit des Nutzers.
+        var mgdl: Double
+        var wertText: String
+        var einheitText: String
+        var trendPfeil: String
+        var wertDatum: Date
+        var steigt: Bool
+        /// Zuletzt gegessen und bis wann gewartet wird (laut Plan).
+        var gegessenUm: Date?
+        var warteBis: Date?
+        var gegessenAnzahl: Int
+        /// „5 Plättchen à 3 g“ aus dem Plan, sonst „schnelle KH nach deinem Plan“.
+        var mengeText: String
+        var nachts: Bool
+        var wiederImZiel: Bool
+    }
+
+    var start: Date
+}
+
+/// Brücke von der Live Activity in die App: Der Intent läuft im App-Prozess.
+enum ZSHypoBruecke {
+    static var gegessen: (() -> Void)?
+}
+
+@available(iOS 17.0, *)
+struct ZSHypoGegessenIntent: LiveActivityIntent {
+    static let title: LocalizedStringResource = "Gegessen"
+    static let description = IntentDescription("Trägt ein, dass du schnelle Kohlenhydrate gegessen hast.")
+
+    init() {}
+
+    func perform() async throws -> some IntentResult {
+        await MainActor.run { ZSHypoBruecke.gegessen?() }
+        return .result()
+    }
+}
+
+/// Farben des Begleiters: tags ruhig, nachts rot gedimmt.
+enum ZSHypoFarbe {
+    static func text(nachts: Bool) -> Color {
+        nachts ? Color(red: 0.75, green: 0.18, blue: 0.18) : Color(red: 0.97, green: 0.95, blue: 0.93)
+    }
+
+    static func text2(nachts: Bool) -> Color {
+        nachts ? Color(red: 0.55, green: 0.13, blue: 0.13) : Color(red: 0.97, green: 0.95, blue: 0.93).opacity(0.66)
+    }
+
+    /// tief (Unterzucker), gedimmt bei Nacht.
+    static func tief(nachts: Bool) -> Color {
+        nachts ? Color(red: 0.6, green: 0.14, blue: 0.14) : Color(red: 1, green: 0.42, blue: 0.42)
+    }
+
+    static let grund = Color.black
+
+    /// 22 bis 6 Uhr gilt als Nacht.
+    static func istNacht(_ datum: Date = Date()) -> Bool {
+        let stunde = Calendar.current.component(.hour, from: datum)
+        return stunde >= 22 || stunde < 6
+    }
+}
+
+/// Countdown-Ring „Warte noch …“.
+struct ZSHypoRing: View {
+    var gegessenUm: Date?
+    var warteBis: Date?
+    var nachts: Bool
+    var groesse: CGFloat = 56
+
+    var body: some View {
+        ZStack {
+            Circle()
+                .stroke(ZSHypoFarbe.text2(nachts: nachts).opacity(0.3), lineWidth: groesse * 0.1)
+            if let gegessenUm, let warteBis, warteBis > gegessenUm {
+                ProgressView(timerInterval: gegessenUm...warteBis, countsDown: true) {
+                    EmptyView()
+                } currentValueLabel: {
+                    EmptyView()
+                }
+                .progressViewStyle(.circular)
+                .tint(ZSHypoFarbe.text(nachts: nachts))
+                .labelsHidden()
+                .frame(width: groesse, height: groesse)
+                Text(timerInterval: gegessenUm...warteBis, countsDown: true, showsHours: false)
+                    .font(.system(size: groesse * 0.24, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .multilineTextAlignment(.center)
+                    .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                    .frame(width: groesse * 0.8)
+            } else {
+                Image(systemName: "fork.knife")
+                    .font(.system(size: groesse * 0.32))
+                    .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+            }
+        }
+        .frame(width: groesse, height: groesse)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(warteBis.map { $0 > Date() ? "Warten bis \(Self.uhrzeit($0))" : "Wartezeit vorbei" } ?? "Noch nichts gegessen")
+    }
+
+    static func uhrzeit(_ datum: Date) -> String {
+        let f = DateFormatter()
+        f.locale = Locale(identifier: "de_DE")
+        f.dateFormat = "HH:mm"
+        return f.string(from: datum)
+    }
+}
diff --git a/Loop/Loop/Zuckerschock/ZuckerschockHypoLiveActivity.swift b/Loop/Loop/Zuckerschock/ZuckerschockHypoLiveActivity.swift
new file mode 100644
index 0000000..b9c0223
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockHypoLiveActivity.swift
@@ -0,0 +1,140 @@
+//
+//  ZuckerschockHypoLiveActivity.swift
+//  Loop Widget Extension
+//
+//  Zuckerschock: Live Activity und Dynamic Island des Hypo-Begleiters.
+//  Ruhig, ohne Orange, ohne Blitz. Nachts rot gedimmt.
+//
+
+import ActivityKit
+import AppIntents
+import SwiftUI
+import WidgetKit
+
+@available(iOS 17.0, *)
+struct ZSHypoLiveActivity: Widget {
+    var body: some WidgetConfiguration {
+        ActivityConfiguration(for: ZSHypoAttribute.self) { context in
+            ZSHypoSperrbildschirm(stand: context.state)
+                .activityBackgroundTint(ZSHypoFarbe.grund)
+                .activitySystemActionForegroundColor(ZSHypoFarbe.text(nachts: context.state.nachts))
+        } dynamicIsland: { context in
+            let stand = context.state
+            let nachts = stand.nachts
+            return DynamicIsland {
+                DynamicIslandExpandedRegion(.leading) {
+                    VStack(alignment: .leading, spacing: 0) {
+                        HStack(alignment: .firstTextBaseline, spacing: 2) {
+                            Text(stand.wertText)
+                                .font(.system(size: 34, weight: .semibold, design: .rounded))
+                                .monospacedDigit()
+                            Text(stand.trendPfeil)
+                                .font(.title3.weight(.semibold))
+                        }
+                        Text(stand.einheitText)
+                            .font(.caption)
+                            .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+                    }
+                    .foregroundStyle(stand.wiederImZiel ? ZSHypoFarbe.text(nachts: nachts) : ZSHypoFarbe.tief(nachts: nachts))
+                    .padding(.leading, 4)
+                }
+                DynamicIslandExpandedRegion(.trailing) {
+                    ZSHypoRing(gegessenUm: stand.gegessenUm, warteBis: stand.warteBis, nachts: nachts, groesse: 52)
+                        .padding(.trailing, 4)
+                }
+                DynamicIslandExpandedRegion(.bottom) {
+                    ZSHypoUnterzeile(stand: stand)
+                }
+            } compactLeading: {
+                Text(stand.wertText)
+                    .font(.system(.body, design: .rounded).weight(.semibold))
+                    .monospacedDigit()
+                    .foregroundStyle(ZSHypoFarbe.tief(nachts: nachts))
+            } compactTrailing: {
+                if let gegessenUm = stand.gegessenUm, let warteBis = stand.warteBis, warteBis > Date() {
+                    Text(timerInterval: gegessenUm...warteBis, countsDown: true, showsHours: false)
+                        .monospacedDigit()
+                        .frame(maxWidth: 44)
+                        .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                } else {
+                    Text(stand.trendPfeil)
+                        .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                }
+            } minimal: {
+                Text(stand.wertText)
+                    .font(.system(.caption, design: .rounded).weight(.semibold))
+                    .foregroundStyle(ZSHypoFarbe.tief(nachts: nachts))
+            }
+            .keylineTint(ZSHypoFarbe.tief(nachts: nachts))
+        }
+    }
+}
+
+@available(iOS 17.0, *)
+private struct ZSHypoSperrbildschirm: View {
+    var stand: ZSHypoAttribute.ContentState
+
+    var body: some View {
+        let nachts = stand.nachts
+        HStack(alignment: .center, spacing: 14) {
+            VStack(alignment: .leading, spacing: 2) {
+                Text(stand.wiederImZiel ? "Wieder im Ziel" : "Unterzucker")
+                    .font(.subheadline.weight(.semibold))
+                    .foregroundStyle(stand.wiederImZiel ? ZSHypoFarbe.text(nachts: nachts) : ZSHypoFarbe.tief(nachts: nachts))
+                HStack(alignment: .firstTextBaseline, spacing: 4) {
+                    Text(stand.wertText)
+                        .font(.system(size: 40, weight: .semibold, design: .rounded))
+                        .monospacedDigit()
+                    Text(stand.einheitText)
+                        .font(.footnote.weight(.medium))
+                        .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+                    Text(stand.trendPfeil)
+                        .font(.title3.weight(.semibold))
+                }
+                .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                ZSHypoUnterzeile(stand: stand)
+            }
+            Spacer(minLength: 8)
+            ZSHypoRing(gegessenUm: stand.gegessenUm, warteBis: stand.warteBis, nachts: nachts, groesse: 64)
+        }
+        .padding(16)
+    }
+}
+
+/// Handlung plus Taste „Gegessen“. Die Taste gibt es nur, solange noch nichts eingetragen ist;
+/// zweites Eintragen nur in der App durch Halten.
+@available(iOS 17.0, *)
+private struct ZSHypoUnterzeile: View {
+    var stand: ZSHypoAttribute.ContentState
+
+    var body: some View {
+        let nachts = stand.nachts
+        HStack(spacing: 10) {
+            Text(text)
+                .font(.footnote)
+                .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                .lineLimit(2)
+            Spacer(minLength: 4)
+            if stand.gegessenAnzahl == 0 && !stand.wiederImZiel {
+                Button(intent: ZSHypoGegessenIntent()) {
+                    Text("Gegessen")
+                        .font(.footnote.weight(.semibold))
+                        .padding(.horizontal, 14)
+                        .padding(.vertical, 8)
+                }
+                .buttonStyle(.plain)
+                .foregroundStyle(Color.black)
+                .background(Capsule().fill(ZSHypoFarbe.text(nachts: nachts)))
+            }
+        }
+    }
+
+    private var text: String {
+        if stand.wiederImZiel { return "Wieder im Ziel. Der Begleiter endet gleich." }
+        if let warteBis = stand.warteBis, warteBis > Date() {
+            return stand.steigt ? "Steigt bereits, nicht nachessen." : "Gegessen. Warte noch bis \(ZSHypoRing.uhrzeit(warteBis))."
+        }
+        if stand.gegessenAnzahl == 0 { return "Jetzt \(stand.mengeText) essen." }
+        return stand.steigt ? "Steigt. Weiter beobachten." : "Noch unter Ziel: \(stand.mengeText) essen."
+    }
+}
