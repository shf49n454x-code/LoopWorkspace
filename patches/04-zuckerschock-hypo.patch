diff --git a/Loop/Loop/Zuckerschock/ZuckerschockHypo.swift b/Loop/Loop/Zuckerschock/ZuckerschockHypo.swift
new file mode 100644
index 0000000..ef334c1
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockHypo.swift
@@ -0,0 +1,585 @@
+//
+//  ZuckerschockHypo.swift
+//  Loop
+//
+//  Zuckerschock: Hypo-Begleiter. Startet bei Unterzucker eine Live Activity mit der Taste „Gegessen“,
+//  zählt die Wartezeit laut Plan herunter und sagt, wenn der Zucker schon steigt.
+//  Ohne Marke, ohne Humor. Mengen und Wartezeit kommen aus dem Therapieplan, nie von der App.
+//
+
+import ActivityKit
+import Combine
+import Foundation
+import HealthKit
+import LoopCore
+import LoopKit
+import SwiftUI
+import UserNotifications
+
+// MARK: - Modell
+
+struct ZSHypoEpisode: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var start: Date
+    var ende: Date?
+    var tiefsterWert: Double
+    var gegessen: [Date] = []
+    var plaettchenJeMal: Int?
+
+    var dauer: TimeInterval? { ende.map { $0.timeIntervalSince(start) } }
+}
+
+/// Reine Entscheidungslogik, ohne Seiteneffekte.
+enum ZSHypoRegeln {
+    static let startUnter: Double = 70
+    static let endeAb: Double = 80
+
+    static func sollStarten(mgdl: Double, alter: TimeInterval, aktiv: Bool) -> Bool {
+        !aktiv && alter <= .minutes(10) && mgdl < startUnter
+    }
+
+    static func sollEnden(mgdl: Double, alter: TimeInterval, aktiv: Bool) -> Bool {
+        aktiv && alter <= .minutes(10) && mgdl >= endeAb
+    }
+
+    static func steigt(_ trend: GlucoseTrend?) -> Bool {
+        guard let trend else { return false }
+        return [.up, .upUp, .upUpUp].contains(trend)
+    }
+
+    /// Text der Menge laut Plan, ohne eigene Berechnung.
+    static func mengeText(_ plan: ZSTherapieplan) -> String {
+        if let anzahl = plan.hypoPlaettchen, let gramm = plan.hypoGrammJePlaettchen {
+            return "\(anzahl) Plättchen à \(ZSFormat.zahl(gramm, stellen: gramm.rounded() == gramm ? 0 : 1)) g"
+        }
+        return "schnelle KH nach deinem Plan"
+    }
+
+    static func warteMinuten(_ plan: ZSTherapieplan) -> Int {
+        plan.hypoWarteMinuten ?? 15
+    }
+}
+
+// MARK: - Begleiter
+
+final class ZSHypoBegleiter: ObservableObject {
+    @Published private(set) var aktiv: ZSHypoEpisode?
+    @Published private(set) var verlauf: [ZSHypoEpisode] = []
+    @Published private(set) var zustand: ZSHypoAttribute.ContentState?
+
+    private let speicher: ZSSpeicher
+    private let datei: URL
+    private var abos = Set<AnyCancellable>()
+    private var aktivitaet: Any?
+    /// Liefert den neuesten Wert: mg/dl, Datum, Trend.
+    private let neuesterWert: () -> (mgdl: Double, datum: Date, trend: GlucoseTrend?)?
+    private let einheit: () -> HKUnit
+
+    init(speicher: ZSSpeicher,
+         ordner: URL? = nil,
+         aenderungen: AnyPublisher<Void, Never>,
+         neuesterWert: @escaping () -> (mgdl: Double, datum: Date, trend: GlucoseTrend?)?,
+         einheit: @escaping () -> HKUnit) {
+        self.speicher = speicher
+        self.neuesterWert = neuesterWert
+        self.einheit = einheit
+        let basis = ordner ?? (FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? FileManager.default.temporaryDirectory)
+        let verzeichnis = basis.appendingPathComponent("Zuckerschock", isDirectory: true)
+        try? FileManager.default.createDirectory(at: verzeichnis, withIntermediateDirectories: true)
+        datei = verzeichnis.appendingPathComponent("hypos.json")
+        laden()
+
+        ZSHypoBruecke.gegessen = { [weak self] in self?.gegessen() }
+
+        aenderungen
+            .receive(on: DispatchQueue.main)
+            .sink { [weak self] in self?.pruefen() }
+            .store(in: &abos)
+        Timer.publish(every: 60, on: .main, in: .common)
+            .autoconnect()
+            .sink { [weak self] _ in self?.aktualisieren() }
+            .store(in: &abos)
+        // Live Activities lassen sich nur im Vordergrund starten: nachholen, sobald die App aktiv wird.
+        NotificationCenter.default.publisher(for: UIApplication.didBecomeActiveNotification)
+            .receive(on: DispatchQueue.main)
+            .sink { [weak self] _ in self?.liveActivityNachholen() }
+            .store(in: &abos)
+    }
+
+    convenience init(deviceManager: DeviceDataManager, speicher: ZSSpeicher) {
+        let center = NotificationCenter.default
+        let aenderungen = center.publisher(for: .LoopDataUpdated, object: deviceManager.loopManager)
+            .map { _ in () }
+            .eraseToAnyPublisher()
+        self.init(speicher: speicher, aenderungen: aenderungen, neuesterWert: { [weak deviceManager] in
+            guard let wert = deviceManager?.glucoseStore.latestGlucose else { return nil }
+            return (wert.quantity.doubleValue(for: .milligramsPerDeciliter), wert.startDate, wert.trend)
+        }, einheit: { [weak deviceManager] in deviceManager?.displayGlucosePreference.unit ?? .milligramsPerDeciliter })
+    }
+
+    // MARK: Speichern
+
+    private func laden() {
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        guard let daten = try? Data(contentsOf: datei),
+              let gespeichert = try? decoder.decode(Gespeichert.self, from: daten) else { return }
+        verlauf = gespeichert.verlauf
+        aktiv = gespeichert.aktiv
+    }
+
+    private func sichern() {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        guard let daten = try? encoder.encode(Gespeichert(aktiv: aktiv, verlauf: verlauf)) else { return }
+        try? daten.write(to: datei, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    }
+
+    private struct Gespeichert: Codable {
+        var aktiv: ZSHypoEpisode?
+        var verlauf: [ZSHypoEpisode]
+    }
+
+    // MARK: Ablauf
+
+    func pruefen(jetzt: Date = Date()) {
+        guard let wert = neuesterWert() else { return }
+        let alter = jetzt.timeIntervalSince(wert.datum)
+
+        if ZSHypoRegeln.sollStarten(mgdl: wert.mgdl, alter: alter, aktiv: aktiv != nil) {
+            starten(mgdl: wert.mgdl, jetzt: jetzt)
+        } else if var episode = aktiv {
+            if wert.mgdl < episode.tiefsterWert {
+                episode.tiefsterWert = wert.mgdl
+                aktiv = episode
+                sichern()
+            }
+            if ZSHypoRegeln.sollEnden(mgdl: wert.mgdl, alter: alter, aktiv: true) {
+                beenden(jetzt: jetzt, wiederImZiel: true)
+                return
+            }
+        }
+        aktualisieren(jetzt: jetzt)
+    }
+
+    func starten(mgdl: Double, jetzt: Date = Date()) {
+        aktiv = ZSHypoEpisode(start: jetzt, tiefsterWert: mgdl, plaettchenJeMal: speicher.plan.hypoPlaettchen)
+        sichern()
+        aktualisieren(jetzt: jetzt)
+        liveActivityStarten()
+        mitteilen()
+    }
+
+    /// Erstes Eintragen per Tipp; weiteres Eintragen nur durch Halten (in der App).
+    func gegessen(jetzt: Date = Date()) {
+        guard var episode = aktiv else { return }
+        episode.gegessen.append(jetzt)
+        aktiv = episode
+        sichern()
+        aktualisieren(jetzt: jetzt)
+    }
+
+    func beenden(jetzt: Date = Date(), wiederImZiel: Bool = false) {
+        guard var episode = aktiv else { return }
+        episode.ende = jetzt
+        verlauf.insert(episode, at: 0)
+        aktiv = nil
+        sichern()
+        if var stand = zustand {
+            stand.wiederImZiel = wiederImZiel
+            zustand = nil
+            liveActivityBeenden(mit: stand)
+        } else {
+            liveActivityBeenden(mit: nil)
+        }
+    }
+
+    private func aktualisieren(jetzt: Date = Date()) {
+        guard let episode = aktiv else {
+            zustand = nil
+            return
+        }
+        let wert = neuesterWert()
+        let mgdl = wert?.mgdl ?? episode.tiefsterWert
+        let gegessenUm = episode.gegessen.last
+        let neu = ZSHypoAttribute.ContentState(
+            mgdl: mgdl,
+            wertText: ZSFormat.glukose(mgdl, einheit()),
+            einheitText: ZSFormat.einheit(einheit()),
+            trendPfeil: wert?.trend.map { ZSTrend($0).pfeil } ?? "",
+            wertDatum: wert?.datum ?? episode.start,
+            steigt: ZSHypoRegeln.steigt(wert?.trend),
+            gegessenUm: gegessenUm,
+            warteBis: gegessenUm?.addingTimeInterval(.minutes(Double(ZSHypoRegeln.warteMinuten(speicher.plan)))),
+            gegessenAnzahl: episode.gegessen.count,
+            mengeText: ZSHypoRegeln.mengeText(speicher.plan),
+            nachts: ZSHypoFarbe.istNacht(jetzt),
+            wiederImZiel: false)
+        if neu != zustand {
+            zustand = neu
+            liveActivityAktualisieren(neu)
+        }
+    }
+
+    // MARK: Live Activity
+
+    /// Läuft eine Episode ohne Live Activity (Start im Hintergrund oder App neu gestartet), wird sie jetzt gestartet.
+    private func liveActivityNachholen() {
+        guard aktiv != nil else { return }
+        aktualisieren()
+        guard #available(iOS 16.2, *), laufendeAktivitaet() == nil else { return }
+        liveActivityStarten()
+    }
+
+    @available(iOS 16.2, *)
+    private func laufendeAktivitaet() -> Activity<ZSHypoAttribute>? {
+        if let eigene = aktivitaet as? Activity<ZSHypoAttribute> { return eigene }
+        // Nach einem Neustart der App kennt nur ActivityKit die laufende Live Activity.
+        let gefunden = Activity<ZSHypoAttribute>.activities.first { $0.activityState == .active }
+        aktivitaet = gefunden
+        return gefunden
+    }
+
+    private func liveActivityStarten() {
+        guard #available(iOS 16.2, *), let stand = zustand, let episode = aktiv else { return }
+        guard ActivityAuthorizationInfo().areActivitiesEnabled else { return }
+        guard laufendeAktivitaet() == nil else {
+            liveActivityAktualisieren(stand)
+            return
+        }
+        do {
+            aktivitaet = try Activity.request(
+                attributes: ZSHypoAttribute(start: episode.start),
+                content: .init(state: stand, staleDate: Date().addingTimeInterval(.minutes(15))),
+                pushType: nil)
+        } catch {
+            // Ohne Live Activity bleibt die Mitteilung und die Karte auf Heute.
+        }
+    }
+
+    private func liveActivityAktualisieren(_ stand: ZSHypoAttribute.ContentState) {
+        guard #available(iOS 16.2, *), let aktivitaet = laufendeAktivitaet() else { return }
+        Task {
+            await aktivitaet.update(.init(state: stand, staleDate: Date().addingTimeInterval(.minutes(15))))
+        }
+    }
+
+    private func liveActivityBeenden(mit stand: ZSHypoAttribute.ContentState?) {
+        guard #available(iOS 16.2, *) else { return }
+        let laufend = (aktivitaet as? Activity<ZSHypoAttribute>).map { [$0] } ?? Activity<ZSHypoAttribute>.activities
+        aktivitaet = nil
+        Task {
+            for eintrag in laufend {
+                if let stand {
+                    await eintrag.end(.init(state: stand, staleDate: nil), dismissalPolicy: .after(Date().addingTimeInterval(.minutes(10))))
+                } else {
+                    await eintrag.end(nil, dismissalPolicy: .immediate)
+                }
+            }
+        }
+    }
+
+    // MARK: Mitteilung (zeitkritisch)
+
+    private func mitteilen() {
+        guard let stand = zustand else { return }
+        let inhalt = UNMutableNotificationContent()
+        inhalt.title = "Unterzucker: \(stand.wertText) \(stand.einheitText)"
+        inhalt.body = "Jetzt \(stand.mengeText) essen."
+        inhalt.sound = .default
+        inhalt.interruptionLevel = .timeSensitive
+        let anfrage = UNNotificationRequest(identifier: "Zuckerschock.Hypo", content: inhalt, trigger: nil)
+        UNUserNotificationCenter.current().add(anfrage)
+    }
+
+    // MARK: Statistik
+
+    struct Statistik {
+        var anzahl: Int
+        var nachts: Int
+        var tiefster: Double?
+        var mittlereDauer: TimeInterval?
+        var plaettchen: Int
+    }
+
+    func statistik(tage: Int, jetzt: Date = Date()) -> Statistik {
+        let ab = jetzt.addingTimeInterval(-.days(Double(tage)))
+        let episoden = verlauf.filter { $0.start >= ab }
+        let dauern = episoden.compactMap(\.dauer)
+        return Statistik(
+            anzahl: episoden.count,
+            nachts: episoden.filter { ZSHypoFarbe.istNacht($0.start) }.count,
+            tiefster: episoden.map(\.tiefsterWert).min(),
+            mittlereDauer: dauern.isEmpty ? nil : dauern.reduce(0, +) / Double(dauern.count),
+            plaettchen: episoden.reduce(0) { $0 + $1.gegessen.count * ($1.plaettchenJeMal ?? 0) })
+    }
+}
+
+#if targetEnvironment(simulator)
+extension ZSHypoBegleiter {
+    /// Laufende Episode mit Beispielwerten für Screenshots.
+    static func vorschau(speicher: ZSSpeicher, gegessenVorMinuten: Double?, nachts: Bool) -> ZSHypoBegleiter {
+        let jetzt = Date()
+        let begleiter = ZSHypoBegleiter(
+            speicher: speicher,
+            ordner: FileManager.default.temporaryDirectory.appendingPathComponent("ZSVorschau-\(UUID().uuidString)"),
+            aenderungen: Empty().eraseToAnyPublisher(),
+            neuesterWert: { (62, jetzt.addingTimeInterval(-.minutes(2)), gegessenVorMinuten == nil ? .down : .up) },
+            einheit: { .milligramsPerDeciliter })
+        begleiter.verlauf = [
+            ZSHypoEpisode(start: jetzt.addingTimeInterval(-TimeInterval.days(2.125)), ende: jetzt.addingTimeInterval(-TimeInterval.days(2.108)), tiefsterWert: 61, gegessen: [jetzt], plaettchenJeMal: 5),
+            ZSHypoEpisode(start: jetzt.addingTimeInterval(-TimeInterval.days(6)), ende: jetzt.addingTimeInterval(TimeInterval.minutes(35) - TimeInterval.days(6)), tiefsterWert: 54, gegessen: [jetzt, jetzt], plaettchenJeMal: 5)
+        ]
+        begleiter.aktiv = ZSHypoEpisode(start: jetzt.addingTimeInterval(-.minutes(6)), tiefsterWert: 62,
+                                        gegessen: gegessenVorMinuten.map { [jetzt.addingTimeInterval(-.minutes($0))] } ?? [], plaettchenJeMal: 5)
+        begleiter.aktualisieren(jetzt: jetzt)
+        if nachts, var stand = begleiter.zustand {
+            stand.nachts = true
+            begleiter.zustand = stand
+        }
+        return begleiter
+    }
+}
+#endif
+
+// MARK: - Ansicht
+
+struct ZSHypoView: View {
+    @ObservedObject var begleiter: ZSHypoBegleiter
+    var schliessen: () -> Void
+
+    @State private var haltFortschritt: Double = 0
+
+    var body: some View {
+        let stand = begleiter.zustand
+        let nachts = stand?.nachts ?? ZSHypoFarbe.istNacht()
+
+        ZStack {
+            ZSHypoFarbe.grund.ignoresSafeArea()
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space6) {
+                    HStack {
+                        Text("Unterzucker-Begleiter")
+                            .font(ZSSchrift.title3)
+                            .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                            .accessibilityAddTraits(.isHeader)
+                        Spacer()
+                        Button("Schließen", action: schliessen)
+                            .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+                            .frame(minHeight: ZSMass.tap)
+                    }
+
+                    if let stand, begleiter.aktiv != nil {
+                        laufend(stand, nachts: nachts)
+                    } else {
+                        Text("Gerade kein Unterzucker. Der Begleiter startet von selbst unter 70 mg/dl.")
+                            .font(ZSSchrift.body)
+                            .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+                    }
+
+                    statistik(nachts: nachts)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .preferredColorScheme(.dark)
+    }
+
+    @ViewBuilder
+    private func laufend(_ stand: ZSHypoAttribute.ContentState, nachts: Bool) -> some View {
+        VStack(alignment: .leading, spacing: ZSMass.space2) {
+            HStack(alignment: .firstTextBaseline, spacing: ZSMass.space2) {
+                Text(stand.wertText)
+                    .zsZahl(.wertHero)
+                    .foregroundStyle(ZSHypoFarbe.tief(nachts: nachts))
+                Text(stand.einheitText)
+                    .zsZahl(.einheit)
+                    .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+                Text(stand.trendPfeil)
+                    .font(.title.weight(.semibold))
+                    .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+            }
+            .accessibilityElement(children: .combine)
+            Text(ZSFormat.istAlt(stand.wertDatum, jetzt: Date()) ? "Wert \(ZSFormat.alter(von: stand.wertDatum, jetzt: Date()))" : "Unter Ziel")
+                .font(ZSSchrift.subhead.weight(.semibold))
+                .foregroundStyle(ZSHypoFarbe.tief(nachts: nachts))
+        }
+
+        HStack(spacing: ZSMass.space4) {
+            ZSHypoRing(gegessenUm: stand.gegessenUm, warteBis: stand.warteBis, nachts: nachts, groesse: 88)
+            VStack(alignment: .leading, spacing: ZSMass.space1) {
+                if let warteBis = stand.warteBis, warteBis > Date() {
+                    Text("Warte noch bis \(ZSHypoRing.uhrzeit(warteBis))")
+                        .font(ZSSchrift.headline)
+                        .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                    if stand.steigt {
+                        Text("Steigt bereits, nicht nachessen.")
+                            .font(ZSSchrift.body)
+                            .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                    }
+                } else if stand.gegessenAnzahl == 0 {
+                    Text("Jetzt \(stand.mengeText) essen.")
+                        .font(ZSSchrift.headline)
+                        .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                } else {
+                    Text(stand.steigt ? "Steigt. Weiter beobachten." : "Wartezeit vorbei. Noch unter Ziel: \(stand.mengeText) essen.")
+                        .font(ZSSchrift.headline)
+                        .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                }
+                Text("\(stand.gegessenAnzahl)× gegessen · \(stand.mengeText)")
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+            }
+        }
+
+        if stand.gegessenAnzahl == 0 {
+            Button {
+                begleiter.gegessen()
+            } label: {
+                Text("Gegessen")
+                    .font(ZSSchrift.headline)
+                    .frame(maxWidth: .infinity, minHeight: 56)
+                    .foregroundStyle(Color.black)
+                    .background(Capsule().fill(ZSHypoFarbe.text(nachts: nachts)))
+            }
+            .accessibilityHint("Trägt ein, dass du gegessen hast.")
+        } else {
+            // Zweites Eintragen nur durch Halten, damit niemand aus Versehen doppelt zählt.
+            Text("Nochmal gegessen? Halten")
+                .font(ZSSchrift.headline)
+                .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                .frame(maxWidth: .infinity, minHeight: 56)
+                .background(
+                    GeometryReader { geo in
+                        ZStack(alignment: .leading) {
+                            Capsule().strokeBorder(ZSHypoFarbe.text2(nachts: nachts), lineWidth: 1.5)
+                            Capsule()
+                                .fill(ZSHypoFarbe.text2(nachts: nachts).opacity(0.35))
+                                .frame(width: geo.size.width * haltFortschritt)
+                        }
+                    })
+                .contentShape(Capsule())
+                .onLongPressGesture(minimumDuration: 1.2, maximumDistance: 30) {
+                    haltFortschritt = 0
+                    begleiter.gegessen()
+                } onPressingChanged: { gedrueckt in
+                    withAnimation(gedrueckt ? .linear(duration: 1.2) : .easeOut(duration: 0.2)) {
+                        haltFortschritt = gedrueckt ? 1 : 0
+                    }
+                }
+                .accessibilityAddTraits(.isButton)
+                .accessibilityLabel("Nochmal gegessen")
+                .accessibilityAction { begleiter.gegessen() }
+        }
+
+        Button("Begleiter beenden") { begleiter.beenden() }
+            .font(ZSSchrift.subhead)
+            .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+            .frame(maxWidth: .infinity, minHeight: ZSMass.tap)
+    }
+
+    private func statistik(nachts: Bool) -> some View {
+        let zwei = begleiter.statistik(tage: 14)
+        let dreissig = begleiter.statistik(tage: 30)
+        return VStack(alignment: .leading, spacing: ZSMass.space3) {
+            Text("Rückblick")
+                .font(ZSSchrift.headline)
+                .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+                .accessibilityAddTraits(.isHeader)
+            HStack(spacing: ZSMass.space3) {
+                kachel("\(zwei.anzahl)", "in 14 Tagen", nachts: nachts)
+                kachel("\(dreissig.anzahl)", "in 30 Tagen", nachts: nachts)
+                kachel("\(dreissig.nachts)", "davon nachts", nachts: nachts)
+            }
+            HStack(spacing: ZSMass.space3) {
+                kachel(dreissig.tiefster.map { ZSFormat.zahl($0, stellen: 0) } ?? "–", "tiefster Wert, mg/dl", nachts: nachts)
+                kachel(dreissig.mittlereDauer.map { "\(Int($0 / 60))" } ?? "–", "Min. im Mittel", nachts: nachts)
+                kachel("\(dreissig.plaettchen)", "Plättchen", nachts: nachts)
+            }
+        }
+    }
+
+    private func kachel(_ wert: String, _ label: String, nachts: Bool) -> some View {
+        VStack(alignment: .leading, spacing: 2) {
+            Text(wert)
+                .zsZahl(.wert)
+                .foregroundStyle(ZSHypoFarbe.text(nachts: nachts))
+            Text(label)
+                .font(ZSSchrift.footnote)
+                .foregroundStyle(ZSHypoFarbe.text2(nachts: nachts))
+                .lineLimit(2)
+        }
+        .padding(ZSMass.space3)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(RoundedRectangle(cornerRadius: ZSMass.radiusM, style: .continuous).fill(Color(white: 0.09)))
+        .accessibilityElement(children: .combine)
+    }
+}
+
+// MARK: - Therapieplan eintragen
+
+/// Werte vom Diabetes-Team. Die App schlägt hier nichts vor und rechnet nichts aus.
+struct ZSTherapieplanView: View {
+    @ObservedObject var speicher: ZSSpeicher
+    var schliessen: () -> Void
+
+    @State private var plan = ZSTherapieplan.leer
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Therapieplan", abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space6) {
+                    Text("Trag hier die Werte ein, die dein Diabetes-Team mit dir festgelegt hat. Leere Felder zeigt die App ohne Zahl an.")
+                        .font(ZSSchrift.subhead)
+                        .foregroundStyle(ZSFarbe.text2)
+                        .fixedSize(horizontal: false, vertical: true)
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Unterzucker")
+                        ZSEingabeFeld(titel: "Plättchen pro Mal") {
+                            TextField("z. B. 5", value: $plan.hypoPlaettchen, format: .number)
+                                .keyboardType(.numberPad)
+                        }
+                        ZSEingabeFeld(titel: "Gramm KH je Plättchen") {
+                            TextField("z. B. 3", value: $plan.hypoGrammJePlaettchen, format: .number)
+                                .keyboardType(.decimalPad)
+                        }
+                        ZSEingabeFeld(titel: "Wartezeit nach dem Essen (Minuten)") {
+                            TextField("ohne Wert 15", value: $plan.hypoWarteMinuten, format: .number)
+                                .keyboardType(.numberPad)
+                        }
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Essen")
+                        ZSEingabeFeld(titel: "Gramm KH je FPE") {
+                            TextField("leer, wenn nicht festgelegt", value: $plan.khJeFPE, format: .number)
+                                .keyboardType(.decimalPad)
+                        }
+                        ZSEingabeFeld(titel: "Spritz-Ess-Abstand (Minuten)") {
+                            TextField("leer, wenn nicht festgelegt", value: $plan.spritzEssAbstandMinuten, format: .number)
+                                .keyboardType(.numberPad)
+                        }
+                    }
+
+                    Button {
+                        speicher.plan = plan
+                        schliessen()
+                    } label: {
+                        Text("Plan sichern").font(ZSSchrift.headline)
+                    }
+                    .buttonStyle(ZSDruckStil(art: .primaer))
+
+                    Text("Insulinmengen, Faktoren und Grenzen stellst du weiter in Loop ein.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .environment(\.locale, Locale(identifier: "de_DE"))
+        .onAppear { plan = speicher.plan }
+    }
+}
diff --git a/Loop/Loop/Zuckerschock/ZuckerschockHypoGemeinsam.swift b/Loop/Loop/Zuckerschock/ZuckerschockHypoGemeinsam.swift
