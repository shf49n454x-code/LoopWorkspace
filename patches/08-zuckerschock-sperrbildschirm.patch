+// MARK: - Kurve
+
+@available(iOS 16.2, *)
+struct ZSGlukoseKurve: View {
+    var d: ZSGlukoseDarstellung
+    var achsen: Bool
+
+    private struct Punkt: Identifiable {
+        var id: Date { x }
+        var x: Date
+        var y: Double
+    }
+
+    private var messwerte: [Punkt] {
+        d.stand.glucoseSamples.map { Punkt(x: $0.x, y: $0.y) }
+    }
+
+    private var prognose: [Punkt] {
+        guard d.mitPrognose, let start = d.stand.predicatedStartDate else { return [] }
+        let schritt = d.stand.predicatedInterval ?? 5 * 60
+        let ende = start.addingTimeInterval(3 * 60 * 60)
+        return d.stand.predicatedGlucose.enumerated().compactMap { i, y in
+            let x = start.addingTimeInterval(schritt * Double(i))
+            return x <= ende ? Punkt(x: x, y: y) : nil
+        }
+    }
+
+    private var bereich: ClosedRange<Double> {
+        let alle = messwerte.map(\.y) + prognose.map(\.y)
+        let marken = d.stand.yAxisMarks
+        let unten = min(marken.first ?? d.unteresZiel, (alle.min() ?? d.unteresZiel), d.unteresZiel)
+        let oben = max(marken.last ?? d.oberesZiel, (alle.max() ?? d.oberesZiel), d.oberesZiel)
+        return unten...max(oben, unten + 1)
+    }
+
+    var body: some View {
+        let start = messwerte.first?.x ?? Date().addingTimeInterval(-3 * 60 * 60)
+        let ende = prognose.last?.x ?? max(messwerte.last?.x ?? Date(), Date())
+        ZStack(alignment: .topTrailing) {
+            Chart {
+                RectangleMark(
+                    xStart: .value("Start", start),
+                    xEnd: .value("Ende", ende),
+                    yStart: .value("Ziel unten", d.unteresZiel),
+                    yEnd: .value("Ziel oben", d.oberesZiel)
+                )
+                .foregroundStyle(ZSFarbe.text.opacity(0.07))
+
+                ForEach(messwerte) { p in
+                    AreaMark(x: .value("Zeit", p.x), yStart: .value("Boden", bereich.lowerBound), yEnd: .value("Zucker", p.y))
+                        .foregroundStyle(LinearGradient(colors: [d.linienFarbe.opacity(0.28), d.linienFarbe.opacity(0)], startPoint: .top, endPoint: .bottom))
+                        .interpolationMethod(.monotone)
+                }
+                ForEach(messwerte) { p in
+                    LineMark(x: .value("Zeit", p.x), y: .value("Zucker", p.y), series: .value("Reihe", "Messung"))
+                        .foregroundStyle(d.linienFarbe)
+                        .lineStyle(StrokeStyle(lineWidth: 2, lineCap: .round, lineJoin: .round))
+                        .interpolationMethod(.monotone)
+                }
+                if let letzter = messwerte.last {
+                    PointMark(x: .value("Zeit", letzter.x), y: .value("Zucker", letzter.y))
+                        .foregroundStyle(d.linienFarbe)
+                        .symbolSize(28)
+                }
+                ForEach(prognose) { p in
+                    LineMark(x: .value("Zeit", p.x), y: .value("Zucker", p.y), series: .value("Reihe", "Prognose"))
+                        .foregroundStyle(ZSFarbe.text3)
+                        .lineStyle(StrokeStyle(lineWidth: 1.5, dash: [4, 4]))
+                }
+            }
+            .chartLegend(.hidden)
+            .chartYScale(domain: bereich)
+            .chartXScale(domain: start...max(ende, start.addingTimeInterval(60)))
+            .chartYAxis {
+                AxisMarks(position: .leading, values: [d.unteresZiel, d.oberesZiel]) { _ in
+                    AxisGridLine(stroke: StrokeStyle(lineWidth: 0.5, dash: [2, 3]))
+                        .foregroundStyle(ZSFarbe.haarlinie)
+                    AxisValueLabel()
+                        .font(.caption2)
+                        .foregroundStyle(ZSFarbe.text3)
+                }
+            }
+            .chartXAxis {
+                AxisMarks(values: .stride(by: .hour)) { _ in
+                    AxisGridLine(stroke: StrokeStyle(lineWidth: 0.5, dash: [2, 3]))
+                        .foregroundStyle(ZSFarbe.haarlinie)
+                    AxisValueLabel(format: .dateTime.hour(.twoDigits(amPM: .omitted)).locale(Locale(identifier: "de_DE")))
+                        .font(.caption2)
+                        .foregroundStyle(ZSFarbe.text3)
+                }
+            }
+            .chartXAxis(achsen ? .visible : .hidden)
+            .chartYAxis(achsen ? .visible : .hidden)
+
+            if let preset = d.stand.preset, preset.endDate > Date() {
+                Text(preset.title)
+                    .font(.caption2.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text2)
+                    .padding(.horizontal, 6)
+                    .padding(.vertical, 2)
+                    .background(Capsule().fill(ZSFarbe.flaeche2))
+            }
+        }
+        .accessibilityHidden(true)
+    }
+}
