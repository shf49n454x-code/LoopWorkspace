+// MARK: - Vorschau (nur Simulator, für Screenshots)
+
+#if targetEnvironment(simulator)
+@available(iOS 16.2, *)
+enum ZSGlukoseBeispiel {
+    /// art: „normal“, „hoch“, „tief“, „alt“, „zeile“ (ohne Kurve).
+    static func darstellung(_ art: String) -> ZSGlukoseDarstellung {
+        let jetzt = Date()
+        let alt = art == "alt"
+        let messzeit = alt ? jetzt.addingTimeInterval(-23 * 60) : jetzt.addingTimeInterval(-2 * 60)
+        let basis: [Double]
+        let wert: Double
+        let trend: GlucoseTrend
+        let delta: String
+        switch art {
+        case "hoch":
+            basis = [132, 138, 146, 158, 171, 182, 190, 197, 203, 209, 214, 216]
+            wert = 216; trend = .up; delta = "+5"
+        case "tief":
+            basis = [118, 112, 104, 97, 90, 84, 79, 75, 71, 68, 65, 62]
+            wert = 62; trend = .down; delta = "−3"
+        default:
+            basis = [104, 108, 128, 156, 177, 180, 166, 152, 141, 132, 126, 124]
+            wert = 124; trend = .flat; delta = "−2"
+        }
+        // 3 Stunden, alle 5 Minuten, weich zwischen den Stützwerten.
+        let anzahl = 36
+        let proben: [GlucoseSampleAttributes] = (0..<anzahl).map { i in
+            let t = Double(i) / Double(anzahl - 1) * Double(basis.count - 1)
+            let k = min(Int(t), basis.count - 2)
+            let y = basis[k] + (basis[k + 1] - basis[k]) * (t - Double(k))
+            return GlucoseSampleAttributes(x: messzeit.addingTimeInterval(-Double(anzahl - 1 - i) * 300), y: y.rounded())
+        }
+        let prognose: [Double] = (0..<24).map { i in
+            switch art {
+            case "hoch": return 216 - Double(i) * 2.5
+            case "tief": return 62 + Double(i) * 1.5
+            default: return 124 - Double(i) * 0.4
+            }
+        }
+        let zeile: [BottomRowItem] = [
+            .generic(label: BottomRowConfiguration.iob.name(), value: "1,35", unit: "U"),
+            .generic(label: BottomRowConfiguration.cob.name(), value: "24", unit: "g"),
+            .basal(rate: 0.85, percentage: 0.1),
+            .currentBg(label: BottomRowConfiguration.currentBg.name(), value: "\(Int(wert))", trend: trend),
+        ]
+        let stand = GlucoseActivityAttributes.ContentState(
+            date: messzeit, ended: false, preset: nil, glucoseRanges: [],
+            currentGlucose: wert, eventualGlucose: prognose.last, trendType: trend, delta: delta, isMmol: false,
+            isCloseLoop: true, lastCompleted: alt ? jetzt.addingTimeInterval(-21 * 60) : jetzt.addingTimeInterval(-60),
+            bottomRow: zeile, glucoseSamples: proben, predicatedGlucose: prognose,
+            predicatedStartDate: messzeit, predicatedInterval: 300, yAxisMarks: [40, 100, 160, 220])
+        return ZSGlukoseDarstellung(stand: stand, mitKurve: art != "zeile", mitPrognose: true, veraltet: alt, jetzt: jetzt)
+    }
+}
