diff --git a/Loop/Loop/Zuckerschock/ZuckerschockGlukoseAktivitaet.swift b/Loop/Loop/Zuckerschock/ZuckerschockGlukoseAktivitaet.swift
new file mode 100644
index 0000000..b280ec9
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockGlukoseAktivitaet.swift
@@ -0,0 +1,579 @@
+//
+//  ZuckerschockGlukoseAktivitaet.swift
+//  Loop + Loop Widget Extension
+//
+//  Zuckerschock-Optik für Loops eigene Live-Aktivität (Sperrbildschirm, Dynamic Island, Watch/CarPlay).
+//  Nur Darstellung der Werte, die Loop schon schickt. Keine Berechnung, keine Taste.
+//  Zielbereich wie in der App: 70–180 mg/dl. Ab 10 Minuten zeigt der Wert sein Alter.
+//  Unter Ziel: kein Orange, nur ruhiges Rot.
+//
+
+import HealthKit
+import LoopCore
+import LoopKit
+import SwiftUI
+import Charts
+
+@available(iOS 16.2, *)
+struct ZSGlukoseDarstellung {
+    var stand: GlucoseActivityAttributes.ContentState
+    var mitKurve: Bool
+    var mitPrognose: Bool
+    /// Vom System gemeldet (staleDate) oder älter als 10 Minuten zum Zeitpunkt der Darstellung.
+    var alt: Bool
+
+    enum Zustand { case tief, ziel, hoch }
+
+    init(stand: GlucoseActivityAttributes.ContentState, mitKurve: Bool, mitPrognose: Bool, veraltet: Bool, jetzt: Date = Date()) {
+        self.stand = stand
+        self.mitKurve = mitKurve
+        self.mitPrognose = mitPrognose
+        self.alt = veraltet || jetzt.timeIntervalSince(stand.date) > 10 * 60
+    }
+
+    var unteresZiel: Double { stand.isMmol ? 3.9 : 70 }
+    var oberesZiel: Double { stand.isMmol ? 10.0 : 180 }
+
+    var zustand: Zustand? {
+        guard !stand.ended else { return nil }
+        let wert = stand.currentGlucose
+        if wert < unteresZiel { return .tief }
+        if wert > oberesZiel { return .hoch }
+        return .ziel
+    }
+
+    var istTief: Bool { zustand == .tief }
+
+    var wertText: String {
+        guard !stand.ended else { return "–" }
+        let einheit: HKUnit = stand.isMmol ? .millimolesPerLiter : .milligramsPerDeciliter
+        return NumberFormatter.glucoseFormatter(for: einheit).string(from: stand.currentGlucose) ?? "–"
+    }
+
+    var einheitText: String { stand.isMmol ? "mmol/l" : "mg/dl" }
+
+    var trendPfeil: String {
+        switch stand.trendType {
+        case .upUpUp: return "↑↑"
+        case .upUp: return "↑"
+        case .up: return "↗"
+        case .flat: return "→"
+        case .down: return "↘"
+        case .downDown: return "↓"
+        case .downDownDown: return "↓↓"
+        case .none: return ""
+        }
+    }
+
+    var aenderungText: String? {
+        let d = stand.delta.trimmingCharacters(in: .whitespaces)
+        return d.isEmpty ? nil : d
+    }
+
+    var zustandWort: String {
+        switch zustand {
+        case .tief: return "Unter Ziel"
+        case .hoch: return "Über Ziel"
+        case .ziel: return "Im Ziel"
+        case nil: return "Kein Wert"
+        }
+    }
+
+    var zustandFarbe: Color {
+        if alt { return ZSFarbe.text3 }
+        switch zustand {
+        case .tief: return ZSFarbe.tief
+        case .hoch: return ZSFarbe.hoch
+        case .ziel: return ZSFarbe.ziel
+        case nil: return ZSFarbe.text3
+        }
+    }
+
+    /// Wertfarbe: normal Text, alt gedimmt, unter Ziel rot.
+    var wertFarbe: Color {
+        if alt { return ZSFarbe.text3 }
+        return istTief ? ZSFarbe.tief : ZSFarbe.text
+    }
+
+    /// Kurvenfarbe: Marken-Orange, unter Ziel und bei altem Wert neutral.
+    var linienFarbe: Color {
+        (istTief || alt) ? ZSFarbe.text2 : ZSFarbe.orangeLinie
+    }
+
+    var loopFarbe: Color {
+        var frische: LoopCompletionFreshness = .stale
+        if let zuletzt = stand.lastCompleted {
+            frische = LoopCompletionFreshness(age: abs(min(0, zuletzt.timeIntervalSinceNow)))
+        }
+        switch frische {
+        case .fresh: return ZSFarbe.ziel
+        case .aging: return ZSFarbe.hoch
+        case .stale: return ZSFarbe.tief
+        }
+    }
+
+    struct Kennzahl: Hashable {
+        var wert: String
+        var label: String
+    }
+
+    /// Loops untere Zeile in Zuckerschock-Worten; der aktuelle Wert steht schon groß da.
+    var kennzahlen: [Kennzahl] {
+        stand.bottomRow.compactMap { eintrag in
+            switch eintrag.type {
+            case .currentBg:
+                return nil
+            case .basal:
+                let rate = eintrag.rate.formatted(.number.precision(.fractionLength(0...2)).locale(Locale(identifier: "de_DE")))
+                return Kennzahl(wert: "\(rate) IE/h", label: "Basal")
+            case .generic:
+                switch eintrag.unit {
+                case "U": return Kennzahl(wert: eintrag.value, label: "IE aktiv")
+                case "g": return Kennzahl(wert: "\(eintrag.value) g", label: "KH aktiv")
+                default: break
+                }
+                switch eintrag.label {
+                case BottomRowConfiguration.eventualBg.name(): return Kennzahl(wert: eintrag.value, label: "Prognose")
+                case BottomRowConfiguration.deltaBg.name(): return Kennzahl(wert: eintrag.value, label: "Änderung")
+                case BottomRowConfiguration.updatedAt.name(): return Kennzahl(wert: eintrag.value, label: "Stand")
+                default: return Kennzahl(wert: eintrag.value + eintrag.unit, label: eintrag.label)
+                }
+            }
+        }
+    }
+
+    static func uhrzeit(_ datum: Date) -> String {
+        datum.formatted(.dateTime.hour(.twoDigits(amPM: .omitted)).minute(.twoDigits).locale(Locale(identifier: "de_DE")))
+    }
+}
+
+// MARK: - Sperrbildschirm
+
+@available(iOS 16.2, *)
+struct ZSGlukoseSperrAnsicht: View {
+    var d: ZSGlukoseDarstellung
+
+    var body: some View {
+        ZStack {
+            VStack(alignment: .leading, spacing: 10) {
+                if d.mitKurve {
+                    HStack(alignment: .top, spacing: 12) {
+                        ZSGlukoseWertBlock(d: d, gross: true)
+                            .frame(width: 112, alignment: .leading)
+                        ZSGlukoseKurve(d: d, achsen: true)
+                            .frame(height: 86)
+                    }
+                    if !d.kennzahlen.isEmpty {
+                        Rectangle().fill(ZSFarbe.haarlinie).frame(height: 1)
+                        kennzahlZeile
+                    }
+                } else {
+                    HStack(alignment: .center, spacing: 12) {
+                        ZSGlukoseWertBlock(d: d, gross: true)
+                        Spacer(minLength: 4)
+                        kennzahlZeile
+                    }
+                }
+            }
+            .opacity(d.stand.ended ? 0.25 : 1)
+
+            if d.stand.ended {
+                Text("App öffnen, um die Anzeige zu aktualisieren.")
+                    .font(.footnote.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                    .multilineTextAlignment(.center)
+            }
+        }
+        .padding(14)
+        .privacySensitive()
+    }
+
+    private var kennzahlZeile: some View {
+        HStack(alignment: .firstTextBaseline, spacing: 0) {
