+
+    var body: some View {
+        Button {
+            aktion?()
+        } label: {
+            HStack(alignment: .top, spacing: ZSMass.space3) {
+                Image(systemName: symbol)
+                    .font(.body.weight(.semibold))
+                    .foregroundStyle(farbe)
+                    .frame(width: 24)
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(hinweis.titel)
+                        .font(ZSSchrift.subhead.weight(.semibold))
+                        .foregroundStyle(ZSFarbe.text)
+                    Text(hinweis.text)
+                        .font(ZSSchrift.subhead)
+                        .foregroundStyle(ZSFarbe.text2)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                Spacer(minLength: 0)
+                if aktion != nil {
+                    Image(systemName: "chevron.right")
+                        .font(.footnote.weight(.semibold))
+                        .foregroundStyle(ZSFarbe.text3)
+                }
+            }
+            .padding(.horizontal, ZSMass.space4)
+            .padding(.vertical, ZSMass.space3)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(RoundedRectangle(cornerRadius: ZSMass.radiusM, style: .continuous).fill(ZSFarbe.flaeche1))
+        }
+        .buttonStyle(.plain)
+        .disabled(aktion == nil)
+        .accessibilityElement(children: .combine)
+    }
+}
+
+// MARK: - Modi
+
+struct ZSModiView: View {
+    @ObservedObject var hinweise: ZSHinweise
+    @ObservedObject var keton: ZSKeton
+    var voreinstellungen: () -> Void
+    var schliessen: () -> Void
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Modi", abbrechen: schliessen)
