+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    Text("Modi geben dir passende Hinweise. Sie ändern nichts an Loops Dosierung. Ziele und Voreinstellungen stellst du in Loop ein.")
+                        .font(ZSSchrift.subhead)
+                        .foregroundStyle(ZSFarbe.text2)
+                        .fixedSize(horizontal: false, vertical: true)
+
+                    modus(titel: "Sport", text: "Für 3 Stunden. Hinweis auf Loops Sport-Voreinstellung.", symbol: "figure.run",
+                          an: Binding(get: { hinweise.modi.sportAktiv() }, set: { hinweise.modi.sportBis = $0 ? Date().addingTimeInterval(.hours(3)) : nil }))
+                    modus(titel: "Alkohol", text: "Bis morgen 12 Uhr. Erinnerung morgens um 7.", symbol: "wineglass",
+                          an: Binding(get: { hinweise.modi.alkoholAktiv() }, set: { neu in
+                              var mittag = Calendar.current.dateComponents([.year, .month, .day], from: Date().addingTimeInterval(.hours(12)))
+                              mittag.hour = 12
+                              hinweise.modi.alkoholBis = neu ? Calendar.current.date(from: mittag) : nil
+                          }))
+                    modus(titel: "Krank", text: "Erinnert alle 3 bis 4 Stunden an den Keton-Check.", symbol: "thermometer.medium",
+                          an: $keton.krankModus)
+
+                    Button(action: voreinstellungen) {
+                        Label("Loops Voreinstellungen öffnen", systemImage: "slider.horizontal.3")
+                            .font(ZSSchrift.headline)
+                    }
+                    .buttonStyle(ZSRandStil())
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+    }
+
+    private func modus(titel: String, text: String, symbol: String, an: Binding<Bool>) -> some View {
+        Toggle(isOn: an) {
+            HStack(spacing: ZSMass.space3) {
+                Image(systemName: symbol)
+                    .foregroundStyle(ZSFarbe.text)
+                    .frame(width: 29, height: 29)
+                    .background(RoundedRectangle(cornerRadius: ZSMass.radiusXS, style: .continuous).fill(ZSFarbe.flaeche2))
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(titel)
+                        .font(ZSSchrift.body)
