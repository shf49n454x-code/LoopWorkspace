@@ -0,0 +1,205 @@
+//
+//  ZuckerschockStellen.swift
+//  Loop
+//
+//  Zuckerschock: Stellen-Karte. Wo saßen die letzten Pods? Vorschlag: die Stelle, die am längsten frei ist.
+//
+
+import Foundation
+import SwiftUI
+
+enum ZSStelle: String, Codable, CaseIterable, Identifiable {
+    case bauchLinks, bauchRechts, oberarmLinks, oberarmRechts, oberschenkelLinks, oberschenkelRechts, rueckenLinks, rueckenRechts
+
+    var id: String { rawValue }
+
+    var name: String {
+        switch self {
+        case .bauchLinks: return "Bauch links"
+        case .bauchRechts: return "Bauch rechts"
+        case .oberarmLinks: return "Oberarm links"
+        case .oberarmRechts: return "Oberarm rechts"
+        case .oberschenkelLinks: return "Oberschenkel links"
+        case .oberschenkelRechts: return "Oberschenkel rechts"
+        case .rueckenLinks: return "Unterer Rücken links"
+        case .rueckenRechts: return "Unterer Rücken rechts"
+        }
+    }
+
+    /// Position auf der Körperskizze (0…1), von vorn gesehen; Rücken in der rechten Skizze.
+    var position: (seite: Int, x: CGFloat, y: CGFloat) {
+        switch self {
+        case .oberarmRechts: return (0, 0.2, 0.32)
+        case .oberarmLinks: return (0, 0.8, 0.32)
+        case .bauchRechts: return (0, 0.4, 0.47)
+        case .bauchLinks: return (0, 0.6, 0.47)
+        case .oberschenkelRechts: return (0, 0.4, 0.7)
+        case .oberschenkelLinks: return (0, 0.6, 0.7)
+        case .rueckenLinks: return (1, 0.4, 0.5)
+        case .rueckenRechts: return (1, 0.6, 0.5)
+        }
+    }
+}
+
+struct ZSStellenEintrag: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var stelle: ZSStelle
+    var datum: Date
+}
+
+final class ZSStellen: ObservableObject {
+    static let shared = ZSStellen()
+
+    @Published private(set) var eintraege: [ZSStellenEintrag] = []
+    private let datei: URL
+
+    init(ordner: URL? = nil) {
+        let basis = ordner ?? (FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? FileManager.default.temporaryDirectory)
+        let verzeichnis = basis.appendingPathComponent("Zuckerschock", isDirectory: true)
+        try? FileManager.default.createDirectory(at: verzeichnis, withIntermediateDirectories: true)
+        datei = verzeichnis.appendingPathComponent("stellen.json")
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        eintraege = (try? Data(contentsOf: datei)).flatMap { try? decoder.decode([ZSStellenEintrag].self, from: $0) } ?? []
+    }
+
+    func eintragen(_ stelle: ZSStelle, am datum: Date = Date()) {
+        eintraege.insert(ZSStellenEintrag(stelle: stelle, datum: datum), at: 0)
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        try? encoder.encode(eintraege).write(to: datei, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    }
+
+    func zuletzt(_ stelle: ZSStelle) -> Date? {
+        eintraege.first { $0.stelle == stelle }?.datum
+    }
+
+    /// Die Stelle, die am längsten frei ist (nie benutzt zuerst).
+    var vorschlag: ZSStelle {
+        ZSStelle.allCases.min { (zuletzt($0) ?? .distantPast) < (zuletzt($1) ?? .distantPast) } ?? .bauchLinks
+    }
+
+    var aktuell: ZSStellenEintrag? { eintraege.first }
+}
+
+#if targetEnvironment(simulator)
+extension ZSStellen {
+    static func vorschau() -> ZSStellen {
+        let stellen = ZSStellen(ordner: FileManager.default.temporaryDirectory.appendingPathComponent("ZSVorschau-\(UUID().uuidString)"))
+        let jetzt = Date()
+        stellen.eintraege = [
+            ZSStellenEintrag(stelle: .bauchLinks, datum: jetzt.addingTimeInterval(-.days(2))),
+            ZSStellenEintrag(stelle: .oberarmRechts, datum: jetzt.addingTimeInterval(-.days(5))),
+            ZSStellenEintrag(stelle: .bauchRechts, datum: jetzt.addingTimeInterval(-.days(8))),
+            ZSStellenEintrag(stelle: .oberschenkelLinks, datum: jetzt.addingTimeInterval(-.days(11)))
+        ]
+        return stellen
+    }
+}
+#endif
+
+struct ZSStellenView: View {
+    @ObservedObject var stellen: ZSStellen
+    var nachEintrag: () -> Void
+    var schliessen: () -> Void
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Stellen-Karte", abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space6) {
+                    VStack(alignment: .leading, spacing: ZSMass.space1) {
+                        Text("Vorschlag für den nächsten Pod")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                        Text(stellen.vorschlag.name)
+                            .font(ZSSchrift.title2)
+                            .foregroundStyle(ZSFarbe.text)
+                        Text(stellen.zuletzt(stellen.vorschlag).map { "Zuletzt \(ZSFormat.alter(von: $0, jetzt: Date()))" } ?? "Noch nie benutzt")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                    }
+                    .zsKarte()
+
+                    HStack(spacing: ZSMass.space4) {
+                        skizze(seite: 0, titel: "Vorn")
+                        skizze(seite: 1, titel: "Hinten")
+                    }
+                    .frame(height: 300)
+
+                    VStack(alignment: .leading, spacing: 0) {
+                        ZSAbschnittTitel(text: "Wo sitzt der neue Pod?")
+                            .padding(.bottom, ZSMass.space2)
+                        ForEach(ZSStelle.allCases) { stelle in
+                            Button {
+                                stellen.eintragen(stelle)
+                                nachEintrag()
+                            } label: {
+                                HStack {
+                                    Text(stelle.name)
+                                        .font(ZSSchrift.body)
+                                        .foregroundStyle(ZSFarbe.text)
+                                    Spacer()
+                                    Text(stellen.zuletzt(stelle).map { ZSFormat.alter(von: $0, jetzt: Date()) } ?? "frei")
+                                        .font(ZSSchrift.subhead)
+                                        .foregroundStyle(ZSFarbe.text2)
+                                    if stellen.aktuell?.stelle == stelle {
+                                        Image(systemName: "checkmark")
+                                            .foregroundStyle(ZSFarbe.text)
+                                    }
+                                }
+                                .frame(minHeight: ZSMass.tap)
+                                .contentShape(Rectangle())
+                            }
+                            .buttonStyle(ZSAufhellStil())
+                            Divider().overlay(ZSFarbe.haarlinie)
+                        }
+                    }
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+    }
+
+    /// Schlichte Körperskizze mit Punkten: frisch benutzt dunkel, lange frei hell, Vorschlag mit Ring.
+    private func skizze(seite: Int, titel: String) -> some View {
+        VStack(spacing: ZSMass.space1) {
+            GeometryReader { geo in
+                let w = geo.size.width, h = geo.size.height
+                ZStack {
+                    Circle().fill(ZSFarbe.flaeche2).frame(width: w * 0.2, height: w * 0.2).position(x: w * 0.5, y: h * 0.09)
+                    RoundedRectangle(cornerRadius: w * 0.1).fill(ZSFarbe.flaeche2).frame(width: w * 0.4, height: h * 0.38).position(x: w * 0.5, y: h * 0.38)
+                    RoundedRectangle(cornerRadius: w * 0.05).fill(ZSFarbe.flaeche2).frame(width: w * 0.1, height: h * 0.32).position(x: w * 0.2, y: h * 0.36)
+                    RoundedRectangle(cornerRadius: w * 0.05).fill(ZSFarbe.flaeche2).frame(width: w * 0.1, height: h * 0.32).position(x: w * 0.8, y: h * 0.36)
+                    RoundedRectangle(cornerRadius: w * 0.06).fill(ZSFarbe.flaeche2).frame(width: w * 0.14, height: h * 0.42).position(x: w * 0.4, y: h * 0.77)
+                    RoundedRectangle(cornerRadius: w * 0.06).fill(ZSFarbe.flaeche2).frame(width: w * 0.14, height: h * 0.42).position(x: w * 0.6, y: h * 0.77)
+                    ForEach(ZSStelle.allCases.filter { $0.position.seite == seite }) { stelle in
+                        punkt(stelle)
+                            .position(x: w * stelle.position.x, y: h * stelle.position.y)
+                    }
+                }
+            }
+            Text(titel)
+                .font(ZSSchrift.caption)
+                .foregroundStyle(ZSFarbe.text3)
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Körperskizze \(titel)")
+    }
+
+    private func punkt(_ stelle: ZSStelle) -> some View {
+        let tage = stellen.zuletzt(stelle).map { Date().timeIntervalSince($0) / 86_400 }
+        let frisch = (tage ?? 99) < 9
+        return ZStack {
+            Circle()
+                .fill(frisch ? ZSFarbe.text3 : ZSFarbe.text)
+                .frame(width: 14, height: 14)
+            if stelle == stellen.vorschlag {
+                Circle()
+                    .strokeBorder(ZSFarbe.orange, lineWidth: 2.5)
+                    .frame(width: 26, height: 26)
+            }
+        }
+    }
