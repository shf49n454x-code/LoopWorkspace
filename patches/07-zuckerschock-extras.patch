+++ b/Loop/Loop/Zuckerschock/ZuckerschockAngehoerige.swift
@@ -0,0 +1,288 @@
+//
+//  ZuckerschockAngehoerige.swift
+//  Loop
+//
+//  Zuckerschock: Angehörigen-Ansicht (groß, klar, für Helfer) und Home-Assistant-Licht-Alarm:
+//  Bei Unterzucker ruft die App einen Webhook auf deinem Home Assistant auf.
+//  Ohne Marke, ohne Humor. Keine Dosis.
+//
+
+import Foundation
+import Security
+import SwiftUI
+
+// MARK: - Home Assistant
+
+enum ZSHomeAssistant {
+    private static let urlSchluessel = "Zuckerschock.HA.url"
+    private static let aktivSchluessel = "Zuckerschock.HA.aktiv"
+    private static let dienst = "Zuckerschock.HomeAssistant"
+    private static let konto = "webhook-id"
+
+    static var basisURL: String {
+        get { UserDefaults.standard.string(forKey: urlSchluessel) ?? "" }
+        set { UserDefaults.standard.set(newValue.trimmingCharacters(in: .whitespacesAndNewlines), forKey: urlSchluessel) }
+    }
+
+    static var aktiv: Bool {
+        get { UserDefaults.standard.bool(forKey: aktivSchluessel) }
+        set { UserDefaults.standard.set(newValue, forKey: aktivSchluessel) }
+    }
+
+    /// Webhook-ID liegt im Schlüsselbund, denn wer sie kennt, kann den Alarm auslösen.
+    static var webhookID: String? {
+        get {
+            let abfrage: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: dienst,
+                                          kSecAttrAccount as String: konto, kSecReturnData as String: true, kSecMatchLimit as String: kSecMatchLimitOne]
+            var ergebnis: AnyObject?
+            guard SecItemCopyMatching(abfrage as CFDictionary, &ergebnis) == errSecSuccess, let daten = ergebnis as? Data else { return nil }
+            return String(data: daten, encoding: .utf8)
+        }
+        set {
+            let basis: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: dienst, kSecAttrAccount as String: konto]
+            SecItemDelete(basis as CFDictionary)
+            guard let neu = newValue?.trimmingCharacters(in: .whitespacesAndNewlines), !neu.isEmpty else { return }
+            var eintrag = basis
+            eintrag[kSecValueData as String] = Data(neu.utf8)
+            eintrag[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+            SecItemAdd(eintrag as CFDictionary, nil)
+        }
+    }
+
+    enum Ereignis: String {
+        case unterzucker, wiederImZiel = "wieder_im_ziel", test
+    }
+
+    /// Ruft `<url>/api/webhook/<id>` mit Ereignis, Wert und Zeit auf.
+    /// Nur über https: sonst ginge die Webhook-ID unverschlüsselt durchs Netz und jeder im selben WLAN könnte Alarme auslösen.
+    @discardableResult
+    static func melden(_ ereignis: Ereignis, wert: String?, trend: String?, erzwingen: Bool = false) async -> Bool {
+        guard aktiv || erzwingen, let id = webhookID,
+              let basis = URL(string: basisURL), basis.scheme == "https", basis.host != nil else { return false }
+        var anfrage = URLRequest(url: basis.appendingPathComponent("api/webhook").appendingPathComponent(id), timeoutInterval: 15)
+        anfrage.httpMethod = "POST"
+        anfrage.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        let koerper: [String: Any] = [
+            "ereignis": ereignis.rawValue,
+            "wert": wert ?? "",
+            "trend": trend ?? "",
+            "zeit": ISO8601DateFormatter().string(from: Date())
+        ]
+        anfrage.httpBody = try? JSONSerialization.data(withJSONObject: koerper)
+        guard let ergebnis = try? await URLSession.shared.data(for: anfrage) else { return false }
+        return (200..<300).contains((ergebnis.1 as? HTTPURLResponse)?.statusCode ?? 0)
+    }
+}
+
+// MARK: - Angehörigen-Ansicht
+
+struct ZSAngehoerigeView: View {
+    @ObservedObject var modell: ZSHeuteModell
+    @ObservedObject var begleiter: ZSHypoBegleiter
+    var schliessen: () -> Void
+
+    @State private var zeigeEinstellungen = false
+
+    var body: some View {
+        let stand = modell.stand
+        let jetzt = modell.jetzt
+        let aktuell = stand?.aktuell
+        let einheit = stand?.einheit ?? .milligramsPerDeciliter
+        let alt = ZSFormat.istAlt(aktuell?.datum, jetzt: jetzt)
+        let zustand = aktuell.map { ZSGlukoseZustand(mgdl: $0.mgdl) }
+
+        ZStack {
+            Color.black.ignoresSafeArea()
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space6) {
+                    HStack {
+                        Text("Für Angehörige")
+                            .font(ZSSchrift.title3)
+                            .foregroundStyle(Color.white)
+                            .accessibilityAddTraits(.isHeader)
+                        Spacer()
+                        Button("Schließen", action: schliessen)
+                            .foregroundStyle(Color.white.opacity(0.7))
+                            .frame(minHeight: ZSMass.tap)
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space2) {
+                        HStack(alignment: .firstTextBaseline, spacing: ZSMass.space2) {
+                            Text(aktuell.map { ZSFormat.glukose($0.mgdl, einheit) } ?? "–")
+                                .font(.system(size: 96, weight: .bold, design: .rounded))
+                                .monospacedDigit()
+                                .minimumScaleFactor(0.5)
+                                .foregroundStyle(alt ? Color.white.opacity(0.6) : Color.white)
+                            Text(alt ? "" : (stand?.trend?.pfeil ?? ""))
+                                .font(.system(size: 48, weight: .bold))
+                                .foregroundStyle(Color.white)
+                        }
+                        Text(ZSFormat.einheit(einheit))
+                            .font(ZSSchrift.title3)
+                            .foregroundStyle(Color.white.opacity(0.7))
+                        Text(zustandText(zustand, alt: alt, aktuell: aktuell, jetzt: jetzt))
+                            .font(ZSSchrift.title2)
+                            .foregroundStyle(zustandFarbe(zustand, alt: alt))
+                    }
+                    .accessibilityElement(children: .combine)
+
+                    if let hypo = begleiter.zustand {
+                        VStack(alignment: .leading, spacing: ZSMass.space2) {
+                            Text("Unterzucker-Begleiter läuft")
+                                .font(ZSSchrift.headline)
+                                .foregroundStyle(Color.white)
+                            Text(hypo.gegessenUm.map { "Gegessen um \(ZSFormat.uhrzeit($0)), \(hypo.gegessenAnzahl)×." } ?? "Noch nichts gegessen. Jetzt \(hypo.mengeText) geben.")
+                                .font(ZSSchrift.body)
+                                .foregroundStyle(Color.white)
+                        }
+                        .padding(ZSMass.space4)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .background(RoundedRectangle(cornerRadius: ZSMass.radiusKarte, style: .continuous).fill(Color(red: 0.23, green: 0.07, blue: 0.08)))
+                        .overlay(RoundedRectangle(cornerRadius: ZSMass.radiusKarte, style: .continuous).strokeBorder(Color(red: 1, green: 0.42, blue: 0.42), lineWidth: 1.5))
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space2) {
+                        Text("Im Notfall")
+                            .font(ZSSchrift.headline)
+                            .foregroundStyle(Color.white)
+                        Text("Wach und ansprechbar: schnelle Kohlenhydrate geben, nach 15 Minuten erneut messen.")
+                        Text("Nicht ansprechbar: nichts in den Mund geben. Glukagon laut Notfallpass, dann 112 anrufen.")
+                        Text("Insulin pausieren: in Loop unter Einstellungen, Pumpe, Insulin pausieren.")
+                    }
+                    .font(ZSSchrift.body)
+                    .foregroundStyle(Color.white.opacity(0.85))
+                    .fixedSize(horizontal: false, vertical: true)
+
+                    if let notruf = URL(string: "tel:112") {
+                        Link(destination: notruf) {
+                            Text("112 anrufen")
+                                .font(ZSSchrift.headline)
+                                .foregroundStyle(Color.white)
+                                .frame(maxWidth: .infinity, minHeight: 56)
+                                .background(Capsule().strokeBorder(Color.white, lineWidth: 1.5))
+                        }
+                    }
+
+                    Button("Licht-Alarm über Home Assistant") { zeigeEinstellungen = true }
+                        .font(ZSSchrift.subhead)
+                        .foregroundStyle(Color.white.opacity(0.7))
+                        .frame(maxWidth: .infinity, minHeight: ZSMass.tap)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .preferredColorScheme(.dark)
+        .sheet(isPresented: $zeigeEinstellungen) {
+            ZSHomeAssistantView { zeigeEinstellungen = false }
+        }
+    }
+
+    private func zustandText(_ zustand: ZSGlukoseZustand?, alt: Bool, aktuell: ZSMesspunkt?, jetzt: Date) -> String {
+        if let aktuell, alt { return "Wert \(ZSFormat.alter(von: aktuell.datum, jetzt: jetzt))" }
+        switch zustand {
+        case .tief: return "Unterzucker"
+        case .hoch: return "Über Ziel"
+        case .ziel: return "Im Ziel"
+        case nil: return "Kein Wert"
+        }
+    }
+
+    private func zustandFarbe(_ zustand: ZSGlukoseZustand?, alt: Bool) -> Color {
+        if alt { return Color.white.opacity(0.6) }
+        switch zustand {
+        case .tief: return Color(red: 1, green: 0.42, blue: 0.42)
+        case .hoch: return Color(red: 1, green: 0.77, blue: 0.3)
+        case .ziel: return Color(red: 0.36, green: 0.83, blue: 0.54)
+        case nil: return Color.white.opacity(0.6)
+        }
+    }
+}
+
+struct ZSHomeAssistantView: View {
+    var schliessen: () -> Void
+
+    @State private var url = ZSHomeAssistant.basisURL
+    @State private var id = ""
+    @State private var aktiv = ZSHomeAssistant.aktiv
+    @State private var hatID = ZSHomeAssistant.webhookID != nil
+    @State private var testErgebnis: String?
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Home Assistant", abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    Text("Bei Unterzucker ruft die App einen Webhook in deinem Home Assistant auf, zum Beispiel um ein Licht rot blinken zu lassen. Ereignisse: unterzucker, wieder_im_ziel.")
+                        .font(ZSSchrift.subhead)
+                        .foregroundStyle(ZSFarbe.text2)
+                        .fixedSize(horizontal: false, vertical: true)
+                    ZSEingabeFeld(titel: "Adresse deines Home Assistant") {
+                        TextField("https://homeassistant.local:8123", text: $url)
+                            .keyboardType(.URL)
+                            .textInputAutocapitalization(.never)
+                            .autocorrectionDisabled()
+                    }
+                    if hatID {
+                        HStack {
+                            Label("Webhook-ID hinterlegt", systemImage: "checkmark")
+                                .foregroundStyle(ZSFarbe.text)
+                            Spacer()
+                            Button("Entfernen") {
+                                ZSHomeAssistant.webhookID = nil
+                                hatID = false
+                            }
+                            .foregroundStyle(ZSFarbe.orangeText)
+                        }
+                        .font(ZSSchrift.body)
+                    } else {
+                        ZSEingabeFeld(titel: "Webhook-ID") {
+                            SecureField("z. B. zuckerschock_alarm", text: $id)
+                                .textInputAutocapitalization(.never)
+                                .autocorrectionDisabled()
+                        }
+                    }
+                    Toggle("Licht-Alarm aktiv", isOn: $aktiv)
+                        .font(ZSSchrift.body)
+                        .foregroundStyle(ZSFarbe.text)
+                    HStack(spacing: ZSMass.space3) {
+                        Button("Sichern") { sichern() }
+                            .buttonStyle(ZSRandStil())
+                        Button("Testalarm senden") {
+                            guard sichern() else { return }
+                            Task {
+                                let ok = await ZSHomeAssistant.melden(.test, wert: nil, trend: nil, erzwingen: true)
+                                await MainActor.run { testErgebnis = ok ? "Home Assistant hat den Test angenommen." : "Keine Antwort. Adresse und ID prüfen." }
+                            }
+                        }
+                        .buttonStyle(ZSRandStil())
+                    }
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    if let testErgebnis {
+                        Text(testErgebnis)
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text)
+                    }
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+    }
+
+    @discardableResult
+    private func sichern() -> Bool {
+        let adresse = url.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let geprueft = URL(string: adresse), geprueft.scheme == "https", geprueft.host != nil else {
+            testErgebnis = "Nur https-Adressen. Ohne Verschlüsselung könnte jemand im selben WLAN die Webhook-ID mitlesen."
+            return false
+        }
+        ZSHomeAssistant.basisURL = adresse
+        ZSHomeAssistant.aktiv = aktiv
+        if !id.isEmpty {
+            ZSHomeAssistant.webhookID = id
+            id = ""
+            hatID = true
+        }
+        return true
+    }
+}
diff --git a/Loop/Loop/Zuckerschock/ZuckerschockBericht.swift b/Loop/Loop/Zuckerschock/ZuckerschockBericht.swift
new file mode 100644
index 0000000..83a9e8a
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockBericht.swift
@@ -0,0 +1,312 @@
+//
+//  ZuckerschockBericht.swift
+//  Loop
+//
+//  Zuckerschock: Arztbericht als PDF. Zeit im Zielbereich, Mittelwert, GMI, Variabilität,
+//  Tagesprofil, Unterzucker, Keton und Mahlzeiten für 14, 30 oder 90 Tage. Nur lesend aus Loop.
+//
+
+import Foundation
+import HealthKit
+import LoopCore
+import LoopKit
+import SwiftUI
+import UIKit
+
+// MARK: - Auswertung
+
+struct ZSBerichtDaten {
+    var von: Date
+    var bis: Date
+    var werte: [ZSMesspunkt]
+    var tagesInsulin: Double?
+    var khJeTag: Double?
+    var hypos: [ZSHypoEpisode]
+    var ketone: [ZSKetonWert]
+    var mahlzeiten: [ZSMahlzeit]
+
+    var mittel: Double? { werte.isEmpty ? nil : werte.map(\.mgdl).reduce(0, +) / Double(werte.count) }
+
+    /// Glukose-Management-Indikator: 3,31 + 0,02392 × Mittelwert (mg/dl).
+    var gmi: Double? { mittel.map { 3.31 + 0.02392 * $0 } }
+
+    /// Variationskoeffizient in Prozent.
+    var cv: Double? {
+        guard let mittel, werte.count > 1 else { return nil }
+        let varianz = werte.map { pow($0.mgdl - mittel, 2) }.reduce(0, +) / Double(werte.count - 1)
+        return sqrt(varianz) / mittel * 100
+    }
+
+    /// Anteile: <54, 54–69, 70–180, 181–250, >250 (in Prozent).
+    var bereiche: [Double] {
+        guard !werte.isEmpty else { return [0, 0, 0, 0, 0] }
+        let n = Double(werte.count)
+        func anteil(_ bedingung: (Double) -> Bool) -> Double { Double(werte.filter { bedingung($0.mgdl) }.count) / n * 100 }
+        return [anteil { $0 < 54 }, anteil { $0 >= 54 && $0 < 70 }, anteil { $0 >= 70 && $0 <= 180 }, anteil { $0 > 180 && $0 <= 250 }, anteil { $0 > 250 }]
+    }
+
+    /// Sensor-Abdeckung: Anteil der erwarteten 5-Minuten-Werte.
+    var abdeckung: Double {
+        let erwartet = bis.timeIntervalSince(von) / 300
+        return erwartet > 0 ? min(100, Double(werte.count) / erwartet * 100) : 0
+    }
+
+    /// Tagesprofil: je Stunde Median sowie 25. und 75. Perzentil.
+    var tagesprofil: [(stunde: Int, p25: Double, median: Double, p75: Double)] {
+        (0..<24).compactMap { stunde in
+            let werteStunde = werte.filter { Calendar.current.component(.hour, from: $0.datum) == stunde }.map(\.mgdl).sorted()
+            guard werteStunde.count >= 3 else { return nil }
+            func perzentil(_ p: Double) -> Double { werteStunde[min(werteStunde.count - 1, Int(Double(werteStunde.count - 1) * p))] }
+            return (stunde: stunde, p25: perzentil(0.25), median: perzentil(0.5), p75: perzentil(0.75))
+        }
+    }
+}
+
+enum ZSBericht {
+    static func laden(tage: Int, deviceManager: DeviceDataManager, begleiter: ZSHypoBegleiter, keton: ZSKeton, speicher: ZSSpeicher,
+                      fertig: @escaping (ZSBerichtDaten) -> Void) {
+        let bis = Date()
+        let von = bis.addingTimeInterval(-.days(Double(tage)))
+        let gruppe = DispatchGroup()
+        var werte: [ZSMesspunkt] = []
+        var insulin: Double?
+        var kh: Double?
+
+        // Glukose aus Apple Health: Loop hält lokal nur 7 Tage, Health hat den ganzen Zeitraum.
+        gruppe.enter()
+        let abfrage = HKSampleQuery(
+            sampleType: HKQuantityType(.bloodGlucose),
+            predicate: HKQuery.predicateForSamples(withStart: von, end: bis),
+            limit: HKObjectQueryNoLimit,
+            sortDescriptors: [NSSortDescriptor(key: HKSampleSortIdentifierStartDate, ascending: true)]) { _, proben, _ in
+            werte = (proben as? [HKQuantitySample] ?? []).map {
+                ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: .milligramsPerDeciliter))
+            }
+            gruppe.leave()
+        }
+        deviceManager.healthStore.execute(abfrage)
+
+        // Insulin und KH je Tag aus Loops lokalem Speicher (höchstens 7 Tage).
+        let lokaleTage = Double(min(tage, 7))
+        let lokalVon = bis.addingTimeInterval(-.days(lokaleTage))
+        gruppe.enter()
+        deviceManager.doseStore.getTotalUnitsDelivered(since: lokalVon) { ergebnis in
+            if case .success(let gesamt) = ergebnis { insulin = gesamt.value / lokaleTage }
+            gruppe.leave()
+        }
+        gruppe.enter()
+        deviceManager.carbStore.getCarbEntries(start: lokalVon, end: bis) { ergebnis in
+            if case .success(let eintraege) = ergebnis {
+                kh = eintraege.reduce(0) { $0 + $1.quantity.doubleValue(for: .gram()) } / lokaleTage
+            }
+            gruppe.leave()
+        }
+        gruppe.notify(queue: .main) {
+            fertig(ZSBerichtDaten(von: von, bis: bis, werte: werte, tagesInsulin: insulin, khJeTag: kh,
+                                  hypos: begleiter.verlauf.filter { $0.start >= von },
+                                  ketone: keton.werte.filter { $0.datum >= von },
+                                  mahlzeiten: speicher.mahlzeiten.filter { $0.datum >= von }))
+        }
+    }
+
+    // MARK: PDF
+
+    /// A4, 595 × 842 pt. Schlicht in Schwarz auf Weiß, gut druckbar.
+    static func pdf(_ d: ZSBerichtDaten, name: String) -> Data {
+        let seite = CGRect(x: 0, y: 0, width: 595, height: 842)
+        let renderer = UIGraphicsPDFRenderer(bounds: seite)
+        let datum = DateFormatter()
+        datum.locale = Locale(identifier: "de_DE")
+        datum.dateFormat = "d. MMMM yyyy"
+
+        return renderer.pdfData { kontext in
+            kontext.beginPage()
+            var y: CGFloat = 48
+            let rand: CGFloat = 48
+            let breite = seite.width - 2 * rand
+
+            func text(_ s: String, _ schrift: UIFont, farbe: UIColor = .black, x: CGFloat = rand, w: CGFloat? = nil) -> CGFloat {
+                let attribute: [NSAttributedString.Key: Any] = [.font: schrift, .foregroundColor: farbe]
+                let box = (s as NSString).boundingRect(with: CGSize(width: w ?? breite, height: 1000), options: [.usesLineFragmentOrigin], attributes: attribute, context: nil)
+                (s as NSString).draw(with: CGRect(x: x, y: y, width: w ?? breite, height: box.height), options: [.usesLineFragmentOrigin], attributes: attribute, context: nil)
+                return box.height
+            }
+
+            y += text("Bericht für die Diabetes-Praxis", .systemFont(ofSize: 22, weight: .bold))
+            y += 4
+            y += text("\(name.isEmpty ? "" : name + " · ")\(datum.string(from: d.von)) bis \(datum.string(from: d.bis)) · Loop mit Zuckerschock", .systemFont(ofSize: 11), farbe: .darkGray)
+            y += 20
+
+            // Kennzahlen
+            let kennzahlen: [(String, String)] = [
+                ("Zeit im Ziel 70–180", d.werte.isEmpty ? "–" : "\(ZSFormat.zahl(d.bereiche[2], stellen: 0)) %"),
+                ("Mittelwert", d.mittel.map { "\(ZSFormat.zahl($0, stellen: 0)) mg/dl" } ?? "–"),
+                ("GMI", d.gmi.map { "\(ZSFormat.zahl($0, stellen: 1)) %" } ?? "–"),
+                ("Variabilität (CV)", d.cv.map { "\(ZSFormat.zahl($0, stellen: 0)) %" } ?? "–"),
+                ("Sensor-Abdeckung", "\(ZSFormat.zahl(d.abdeckung, stellen: 0)) %"),
+                ("Insulin pro Tag (7 Tage)", d.tagesInsulin.map { "\(ZSFormat.zahl($0, stellen: 1)) IE" } ?? "–"),
+                ("KH pro Tag (7 Tage)", d.khJeTag.map { "\(ZSFormat.zahl($0, stellen: 0)) g" } ?? "–")
+            ]
+            let spalte = breite / 4
+            for (index, eintrag) in kennzahlen.enumerated() {
+                let x = rand + CGFloat(index % 4) * spalte
+                let zeileY = y + CGFloat(index / 4) * 46
+                let gemerkt = y
+                y = zeileY
+                _ = text(eintrag.1, .monospacedDigitSystemFont(ofSize: 17, weight: .semibold), x: x, w: spalte - 8)
+                y = zeileY + 22
+                _ = text(eintrag.0, .systemFont(ofSize: 9), farbe: .darkGray, x: x, w: spalte - 8)
+                y = gemerkt
+            }
+            y += 100
+
+            // Bereiche als Balken
+            y += text("Verteilung", .systemFont(ofSize: 13, weight: .semibold))
+            y += 6
+            let farben: [UIColor] = [UIColor(red: 0.6, green: 0.1, blue: 0.12, alpha: 1), UIColor(red: 0.85, green: 0.3, blue: 0.3, alpha: 1),
+                                     UIColor(red: 0.2, green: 0.55, blue: 0.3, alpha: 1), UIColor(red: 0.95, green: 0.7, blue: 0.2, alpha: 1),
+                                     UIColor(red: 0.85, green: 0.5, blue: 0.1, alpha: 1)]
+            let namen = ["unter 54", "54–69", "70–180", "181–250", "über 250"]
+            var x = rand
+            for (index, anteil) in d.bereiche.enumerated() {
+                let w = breite * CGFloat(anteil / 100)
+                farben[index].setFill()
+                UIBezierPath(rect: CGRect(x: x, y: y, width: w, height: 16)).fill()
+                x += w
+            }
+            y += 22
+            for (index, anteil) in d.bereiche.enumerated() {
+                _ = text("\(namen[index]) mg/dl: \(ZSFormat.zahl(anteil, stellen: 1)) %", .systemFont(ofSize: 9), farbe: .darkGray, x: rand + CGFloat(index) * breite / 5, w: breite / 5 - 4)
+            }
+            y += 24
+
+            // Tagesprofil
+            y += text("Tagesprofil (Median, 25.–75. Perzentil)", .systemFont(ofSize: 13, weight: .semibold))
+            y += 6
+            let feld = CGRect(x: rand, y: y, width: breite, height: 170)
+            UIColor(white: 0.95, alpha: 1).setFill()
+            let lo: Double = 40, hi: Double = 350
+            let zielOben = feld.maxY - feld.height * CGFloat((180 - lo) / (hi - lo))
+            let zielUnten = feld.maxY - feld.height * CGFloat((70 - lo) / (hi - lo))
+            UIBezierPath(rect: CGRect(x: feld.minX, y: zielOben, width: feld.width, height: zielUnten - zielOben)).fill()
+            let profil = d.tagesprofil
+            func punkt(_ stunde: Int, _ wert: Double) -> CGPoint {
+                CGPoint(x: feld.minX + feld.width * (CGFloat(stunde) + 0.5) / 24, y: feld.maxY - feld.height * CGFloat((min(max(wert, lo), hi) - lo) / (hi - lo)))
+            }
+            if profil.count > 1 {
+                let band = UIBezierPath()
+                band.move(to: punkt(profil[0].stunde, profil[0].p75))
+                profil.dropFirst().forEach { band.addLine(to: punkt($0.stunde, $0.p75)) }
+                profil.reversed().forEach { band.addLine(to: punkt($0.stunde, $0.p25)) }
+                band.close()
+                UIColor(white: 0.75, alpha: 1).setFill()
+                band.fill()
+                let linie = UIBezierPath()
+                linie.move(to: punkt(profil[0].stunde, profil[0].median))
+                profil.dropFirst().forEach { linie.addLine(to: punkt($0.stunde, $0.median)) }
+                linie.lineWidth = 2
+                UIColor.black.setStroke()
+                linie.stroke()
+            }
+            let gemerkt = y
+            for stunde in stride(from: 0, through: 24, by: 6) {
+                y = feld.maxY + 4
+                _ = text(String(format: "%02d:00", stunde % 24), .systemFont(ofSize: 8), farbe: .darkGray, x: feld.minX + feld.width * CGFloat(stunde) / 24 - 12, w: 40)
+            }
+            y = gemerkt + feld.height + 26
+
+            // Ereignisse
+            y += text("Ereignisse", .systemFont(ofSize: 13, weight: .semibold))
+            y += 6
+            let nachts = d.hypos.filter { ZSHypoFarbe.istNacht($0.start) }.count
+            let tiefster = d.hypos.map(\.tiefsterWert).min()
+            let zeilen = [
+                "Unterzucker-Episoden (Begleiter): \(d.hypos.count), davon nachts \(nachts)\(tiefster.map { ", tiefster Wert \(ZSFormat.zahl($0, stellen: 0)) mg/dl" } ?? "")",
+                "Keton-Messungen: \(d.ketone.count)\(d.ketone.map(\.mmol).max().map { ", höchster Wert \(ZSFormat.zahl($0, stellen: 1)) mmol/l" } ?? "")",
+                "Mahlzeiten über Zuckerschock: \(d.mahlzeiten.count), mit Rückmeldung \(d.mahlzeiten.filter { $0.rueckmeldung != nil }.count) (mehr: \(d.mahlzeiten.filter { $0.rueckmeldung == .mehr }.count), weniger: \(d.mahlzeiten.filter { $0.rueckmeldung == .weniger }.count))"
+            ]
+            for zeile in zeilen {
+                y += text("• " + zeile, .systemFont(ofSize: 10))
+                y += 3
+            }
+            y += 16
+            _ = text("Werte aus Loop (Sensor, Pumpe, KH-Einträge). Zuckerschock rechnet keine Insulindosis. Therapie-Einstellungen stehen in Loop.", .systemFont(ofSize: 8), farbe: .gray)
+        }
+    }
+}
+
+// MARK: - Ansicht
+
+struct ZSBerichtView: View {
+    var laden: (Int, @escaping (ZSBerichtDaten) -> Void) -> Void
+    var schliessen: () -> Void
+
+    @AppStorage("Zuckerschock.Bericht.name") private var name = ""
+    @State private var tage = 14
+    @State private var datei: URL?
+    @State private var daten: ZSBerichtDaten?
+    @State private var laedt = false
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Arztbericht", abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    Picker("Zeitraum", selection: $tage) {
+                        Text("14 Tage").tag(14)
+                        Text("30 Tage").tag(30)
+                        Text("90 Tage").tag(90)
+                    }
+                    .pickerStyle(.segmented)
+                    ZSEingabeFeld(titel: "Name auf dem Bericht (optional)") {
+                        TextField("z. B. Jon", text: $name)
+                    }
+                    Button {
+                        erstellen()
+                    } label: {
+                        Text(laedt ? "Bericht wird erstellt …" : "Bericht erstellen").font(ZSSchrift.headline)
+                    }
+                    .buttonStyle(ZSDruckStil(art: .primaer))
+                    .disabled(laedt)
+
+                    if let daten {
+                        VStack(alignment: .leading, spacing: ZSMass.space2) {
+                            Text("Zeit im Ziel \(ZSFormat.zahl(daten.bereiche[2], stellen: 0)) % · Mittelwert \(daten.mittel.map { ZSFormat.zahl($0, stellen: 0) } ?? "–") mg/dl · GMI \(daten.gmi.map { ZSFormat.zahl($0, stellen: 1) } ?? "–") %")
+                                .font(ZSSchrift.subhead)
+                                .foregroundStyle(ZSFarbe.text)
+                            Text("\(daten.werte.count) Werte, Abdeckung \(ZSFormat.zahl(daten.abdeckung, stellen: 0)) %")
+                                .font(ZSSchrift.footnote)
+                                .foregroundStyle(ZSFarbe.text2)
+                        }
+                        .zsKarte()
+                    }
+                    if let datei {
+                        ShareLink(item: datei) {
+                            Label("Bericht teilen oder drucken", systemImage: "square.and.arrow.up")
+                                .font(ZSSchrift.headline)
+                        }
+                        .buttonStyle(ZSRandStil())
+                    }
+                    Text("Der Bericht bleibt auf deinem iPhone, bis du ihn teilst.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+    }
+
+    private func erstellen() {
+        laedt = true
+        datei = nil
+        laden(tage) { neu in
+            daten = neu
+            let pdf = ZSBericht.pdf(neu, name: name)
+            let ziel = FileManager.default.temporaryDirectory.appendingPathComponent("Zuckerschock-Bericht-\(tage)-Tage.pdf")
+            try? pdf.write(to: ziel, options: .atomic)
+            datei = ziel
+            laedt = false
+        }
+    }
+}
