index 0000000..562cde0
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockHinweise.swift
@@ -0,0 +1,393 @@
+//
+//  ZuckerschockHinweise.swift
+//  Loop
+//
+//  Zuckerschock: Modi (Sport, Alkohol; Krank liegt im Keton-Check) und Hinweise:
+//  Spritz-Ess-Abstand, „Bolus vergessen?“, „Hoch bald“, Build-Wächter (90-Tage-Ablauf).
+//  Alles nur lesend aus Loop; die App rechnet keine Dosis.
+//
+
+import Combine
+import Foundation
+import HealthKit
+import LoopCore
+import LoopKit
+import SwiftUI
+import UserNotifications
+
+// MARK: - Modell
+
+struct ZSModi: Codable, Equatable {
+    var sportBis: Date?
+    var alkoholBis: Date?
+
+    func sportAktiv(_ jetzt: Date = Date()) -> Bool { (sportBis ?? .distantPast) > jetzt }
+    func alkoholAktiv(_ jetzt: Date = Date()) -> Bool { (alkoholBis ?? .distantPast) > jetzt }
+}
+
+struct ZSHinweis: Identifiable, Equatable {
+    enum Art: Equatable {
+        case spritzEss(essenAb: Date)
+        case bolusVergessen(gramm: Double, um: Date)
+        case hochBald(wert: String)
+        case build(tage: Int)
+        case sport
+        case alkohol
+        case stelle
+    }
+
+    var art: Art
+    var titel: String
+    var text: String
+
+    var id: String {
+        switch art {
+        case .spritzEss: return "spritzEss"
+        case .bolusVergessen: return "bolusVergessen"
+        case .hochBald: return "hochBald"
+        case .build: return "build"
+        case .sport: return "sport"
+        case .alkohol: return "alkohol"
+        case .stelle: return "stelle"
+        }
+    }
+
+    /// Kleinere Zahl zuerst: was jetzt zählt, steht oben.
+    var rang: Int {
+        switch art {
+        case .bolusVergessen: return 0
+        case .spritzEss: return 1
+        case .hochBald: return 2
+        case .stelle: return 3
+        case .alkohol: return 4
+        case .sport: return 5
+        case .build(let tage): return tage <= 3 ? 0 : 6
+        }
+    }
+}
+
+/// Reine Regeln, ohne Seiteneffekte.
+enum ZSHinweisRegeln {
+    /// Letzter Bolus innerhalb des Spritz-Ess-Abstands und seitdem keine KH: Essen ab …
+    static func spritzEss(abstandMinuten: Int?, boli: [Date], kh: [Date], jetzt: Date) -> Date? {
+        guard let abstand = abstandMinuten, abstand > 0, let bolus = boli.max(), jetzt.timeIntervalSince(bolus) >= 0 else { return nil }
+        let essenAb = bolus.addingTimeInterval(.minutes(Double(abstand)))
+        guard essenAb > jetzt, !kh.contains(where: { $0 >= bolus.addingTimeInterval(-.minutes(5)) }) else { return nil }
+        return essenAb
+    }
+
+    /// KH ab 10 g vor 15 bis 45 Minuten eingetragen, kein Bolus von 10 Minuten davor bis jetzt.
+    static func bolusVergessen(kh: [(datum: Date, gramm: Double)], boli: [Date], jetzt: Date) -> (Date, Double)? {
+        for eintrag in kh.sorted(by: { $0.datum > $1.datum }) where eintrag.gramm >= 10 {
+            let alter = jetzt.timeIntervalSince(eintrag.datum)
+            guard alter >= .minutes(15), alter <= .minutes(45) else { continue }
+            if !boli.contains(where: { $0 >= eintrag.datum.addingTimeInterval(-.minutes(10)) && $0 <= jetzt }) {
+                return (eintrag.datum, eintrag.gramm)
+            }
+        }
+        return nil
+    }
+
+    /// Jetzt im Ziel, laut Loops Vorhersage in 30 Minuten über 180.
+    static func hochBald(aktuell: Double?, in30: Double?, wertAlt: Bool) -> Bool {
+        guard let aktuell, let in30, !wertAlt else { return false }
+        return aktuell <= 180 && aktuell >= 70 && in30 > 180
+    }
+}
+
+// MARK: - Hinweise
+
+final class ZSHinweise: ObservableObject {
+    static let shared = ZSHinweise()
+
+    @Published var modi: ZSModi { didSet { sichern(); alkoholErinnerung() } }
+    @Published private(set) var loopHinweise: [ZSHinweis] = []
+    /// Nach einem Pod-Wechsel: „Wo sitzt der neue Pod?“
+    @Published var stelleOffen = false { didSet { UserDefaults.standard.set(stelleOffen, forKey: "Zuckerschock.stelleOffen") } }
+
+    private let schluessel = "Zuckerschock.Modi"
+    private var gemeldet = Set<String>()
+
+    init(modi: ZSModi? = nil) {
+        if let modi {
+            self.modi = modi
+        } else if let daten = UserDefaults.standard.data(forKey: schluessel), let gespeichert = try? JSONDecoder().decode(ZSModi.self, from: daten) {
+            self.modi = gespeichert
+        } else {
+            self.modi = ZSModi()
+        }
+        stelleOffen = UserDefaults.standard.bool(forKey: "Zuckerschock.stelleOffen")
+    }
+
+    private func sichern() {
+        UserDefaults.standard.set(try? JSONEncoder().encode(modi), forKey: schluessel)
+    }
+
+    /// Alle Hinweise für jetzt, nach Rang sortiert. `stand` liefert den Heute-Stand für „Hoch bald“.
+    func alle(stand: ZSHeuteStand?, jetzt: Date = Date()) -> [ZSHinweis] {
+        var liste = loopHinweise
+        if let stand, ZSHinweisRegeln.hochBald(aktuell: stand.aktuell?.mgdl, in30: stand.in30Min, wertAlt: ZSFormat.istAlt(stand.aktuell?.datum, jetzt: jetzt)),
+           let in30 = stand.in30Min {
+            let wert = "\(ZSFormat.glukose(in30, stand.einheit)) \(ZSFormat.einheit(stand.einheit))"
+            liste.append(ZSHinweis(art: .hochBald(wert: wert), titel: "Hoch bald", text: "In 30 Min. etwa \(wert) laut Loop."))
+        }
+        if let tage = ZSBuildWaechter.tageBisAblauf(jetzt: jetzt), tage <= 14 {
+            liste.append(ZSHinweis(art: .build(tage: tage), titel: "Build läuft ab",
+                                   text: tage <= 0 ? "Der Build ist abgelaufen. Starte Build Loop neu." : "Noch \(tage) \(tage == 1 ? "Tag" : "Tage"). Starte rechtzeitig Build Loop neu."))
+        }
+        if modi.alkoholAktiv(jetzt) {
+            liste.append(ZSHinweis(art: .alkohol, titel: "Alkohol-Modus", text: "Unterzucker-Gefahr bis morgen früh. Vor dem Schlafen Zucker prüfen, Snack nach deinem Plan."))
+        }
+        if modi.sportAktiv(jetzt) {
+            liste.append(ZSHinweis(art: .sport, titel: "Sport-Modus", text: "Nutze Loops Voreinstellung für Sport. Schnelle KH griffbereit halten."))
+        }
+        if stelleOffen {
+            liste.append(ZSHinweis(art: .stelle, titel: "Neuer Pod", text: "Wo sitzt er? Trag die Stelle ein."))
+        }
+        return liste.sorted { $0.rang < $1.rang }
+    }
+
+    func setzeLoopHinweise(_ neu: [ZSHinweis]) {
+        loopHinweise = neu
+        for hinweis in neu where !gemeldet.contains(meldeSchluessel(hinweis)) {
+            guard case .bolusVergessen = hinweis.art else { continue }
+            gemeldet.insert(meldeSchluessel(hinweis))
+            let inhalt = UNMutableNotificationContent()
+            inhalt.title = hinweis.titel
+            inhalt.body = hinweis.text
+            inhalt.sound = .default
+            inhalt.interruptionLevel = .timeSensitive
+            UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: "Zuckerschock.BolusVergessen", content: inhalt, trigger: nil))
+        }
+    }
+
+    private func meldeSchluessel(_ hinweis: ZSHinweis) -> String {
+        if case .bolusVergessen(_, let um) = hinweis.art { return "bolus-\(um.timeIntervalSince1970)" }
+        return hinweis.id
+    }
+
+    /// Nach Alkohol am nächsten Morgen um 7 Uhr erinnern.
+    private func alkoholErinnerung() {
+        let zentrale = UNUserNotificationCenter.current()
+        zentrale.removePendingNotificationRequests(withIdentifiers: ["Zuckerschock.Alkohol"])
+        guard modi.alkoholAktiv() else { return }
+        var morgen = Calendar.current.dateComponents([.year, .month, .day], from: Date().addingTimeInterval(.hours(12)))
+        morgen.hour = 7
+        let inhalt = UNMutableNotificationContent()
+        inhalt.title = "Guten Morgen"
+        inhalt.body = "Nach Alkohol: Zucker prüfen, die Unterzucker-Gefahr hält bis heute Mittag an."
+        inhalt.sound = .default
+        zentrale.add(UNNotificationRequest(identifier: "Zuckerschock.Alkohol", content: inhalt, trigger: UNCalendarNotificationTrigger(dateMatching: morgen, repeats: false)))
+    }
+}
+
+/// Liest Boli und KH aus Loop und setzt Spritz-Ess-Abstand und „Bolus vergessen?“.
+final class ZSHinweisWaechter {
+    private let deviceManager: DeviceDataManager
+    private let hinweise: ZSHinweise
+    private let speicher: ZSSpeicher
+    private var abos = Set<AnyCancellable>()
+
+    init(deviceManager: DeviceDataManager, hinweise: ZSHinweise, speicher: ZSSpeicher) {
+        self.deviceManager = deviceManager
+        self.hinweise = hinweise
+        self.speicher = speicher
+        let center = NotificationCenter.default
+        center.publisher(for: .LoopDataUpdated, object: deviceManager.loopManager).map { _ in () }
+            .merge(with: Timer.publish(every: 60, on: .main, in: .common).autoconnect().map { _ in () })
+            .debounce(for: .seconds(2), scheduler: DispatchQueue.main)
+            .sink { [weak self] in self?.pruefen() }
+            .store(in: &abos)
+        ZSBuildWaechter.mitteilungenPlanen()
+    }
+
+    func pruefen() {
+        let jetzt = Date()
+        let gruppe = DispatchGroup()
+        var boli: [Date] = []
+        var kh: [(datum: Date, gramm: Double)] = []
+        gruppe.enter()
+        deviceManager.doseStore.getNormalizedDoseEntries(start: jetzt.addingTimeInterval(-.hours(1)), end: nil) { ergebnis in
+            if case .success(let dosen) = ergebnis {
+                boli = dosen.filter { $0.type == .bolus }.map(\.startDate)
+            }
+            gruppe.leave()
+        }
+        gruppe.enter()
+        deviceManager.carbStore.getCarbEntries(start: jetzt.addingTimeInterval(-.hours(1)), end: nil) { ergebnis in
+            if case .success(let eintraege) = ergebnis {
+                kh = eintraege.map { (datum: $0.startDate, gramm: $0.quantity.doubleValue(for: .gram())) }
+            }
+            gruppe.leave()
+        }
+        gruppe.notify(queue: .main) { [weak self] in
+            guard let self else { return }
+            var neu: [ZSHinweis] = []
+            if let treffer = ZSHinweisRegeln.bolusVergessen(kh: kh, boli: boli, jetzt: jetzt) {
+                let (um, gramm) = treffer
+                neu.append(ZSHinweis(art: .bolusVergessen(gramm: gramm, um: um), titel: "Bolus vergessen?",
+                                     text: "\(ZSFormat.zahl(gramm, stellen: 0)) g KH um \(ZSFormat.uhrzeit(um)), noch kein Bolus."))
+            }
+            if let essenAb = ZSHinweisRegeln.spritzEss(abstandMinuten: self.speicher.plan.spritzEssAbstandMinuten, boli: boli, kh: kh.map(\.datum), jetzt: jetzt) {
+                neu.append(ZSHinweis(art: .spritzEss(essenAb: essenAb), titel: "Spritz-Ess-Abstand", text: "Essen ab \(ZSFormat.uhrzeit(essenAb)), laut deinem Plan."))
+            }
+            self.hinweise.setzeLoopHinweise(neu)
+        }
+    }
+}
+
+// MARK: - Build-Wächter (90-Tage-Ablauf)
+
+enum ZSBuildWaechter {
+    static func ablauf() -> Date? {
+        guard let profil = BuildDetails.default.profileExpiration else { return nil }
+        return AppExpirationAlerter.calculateExpirationDate(profileExpiration: profil)
+    }
+
+    static func tageBisAblauf(jetzt: Date = Date()) -> Int? {
+        guard let ablauf = ablauf() else { return nil }
+        return Calendar.current.dateComponents([.day], from: Calendar.current.startOfDay(for: jetzt), to: Calendar.current.startOfDay(for: ablauf)).day
+    }
+
+    /// Mitteilungen 10, 3 und 1 Tag vor Ablauf, jeweils um 18 Uhr.
+    static func mitteilungenPlanen() {
+        guard let ablauf = ablauf() else { return }
+        let zentrale = UNUserNotificationCenter.current()
+        for tage in [10, 3, 1] {
+            let kennung = "Zuckerschock.Build.\(tage)"
+            zentrale.removePendingNotificationRequests(withIdentifiers: [kennung])
+            guard let tag = Calendar.current.date(byAdding: .day, value: -tage, to: ablauf), tag > Date() else { continue }
+            var zeit = Calendar.current.dateComponents([.year, .month, .day], from: tag)
+            zeit.hour = 18
+            let inhalt = UNMutableNotificationContent()
+            inhalt.title = "Build läuft in \(tage) \(tage == 1 ? "Tag" : "Tagen") ab"
+            inhalt.body = "Starte Build Loop neu, damit Zuckerschock weiterläuft."
+            inhalt.sound = .default
+            zentrale.add(UNNotificationRequest(identifier: kennung, content: inhalt, trigger: UNCalendarNotificationTrigger(dateMatching: zeit, repeats: false)))
+        }
+    }
+}
+
+// MARK: - Hinweiskarte (neutral, ohne Marke)
+
+struct ZSHinweisKarte: View {
+    var hinweis: ZSHinweis
