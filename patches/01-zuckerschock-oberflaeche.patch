+extension UIColor {
+    /// "#rrggbb" oder "#rrggbbaa"
+    convenience init(zsHex hex: String) {
+        var s = hex.trimmingCharacters(in: .whitespaces)
+        if s.hasPrefix("#") { s.removeFirst() }
+        var wert: UInt64 = 0
+        Scanner(string: s).scanHexInt64(&wert)
+        let r, g, b, a: CGFloat
+        if s.count == 8 {
+            r = CGFloat((wert >> 24) & 0xff) / 255
+            g = CGFloat((wert >> 16) & 0xff) / 255
+            b = CGFloat((wert >> 8) & 0xff) / 255
+            a = CGFloat(wert & 0xff) / 255
+        } else {
+            r = CGFloat((wert >> 16) & 0xff) / 255
+            g = CGFloat((wert >> 8) & 0xff) / 255
+            b = CGFloat(wert & 0xff) / 255
+            a = 1
+        }
+        self.init(red: r, green: g, blue: b, alpha: a)
+    }
+}
