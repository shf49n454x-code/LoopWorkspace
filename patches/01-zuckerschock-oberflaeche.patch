+// MARK: - Wertring
+
+struct ZSWertring: View {
+    var stand: ZSHeuteStand?
+    var jetzt: Date
+
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    /// Skala 40–400 mg/dl, der Bogen nimmt drei Viertel des Kreises ein.
+    private static let skala: ClosedRange<Double> = 40...400
+    private static let bogen: Double = 0.75
+
+    private func anteil(_ mgdl: Double) -> Double {
+        let wert = min(max(mgdl, Self.skala.lowerBound), Self.skala.upperBound)
+        return (wert - Self.skala.lowerBound) / (Self.skala.upperBound - Self.skala.lowerBound)
+    }
+
+    var body: some View {
+        let einheit = stand?.einheit ?? .milligramsPerDeciliter
+        let aktuell = stand?.aktuell
+        let alt = ZSFormat.istAlt(aktuell?.datum, jetzt: jetzt)
+        let zustand = aktuell.map { ZSGlukoseZustand(mgdl: $0.mgdl) }
+        let bogenFarbe: Color = {
+            if aktuell == nil || alt { return ZSFarbe.text3 }
+            return zustand == .tief ? ZSFarbe.tief : ZSFarbe.orange
+        }()
+
+        VStack(spacing: ZSMass.space2) {
+            GeometryReader { geo in
+                let d = min(geo.size.width, geo.size.height)
+                let strich = max(10, d * 0.075)
+                ZStack {
+                    // Spur
+                    Circle()
+                        .trim(from: 0, to: Self.bogen)
+                        .stroke(ZSFarbe.flaeche2, style: StrokeStyle(lineWidth: strich, lineCap: .round))
+                        .rotationEffect(.degrees(135))
+                    // Zielband 70–180, leise
+                    Circle()
+                        .trim(from: anteil(70) * Self.bogen, to: anteil(180) * Self.bogen)
+                        .stroke(ZSFarbe.ziel.opacity(0.3), style: StrokeStyle(lineWidth: strich, lineCap: .butt))
+                        .rotationEffect(.degrees(135))
+                    // Wert
+                    Circle()
+                        .trim(from: 0, to: aktuell.map { max(0.005, anteil($0.mgdl)) * Self.bogen } ?? 0)
+                        .stroke(bogenFarbe, style: StrokeStyle(lineWidth: strich, lineCap: .round))
+                        .rotationEffect(.degrees(135))
+                        .animation(reduceMotion ? nil : ZSBewegung.iOS(ZSBewegung.dauerSeite), value: aktuell?.mgdl)
+
+                    VStack(spacing: 0) {
+                        Text(aktuell.map { ZSFormat.glukose($0.mgdl, einheit) } ?? "–")
+                            .zsZahl(.wertHero)
+                            .foregroundStyle(alt ? ZSFarbe.text2 : ZSFarbe.text)
+                            .minimumScaleFactor(0.5)
+                            .lineLimit(1)
+                            // Ziffern rollen, zählen nie hoch
+                            .contentTransition(.numericText(value: aktuell?.mgdl ?? 0))
+                            .animation(reduceMotion ? nil : .default, value: aktuell?.mgdl)
+                        Text(ZSFormat.einheit(einheit))
+                            .zsZahl(.einheit)
+                            .foregroundStyle(ZSFarbe.text2)
+                    }
+                    .padding(strich * 1.6)
+                }
+                .frame(width: d, height: d)
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+            }
+            .aspectRatio(1, contentMode: .fit)
+
+            status(aktuell: aktuell, zustand: zustand, alt: alt)
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(barrierefreiText(einheit: einheit, aktuell: aktuell, zustand: zustand, alt: alt))
+    }
+
+    @ViewBuilder
+    private func status(aktuell: ZSMesspunkt?, zustand: ZSGlukoseZustand?, alt: Bool) -> some View {
+        if let aktuell, let zustand {
+            HStack(spacing: ZSMass.space1) {
+                Circle()
+                    .fill(farbe(zustand))
+                    .frame(width: 8, height: 8)
+                Text(wort(zustand))
+                    .foregroundStyle(farbe(zustand))
+                if alt {
+                    // Alter statt Trend, sobald der Wert älter als 10 Minuten ist
+                    Text("· \(ZSFormat.alter(von: aktuell.datum, jetzt: jetzt))")
+                        .foregroundStyle(ZSFarbe.text2)
+                } else if let trend = stand?.trend {
+                    Text(trend.pfeil)
+                        .foregroundStyle(ZSFarbe.text)
+                }
+            }
+            .font(ZSSchrift.subhead.weight(.semibold))
+            .lineLimit(1)
+            .minimumScaleFactor(0.8)
+        } else {
+            Text("Kein Wert")
+                .font(ZSSchrift.subhead.weight(.semibold))
+                .foregroundStyle(ZSFarbe.text2)
+        }
+    }
+
+    private func farbe(_ zustand: ZSGlukoseZustand) -> Color {
+        switch zustand {
+        case .tief: return ZSFarbe.tief
+        case .ziel: return ZSFarbe.ziel
+        case .hoch: return ZSFarbe.hoch
+        }
+    }
+
+    private func wort(_ zustand: ZSGlukoseZustand) -> String {
+        switch zustand {
+        case .tief: return "Unter Ziel"
+        case .ziel: return "Im Ziel"
+        case .hoch: return "Über Ziel"
+        }
+    }
+
+    private func barrierefreiText(einheit: HKUnit, aktuell: ZSMesspunkt?, zustand: ZSGlukoseZustand?, alt: Bool) -> String {
+        guard let aktuell, let zustand else { return "Glukose: kein Wert" }
+        var teile = ["Glukose \(ZSFormat.glukose(aktuell.mgdl, einheit)) \(ZSFormat.einheit(einheit))"]
+        if alt {
+            teile.append(ZSFormat.alter(von: aktuell.datum, jetzt: jetzt))
+        } else if let trend = stand?.trend {
+            teile.append(trend.wort)
+        }
+        teile.append(wort(zustand))
+        return teile.joined(separator: ", ")
+    }
+}
