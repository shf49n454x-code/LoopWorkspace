+/// SF Pro Rounded für Zahlen, skaliert per ScaledMetric, Ziffern tabellarisch.
+struct ZSZahl: ViewModifier {
+    enum Stil {
+        case wertHero, wertGross, wert, wertKlein, einheit
+
+        var basis: CGFloat {
+            switch self {
+            case .wertHero: return 64
+            case .wertGross: return 34
+            case .wert: return 22
+            case .wertKlein: return 17
+            case .einheit: return 13
+            }
+        }
+
+        var gewicht: Font.Weight { self == .einheit ? .medium : .semibold }
+
+        var bezug: Font.TextStyle {
+            switch self {
+            case .wertHero, .wertGross: return .largeTitle
+            case .wert: return .title2
+            case .wertKlein: return .body
+            case .einheit: return .footnote
+            }
+        }
+    }
+
+    let stil: Stil
+    @ScaledMetric private var groesse: CGFloat
+
+    init(_ stil: Stil) {
+        self.stil = stil
+        _groesse = ScaledMetric(wrappedValue: stil.basis, relativeTo: stil.bezug)
+    }
+
+    func body(content: Content) -> some View {
+        content
+            .font(.system(size: groesse, weight: stil.gewicht, design: .rounded))
+            .monospacedDigit()
+            .tracking(stil == .wertHero ? -groesse * 0.02 : 0)
+    }
+}
