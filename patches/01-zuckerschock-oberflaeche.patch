diff --git a/Loop/Loop/Zuckerschock/ZuckerschockHeuteDaten.swift b/Loop/Loop/Zuckerschock/ZuckerschockHeuteDaten.swift
new file mode 100644
index 0000000..db86ace
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockHeuteDaten.swift
@@ -0,0 +1,490 @@
+//
+//  ZuckerschockHeuteDaten.swift
+//  Loop
+//
+//  Zuckerschock: Daten für den Heute-Screen.
+//  Liest ausschließlich aus bestehenden Loop-Quellen (GlucoseStore, LoopDataManager-Zustand,
+//  Pumpen- und CGM-Status). Schreibt nichts, rechnet keine Dosis.
+//
+
+import Combine
+import Foundation
+import HealthKit
+import LoopCore
+import LoopKit
+import LoopKitUI
+import UIKit
+
+// MARK: - Modell
+
+struct ZSMesspunkt: Identifiable, Equatable {
+    let datum: Date
+    /// Immer in mg/dl gespeichert, Anzeige rechnet in die Einheit des Nutzers um.
+    let mgdl: Double
+
+    var id: Date { datum }
+}
+
+enum ZSGlukoseZustand: Equatable {
+    case tief, ziel, hoch
+
+    /// Zielbereich laut CI: 70–180 mg/dl.
+    init(mgdl: Double) {
+        if mgdl < 70 {
+            self = .tief
+        } else if mgdl > 180 {
+            self = .hoch
+        } else {
+            self = .ziel
+        }
+    }
+}
+
+enum ZSTrend: Equatable {
+    case steigtSehrSchnell, steigtSchnell, steigt, stabil, faellt, faelltSchnell, faelltSehrSchnell
+
+    init(_ trend: GlucoseTrend) {
+        switch trend {
+        case .upUpUp: self = .steigtSehrSchnell
+        case .upUp: self = .steigtSchnell
+        case .up: self = .steigt
+        case .flat: self = .stabil
+        case .down: self = .faellt
+        case .downDown: self = .faelltSchnell
+        case .downDownDown: self = .faelltSehrSchnell
+        }
+    }
+
+    /// Trend als klares Zeichen, nie als Blitz.
+    var pfeil: String {
+        switch self {
+        case .steigtSehrSchnell: return "↑↑"
+        case .steigtSchnell: return "↑"
+        case .steigt: return "↗"
+        case .stabil: return "→"
+        case .faellt: return "↘"
+        case .faelltSchnell: return "↓"
+        case .faelltSehrSchnell: return "↓↓"
+        }
+    }
+
+    var wort: String {
+        switch self {
+        case .steigtSehrSchnell: return "steigt sehr schnell"
+        case .steigtSchnell: return "steigt schnell"
+        case .steigt: return "steigt"
+        case .stabil: return "stabil"
+        case .faellt: return "fällt"
+        case .faelltSchnell: return "fällt schnell"
+        case .faelltSehrSchnell: return "fällt sehr schnell"
+        }
+    }
+
+    var faellt: Bool { [.faellt, .faelltSchnell, .faelltSehrSchnell].contains(self) }
+}
+
+enum ZSLoopStatus: Equatable {
+    /// Geschlossener Loop, letzter Durchlauf höchstens 10 Minuten her.
+    case aktiv
+    /// Automatische Dosierung ist aus.
+    case offen
+    /// Letzter Durchlauf liegt länger zurück (oder nie).
+    case alt(seit: Date?)
+}
+
+enum ZSGeraeteZustand: Equatable {
+    case normal, bald, jetzt, ohne
+}
+
+struct ZSGeraet: Equatable {
+    var name: String
+    /// Verbrauchter Anteil der Laufzeit, 0…1, wie vom Gerät gemeldet.
+    var anteil: Double?
+    var zustand: ZSGeraeteZustand
+    var detail: String?
+}
+
+struct ZSHeuteStand: Equatable {
+    var einheit: HKUnit
+    var aktuell: ZSMesspunkt?
+    var trend: ZSTrend?
+    /// Änderung in mg/dl über 15 Minuten, aus der Trendrate des Sensors.
+    var aenderung15Min: Double?
+    var verlauf: [ZSMesspunkt]
+    /// Loops eigene Vorhersage, nur angezeigt.
+    var vorhersage: [ZSMesspunkt]
+    var insulinAktiv: Double?
+    var khAktiv: Double?
+    /// Zeitpunkt, zu dem Loop IOB/COB zuletzt berechnet hat.
+    var loopStand: Date?
+    var in30Min: Double?
+    var loop: ZSLoopStatus
+    var pumpe: ZSGeraet?
+    var sensor: ZSGeraet?
+    /// Wie in Loops Werkzeugleiste: Bolus und KH erst nach Einrichtung der Pumpe.
+    var aktionenMoeglich: Bool
+}
+
+// MARK: - Quelle
+
+protocol ZSHeuteQuelle: AnyObject {
+    /// Meldet, wenn Loop neue Daten hat.
+    var aenderungen: AnyPublisher<Void, Never> { get }
+    /// Lädt den aktuellen Stand; `fertig` läuft auf dem Main-Thread.
+    func laden(_ fertig: @escaping (ZSHeuteStand) -> Void)
+}
+
+final class ZSHeuteModell: ObservableObject {
+    @Published private(set) var stand: ZSHeuteStand?
+    /// Für die Altersanzeige („vor 12 Min“), läuft jede halbe Minute weiter.
+    @Published private(set) var jetzt = Date()
+
+    private let quelle: ZSHeuteQuelle
+    private var abos = Set<AnyCancellable>()
+
+    init(quelle: ZSHeuteQuelle) {
+        self.quelle = quelle
+
+        quelle.aenderungen
+            .debounce(for: .milliseconds(300), scheduler: DispatchQueue.main)
+            .sink { [weak self] in self?.neuLaden() }
+            .store(in: &abos)
+
+        Timer.publish(every: 30, on: .main, in: .common)
+            .autoconnect()
+            .sink { [weak self] datum in
+                self?.jetzt = datum
+            }
+            .store(in: &abos)
+
+        Timer.publish(every: 120, on: .main, in: .common)
+            .autoconnect()
+            .sink { [weak self] _ in self?.neuLaden() }
+            .store(in: &abos)
+
+        neuLaden()
+    }
+
+    func neuLaden() {
+        quelle.laden { [weak self] neu in
+            guard let self else { return }
+            self.jetzt = Date()
+            if self.stand != neu {
+                self.stand = neu
+            }
+        }
+    }
+}
+
+// MARK: - Live-Quelle aus Loop (nur lesend)
+
+final class ZSLoopQuelle: ZSHeuteQuelle {
+    private let deviceManager: DeviceDataManager
+    private let automaticDosingStatus: AutomaticDosingStatus
+    private let onboardingManager: OnboardingManager?
+
+    init(deviceManager: DeviceDataManager, automaticDosingStatus: AutomaticDosingStatus, onboardingManager: OnboardingManager?) {
+        self.deviceManager = deviceManager
+        self.automaticDosingStatus = automaticDosingStatus
+        self.onboardingManager = onboardingManager
+    }
+
+    var aenderungen: AnyPublisher<Void, Never> {
+        let center = NotificationCenter.default
+        let namen: [(Notification.Name, AnyObject?)] = [
+            (.LoopDataUpdated, deviceManager.loopManager),
+            (.PumpManagerChanged, deviceManager),
+            (.CGMManagerChanged, deviceManager),
+            (.PumpEventsAdded, deviceManager)
+        ]
+        let mitteilungen = namen.map { name, objekt in
+            center.publisher(for: name, object: objekt).map { _ in () }.eraseToAnyPublisher()
+        }
+        let dosierung = automaticDosingStatus.$automaticDosingEnabled
+            .removeDuplicates()
+            .map { _ in () }
+            .eraseToAnyPublisher()
+        let aktiv = center.publisher(for: UIApplication.didBecomeActiveNotification)
+            .map { _ in () }
+            .eraseToAnyPublisher()
+        return Publishers.MergeMany(mitteilungen + [dosierung, aktiv]).eraseToAnyPublisher()
+    }
+
+    func laden(_ fertig: @escaping (ZSHeuteStand) -> Void) {
+        let gruppe = DispatchGroup()
+        let start = Date().addingTimeInterval(-(TimeInterval.hours(3) + TimeInterval.minutes(10)))
+
+        var messwerte: [StoredGlucoseSample] = []
+        var vorhersage: [PredictedGlucoseValue] = []
+        var insulinAktiv: InsulinValue?
+        var khAktiv: CarbValue?
+
+        gruppe.enter()
+        deviceManager.glucoseStore.getGlucoseSamples(start: start, end: nil) { result in
+            if case .success(let werte) = result {
+                messwerte = werte
+            }
+            gruppe.leave()
+        }
+
+        gruppe.enter()
+        deviceManager.loopManager.getLoopState { _, state in
+            vorhersage = state.predictedGlucoseIncludingPendingInsulin ?? []
+            insulinAktiv = state.insulinOnBoard
+            khAktiv = state.carbsOnBoard
+            gruppe.leave()
+        }
+
+        gruppe.notify(queue: .main) { [weak self] in
+            guard let self else { return }
+            fertig(self.stand(messwerte: messwerte, vorhersage: vorhersage, insulinAktiv: insulinAktiv, khAktiv: khAktiv))
+        }
+    }
+
+    private func stand(messwerte: [StoredGlucoseSample], vorhersage: [PredictedGlucoseValue], insulinAktiv: InsulinValue?, khAktiv: CarbValue?) -> ZSHeuteStand {
+        let mgdl = HKUnit.milligramsPerDeciliter
+        let jetzt = Date()
+
+        let verlauf = messwerte
+            .map { ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: mgdl)) }
+            .sorted { $0.datum < $1.datum }
+
+        let letzter = messwerte.max { $0.startDate < $1.startDate }
+        let aktuell = letzter.map { ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: mgdl)) }
+
+        var aenderung: Double?
+        if let rate = letzter?.trendRate {
+            aenderung = rate.doubleValue(for: .milligramsPerDeciliterPerMinute) * 15
+        } else if let aktuell, let frueher = verlauf.last(where: { aktuell.datum.timeIntervalSince($0.datum) >= .minutes(14) }),
+                  aktuell.datum.timeIntervalSince(frueher.datum) <= .minutes(20) {
+            aenderung = aktuell.mgdl - frueher.mgdl
+        }
+
+        let zukunft = vorhersage
+            .map { ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: mgdl)) }
+            .filter { $0.datum >= (aktuell?.datum ?? jetzt) && $0.datum <= jetzt.addingTimeInterval(.minutes(35)) }
+
+        let ziel30 = jetzt.addingTimeInterval(.minutes(30))
+        let in30Min = vorhersage
+            .min { abs($0.startDate.timeIntervalSince(ziel30)) < abs($1.startDate.timeIntervalSince(ziel30)) }
+            .flatMap { abs($0.startDate.timeIntervalSince(ziel30)) <= .minutes(5) ? $0.quantity.doubleValue(for: mgdl) : nil }
+
+        let loop: ZSLoopStatus
+        let letzterLoop = deviceManager.loopManager.lastLoopCompleted
+        if !automaticDosingStatus.automaticDosingEnabled {
+            loop = .offen
+        } else if let letzterLoop, jetzt.timeIntervalSince(letzterLoop) <= .minutes(10) {
+            loop = .aktiv
+        } else {
+            loop = .alt(seit: letzterLoop)
+        }
+
+        let pumpeEingerichtet = onboardingManager?.isComplete == true || deviceManager.pumpManager?.isOnboarded == true
+
+        return ZSHeuteStand(
+            einheit: deviceManager.displayGlucosePreference.unit,
+            aktuell: aktuell,
+            trend: letzter?.trend.map(ZSTrend.init),
+            aenderung15Min: aenderung,
+            verlauf: verlauf,
+            vorhersage: zukunft,
+            insulinAktiv: insulinAktiv?.value,
+            khAktiv: khAktiv?.quantity.doubleValue(for: .gram()),
+            loopStand: insulinAktiv?.startDate ?? khAktiv?.startDate,
+            in30Min: in30Min,
+            loop: loop,
+            pumpe: pumpe(),
+            sensor: sensor(),
+            aktionenMoeglich: pumpeEingerichtet)
+    }
+
+    private func pumpe() -> ZSGeraet? {
+        guard let pumpManager = deviceManager.pumpManager else {
+            return ZSGeraet(name: "Pumpe", anteil: nil, zustand: .ohne, detail: "nicht verbunden")
+        }
+        let titel = pumpManager.localizedTitle
+        let name = titel.localizedCaseInsensitiveContains("pod") ? "Pod" : titel
+        let fortschritt = pumpManager.pumpLifecycleProgress
+
+        var teile: [String] = []
+        if let reservoir = deviceManager.doseStore.lastReservoirValue,
+           Date().timeIntervalSince(reservoir.startDate) <= .hours(1) {
+            teile.append("\(ZSFormat.zahl(reservoir.unitVolume, stellen: 0)) IE übrig")
+        }
+        let zustand = ZSGeraeteZustand(fortschritt?.progressState)
+        if let hinweis = zustand.hinweis {
+            teile.append(hinweis)
+        }
+        return ZSGeraet(name: name, anteil: fortschritt?.percentComplete, zustand: zustand, detail: teile.isEmpty ? nil : teile.joined(separator: " · "))
+    }
+
+    private func sensor() -> ZSGeraet? {
+        guard let cgmManager = deviceManager.cgmManager else {
+            return ZSGeraet(name: "Sensor", anteil: nil, zustand: .ohne, detail: "nicht verbunden")
+        }
+        let titel = cgmManager.localizedTitle
+        let name = titel.contains("G7") ? "G7" : titel
+        let fortschritt = (cgmManager as? CGMManagerUI)?.cgmLifecycleProgress
+        let zustand = ZSGeraeteZustand(fortschritt?.progressState)
+        return ZSGeraet(name: name, anteil: fortschritt?.percentComplete, zustand: zustand, detail: zustand.hinweis)
+    }
+}
+
+private extension ZSGeraeteZustand {
+    init(_ state: DeviceLifecycleProgressState?) {
+        switch state {
+        case .warning?: self = .bald
+        case .critical?: self = .jetzt
+        default: self = .normal
+        }
+    }
+
+    var hinweis: String? {
+        switch self {
+        case .bald: return "bald wechseln"
+        case .jetzt: return "jetzt wechseln"
+        case .normal, .ohne: return nil
+        }
+    }
+}
+
+// MARK: - Formatierung
+
+enum ZSFormat {
+    private static let deutsch = Locale(identifier: "de_DE")
+
+    static func zahl(_ wert: Double, stellen: Int) -> String {
+        let f = NumberFormatter()
+        f.locale = deutsch
+        f.numberStyle = .decimal
+        f.minimumFractionDigits = stellen
+        f.maximumFractionDigits = stellen
+        f.usesGroupingSeparator = false
+        return f.string(from: NSNumber(value: wert)) ?? "–"
+    }
+
+    static func istMmol(_ einheit: HKUnit) -> Bool {
+        einheit == .millimolesPerLiter
+    }
+
+    /// Glukose ohne Einheit in der Einheit des Nutzers.
+    static func glukose(_ mgdl: Double, _ einheit: HKUnit) -> String {
+        if istMmol(einheit) {
+            return zahl(HKQuantity(unit: .milligramsPerDeciliter, doubleValue: mgdl).doubleValue(for: einheit), stellen: 1)
+        }
+        return zahl(mgdl, stellen: 0)
+    }
+
+    /// Änderung mit Vorzeichen („−10“, „+0,6“).
+    static func aenderung(_ mgdl: Double, _ einheit: HKUnit) -> String {
+        let betrag = glukose(abs(mgdl), einheit)
+        if betrag == glukose(0, einheit) {
+            return "±\(betrag)"
+        }
+        return (mgdl < 0 ? "−" : "+") + betrag
+    }
+
+    static func einheit(_ einheit: HKUnit) -> String {
+        istMmol(einheit) ? "mmol/l" : "mg/dl"
+    }
+
+    static func alter(von datum: Date, jetzt: Date) -> String {
+        let minuten = max(0, Int(jetzt.timeIntervalSince(datum) / 60))
+        if minuten < 60 {
+            return "vor \(minuten) Min"
+        }
+        let stunden = minuten / 60
+        return stunden < 24 ? "vor \(stunden) Std" : "vor \(stunden / 24) Tagen"
+    }
+
+    /// Jeder Wert zeigt sein Alter, sobald er älter als 10 Minuten ist.
+    static func istAlt(_ datum: Date?, jetzt: Date) -> Bool {
+        guard let datum else { return true }
+        return jetzt.timeIntervalSince(datum) > .minutes(10)
+    }
+
+    static func uhrzeit(_ datum: Date) -> String {
+        let f = DateFormatter()
+        f.locale = deutsch
+        f.dateFormat = "HH:mm"
+        return f.string(from: datum)
+    }
+
+    static func tagesdatum(_ datum: Date) -> String {
+        let f = DateFormatter()
+        f.locale = deutsch
+        f.dateFormat = "EEEE, d. MMMM"
+        return f.string(from: datum)
+    }
+}
