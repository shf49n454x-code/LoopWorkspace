+// MARK: - Container
+
+final class ZuckerschockTabController: UIViewController {
+    /// Loops unveränderter Startbildschirm, im Tab „Verlauf“.
+    let statusTableViewController: StatusTableViewController?
+
+    private let auswahl = ZSTabAuswahl()
+    private let heuteModell: ZSHeuteModell
+    private var kinder: [ZSTab: UIViewController] = [:]
+    private var aktuellerTab: ZSTab = .heute
+    private var abo: AnyCancellable?
+
+    private lazy var leiste = UIHostingController(rootView: ZSBubbleMenue(auswahl: auswahl))
+    private lazy var auslauf = UIHostingController(rootView: ZSAuslauf())
+
+    /// Platz, den die Leiste unten belegt (Leiste + Abstand zum unteren Rand + Luft darüber).
+    private static let leistenPlatz: CGFloat = ZSMass.leisteHoehe + ZSMass.space2 + ZSMass.space2
+
+    init(statusTableViewController: StatusTableViewController?, heuteQuelle: ZSHeuteQuelle) {
+        self.statusTableViewController = statusTableViewController
+        self.heuteModell = ZSHeuteModell(quelle: heuteQuelle)
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// Nur der sichtbare Tab bekommt viewWillAppear & Co., damit Loops Ansicht weiß, ob sie zu sehen ist.
+    override var shouldAutomaticallyForwardAppearanceMethods: Bool { false }
+
+    override var childForStatusBarStyle: UIViewController? { kinder[aktuellerTab] }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = ZSFarbe.uiGrund
+
+        let aktionen = ZSAktionen(
+            essen: { [weak self] in self?.statusTableViewController?.presentCarbEntryScreen(nil) },
+            bolus: { [weak self] in self?.statusTableViewController?.presentBolusScreen() },
+            zumEssenTab: { [weak self] in self?.auswahl.tab = .essen },
+            einstellungen: { [weak self] in
+                guard let status = self?.statusTableViewController else { return }
+                status.onSettingsTapped(UIBarButtonItem())
+            })
+
+        kinder[.heute] = gastgeber(ZSHeuteView(modell: heuteModell, aktionen: aktionen))
+        kinder[.essen] = gastgeber(ZSEssenView(aktionen: aktionen))
+        kinder[.verlauf] = statusTableViewController ?? gastgeber(ZSHinweisView(titel: "Verlauf", text: "Hier liegt in der App Loops gewohnte Ansicht mit allen Kurven."))
+        kinder[.therapie] = gastgeber(ZSTherapieView(aktionen: aktionen))
+
+        // Alle Tabs bleiben im Fenster (nur versteckt). So kann Loops Ansicht jederzeit
+        // ihre Sheets zeigen, z. B. Bolus oder KH aus dem Heute-Tab.
+        for tab in ZSTab.allCases {
+            guard let kind = kinder[tab] else { continue }
+            addChild(kind)
+            kind.view.frame = view.bounds
+            kind.view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+            kind.view.isHidden = tab != aktuellerTab
+            kind.additionalSafeAreaInsets.bottom = Self.leistenPlatz
+            view.addSubview(kind.view)
+            kind.didMove(toParent: self)
+        }
+
+        einbauen(auslauf, interaktiv: false)
+        einbauen(leiste, interaktiv: true)
+        leiste.view.addInteraction(UILargeContentViewerInteraction())
+
+        NSLayoutConstraint.activate([
+            auslauf.view.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            auslauf.view.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            auslauf.view.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+            auslauf.view.topAnchor.constraint(equalTo: leiste.view.topAnchor, constant: -ZSMass.space6),
+
+            leiste.view.centerXAnchor.constraint(equalTo: view.centerXAnchor),
+            leiste.view.widthAnchor.constraint(lessThanOrEqualToConstant: 390),
+            leiste.view.leadingAnchor.constraint(greaterThanOrEqualTo: view.leadingAnchor, constant: ZSMass.space4),
+            leiste.view.trailingAnchor.constraint(lessThanOrEqualTo: view.trailingAnchor, constant: -ZSMass.space4),
+            leiste.view.heightAnchor.constraint(equalToConstant: ZSMass.leisteHoehe),
+            // Abstand zum unteren Rand: Safe Area + 8 pt (über Loops Werkzeugleiste, falls sichtbar)
+            leiste.view.bottomAnchor.constraint(equalTo: view.safeAreaLayoutGuide.bottomAnchor, constant: -ZSMass.space2)
+        ])
+        let breit = leiste.view.widthAnchor.constraint(equalTo: view.widthAnchor, constant: -2 * ZSMass.space4)
+        breit.priority = .defaultHigh
+        breit.isActive = true
+
+        abo = auswahl.$tab
+            .removeDuplicates()
+            .sink { [weak self] tab in self?.wechseln(zu: tab) }
+    }
+
+    private func gastgeber<V: View>(_ inhalt: V) -> UIViewController {
+        let host = UIHostingController(rootView: inhalt)
+        host.view.backgroundColor = ZSFarbe.uiGrund
+        return host
+    }
+
+    private func einbauen(_ host: UIViewController, interaktiv: Bool) {
+        addChild(host)
+        host.view.translatesAutoresizingMaskIntoConstraints = false
+        host.view.backgroundColor = .clear
+        host.view.isUserInteractionEnabled = interaktiv
+        view.addSubview(host.view)
+        host.didMove(toParent: self)
+    }
+
+    // MARK: Erscheinen
+
+    override func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        kinder[aktuellerTab]?.beginAppearanceTransition(true, animated: animated)
+        leistenAnpassen(animated: animated)
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        kinder[aktuellerTab]?.endAppearanceTransition()
+    }
+
+    override func viewWillDisappear(_ animated: Bool) {
+        super.viewWillDisappear(animated)
+        kinder[aktuellerTab]?.beginAppearanceTransition(false, animated: animated)
+    }
+
+    override func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        kinder[aktuellerTab]?.endAppearanceTransition()
+    }
+
+    // MARK: Tabwechsel
+
+    private func wechseln(zu tab: ZSTab) {
+        guard tab != aktuellerTab, isViewLoaded else { return }
+        let alt = kinder[aktuellerTab]
+        let neu = kinder[tab]
+        let sichtbar = view.window != nil
+
+        if sichtbar {
+            alt?.beginAppearanceTransition(false, animated: false)
+            neu?.beginAppearanceTransition(true, animated: false)
+        }
+        alt?.view.isHidden = true
+        neu?.view.isHidden = false
+        aktuellerTab = tab
+        if sichtbar {
+            alt?.endAppearanceTransition()
+            neu?.endAppearanceTransition()
+        }
+
+        leistenAnpassen(animated: false)
+        setNeedsStatusBarAppearanceUpdate()
+        UIAccessibility.post(notification: .screenChanged, argument: nil)
+    }
+
+    /// Navigationsleiste bleibt aus; Loops Werkzeugleiste nur im Tab „Verlauf“.
+    private func leistenAnpassen(animated: Bool) {
+        navigationController?.setNavigationBarHidden(true, animated: animated)
+        if aktuellerTab == .verlauf, let status = statusTableViewController {
+            toolbarItems = status.toolbarItems
+            navigationController?.setToolbarHidden(false, animated: animated)
+        } else {
+            navigationController?.setToolbarHidden(true, animated: animated)
+        }
+    }
+}
+
+// MARK: - Vorschau (nur Simulator, für Screenshots)
+
+#if targetEnvironment(simulator)
+enum ZSVorschau {
+    /// Im Simulator mit der Umgebungsvariable ZS_VORSCHAU=1 startet die Oberfläche mit Beispielwerten,
+    /// ohne Loop zu starten. Auf dem iPhone gibt es diesen Weg nicht.
+    static var istAktiv: Bool {
+        ProcessInfo.processInfo.environment["ZS_VORSCHAU"] == "1"
+    }
+
+    static func wurzel() -> UIViewController {
+        let umgebung = ProcessInfo.processInfo.environment
+        let szenario = ZSVorschauQuelle.Szenario(rawValue: umgebung["ZS_SZENARIO"] ?? "") ?? .normal
+        let tabs = ZuckerschockTabController(statusTableViewController: nil, heuteQuelle: ZSVorschauQuelle(szenario: szenario))
+        let navigation = UINavigationController(rootViewController: tabs)
+        navigation.setNavigationBarHidden(true, animated: false)
+        if let name = umgebung["ZS_TAB"], let tab = ZSTab.allCases.first(where: { $0.titel.lowercased() == name.lowercased() }) {
+            tabs.loadViewIfNeeded()
+            tabs.vorschauTab(tab)
+        }
+        return navigation
+    }
+}
+
+extension ZuckerschockTabController {
+    fileprivate func vorschauTab(_ tab: ZSTab) {
+        auswahl.tab = tab
+    }
+}
+#endif
