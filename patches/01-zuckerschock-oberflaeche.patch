+
+enum ZSTab: Int, CaseIterable, Identifiable {
+    case heute, essen, verlauf, therapie
+
+    var id: Int { rawValue }
+
+    var titel: String {
+        switch self {
+        case .heute: return "Heute"
+        case .essen: return "Essen"
+        case .verlauf: return "Verlauf"
+        case .therapie: return "Therapie"
+        }
+    }
+
+    var symbol: String {
+        switch self {
+        case .heute: return "chart.line.uptrend.xyaxis"
+        case .essen: return "fork.knife"
+        case .verlauf: return "clock"
+        case .therapie: return "slider.horizontal.3"
+        }
+    }
+}
