+/// Der Schock-Tropfen: Tropfen mit Blitz als echtem Loch (evenodd), aus app-icon-standard.svg.
+struct ZSSchockTropfen: Shape {
+    func path(in rect: CGRect) -> Path {
+        // Original-Koordinaten: viewBox 304 170 416 598
+        var p = Path()
+        p.move(to: CGPoint(x: 512, y: 170))
+        p.addCurve(to: CGPoint(x: 720, y: 560), control1: CGPoint(x: 610, y: 300), control2: CGPoint(x: 720, y: 420))
+        p.addArc(center: CGPoint(x: 512, y: 560), radius: 208, startAngle: .degrees(0), endAngle: .degrees(180), clockwise: false)
+        p.addCurve(to: CGPoint(x: 512, y: 170), control1: CGPoint(x: 304, y: 420), control2: CGPoint(x: 414, y: 300))
+        p.closeSubpath()
+
+        let blitz: [(CGFloat, CGFloat)] = [
+            (556.2, 400.8), (556.5, 397), (556, 393.2), (554.8, 389.5), (552.9, 386.2), (550.3, 383.4),
+            (547.3, 381.1), (543.9, 379.4), (540.1, 378.4), (536.3, 378.2), (532.5, 378.8), (528.9, 380.1),
+            (525.6, 382), (522.8, 384.6), (520.6, 387.7), (421.4, 555.7), (419.9, 559), (419, 562.6),
+            (418.8, 566.3), (419.3, 570), (420.5, 573.5), (422.3, 576.7), (424.7, 579.5), (427.6, 581.7),
+            (430.9, 583.4), (434.4, 584.5), (438.1, 584.8), (480.5, 584.8), (462.7, 683), (462.4, 686.9),
+            (462.9, 690.7), (464.1, 694.4), (466, 697.7), (468.6, 700.6), (471.7, 703), (475.1, 704.6),
+            (478.9, 705.6), (482.7, 705.8), (486.5, 705.2), (490.2, 703.9), (493.4, 701.9), (496.3, 699.2),
+            (498.5, 696.1), (602.7, 514.7), (604.2, 511.3), (605, 507.8), (605.2, 504.1), (604.7, 500.5),
+            (603.5, 497), (601.6, 493.8), (599.2, 491), (596.4, 488.8), (593.1, 487.1), (589.6, 486.1),
+            (585.9, 485.7), (541.6, 485.7)
+        ]
+        p.move(to: CGPoint(x: blitz[0].0, y: blitz[0].1))
+        for punkt in blitz.dropFirst() {
+            p.addLine(to: CGPoint(x: punkt.0, y: punkt.1))
+        }
+        p.closeSubpath()
+
+        let quelle = CGRect(x: 304, y: 170, width: 416, height: 598)
+        let massstab = min(rect.width / quelle.width, rect.height / quelle.height)
+        let versatzX = rect.midX - quelle.midX * massstab
+        let versatzY = rect.midY - quelle.midY * massstab
+        return p.applying(CGAffineTransform(a: massstab, b: 0, c: 0, d: massstab, tx: versatzX, ty: versatzY))
+    }
+}
