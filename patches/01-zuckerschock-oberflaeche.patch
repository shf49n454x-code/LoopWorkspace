+final class ZSTabAuswahl: ObservableObject {
+    @Published var tab: ZSTab = .heute
+}
+
+// MARK: - Bubble-Menü
+
+/// Der aktive Tab sitzt als oranger Tropfen tief in einer schmalen Leiste.
+struct ZSBubbleMenue: View {
+    @ObservedObject var auswahl: ZSTabAuswahl
+
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+    @Environment(\.colorSchemeContrast) private var kontrast
+    @Environment(\.colorScheme) private var farbschema
+
+    var body: some View {
+        GeometryReader { geo in
+            let breite = geo.size.width / CGFloat(ZSTab.allCases.count)
+            ZStack(alignment: .topLeading) {
+                Color.clear
+
+                // Tropfen hinter dem Icon, wandert nur per transform.
+                Circle()
+                    .fill(ZSFarbe.orange)
+                    .frame(width: ZSMass.tropfen, height: ZSMass.tropfen)
+                    .offset(x: breite * (CGFloat(auswahl.tab.rawValue) + 0.5) - ZSMass.tropfen / 2, y: 3)
+                    .animation(reduceMotion ? nil : ZSBewegung.iOS(ZSBewegung.dauerKurz), value: auswahl.tab)
+                    .accessibilityHidden(true)
+
+                HStack(spacing: 0) {
+                    ForEach(ZSTab.allCases) { tab in
+                        knopf(tab)
+                            .frame(width: breite)
+                    }
+                }
+            }
+        }
+        .frame(height: ZSMass.leisteHoehe)
+        .background { leiste }
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel("Tab-Leiste")
+    }
+
+    private func knopf(_ tab: ZSTab) -> some View {
+        let aktiv = auswahl.tab == tab
+        return Button {
+            // Tabwechsel ohne Überblenden: Inhalt wechselt sofort.
+            auswahl.tab = tab
+        } label: {
+            VStack(spacing: 5) {
+                Image(systemName: tab.symbol)
+                    .font(.system(size: 18, weight: .regular))
+                    .frame(width: ZSMass.tropfen, height: ZSMass.tropfen)
+                    .foregroundStyle(aktiv ? ZSFarbe.tinte : ZSFarbe.text2)
+                Text(tab.titel)
+                    .font(ZSSchrift.tabLabel.weight(aktiv ? .semibold : .medium))
+                    .foregroundStyle(aktiv ? ZSFarbe.orangeText : ZSFarbe.text2)
+                    .lineLimit(1)
+                    .minimumScaleFactor(0.7)
+                    .dynamicTypeSize(...DynamicTypeSize.xLarge)
+            }
+            .padding(.top, 3)
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .top)
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel(tab.titel)
+        .accessibilityValue("Tab \(tab.rawValue + 1) von \(ZSTab.allCases.count)")
+        .accessibilityAddTraits(aktiv ? .isSelected : [])
+        .accessibilityShowsLargeContentViewer {
+            Label(tab.titel, systemImage: tab.symbol)
+        }
+    }
+
+    @ViewBuilder
+    private var leiste: some View {
+        if #available(iOS 26, *) {
+            if reduceTransparency {
+                deckendeLeiste
+            } else {
+                Color.clear
+                    .glassEffect(.regular, in: Capsule(style: .continuous))
+                    .overlay(randLinie(Capsule(style: .continuous)))
+                    .shadow(color: .black.opacity(farbschema == .dark ? 0.55 : 0.12), radius: 16, y: 12)
+            }
+        } else {
+            deckendeLeiste
+        }
+    }
+
+    /// Deckende Fassung für „Transparenz reduzieren“ (und vor iOS 26).
+    private var deckendeLeiste: some View {
+        Capsule(style: .continuous)
+            .fill(ZSFarbe.leiste)
+            .overlay(randLinie(Capsule(style: .continuous)))
+            .shadow(color: .black.opacity(farbschema == .dark ? 0.55 : 0.12), radius: 16, y: 12)
+    }
+
+    @ViewBuilder
+    private func randLinie(_ form: Capsule) -> some View {
+        if kontrast == .increased {
+            form.strokeBorder(ZSFarbe.randSteuer, lineWidth: 1)
+        } else if farbschema == .light {
+            form.strokeBorder(ZSFarbe.haarlinie, lineWidth: 1)
+        }
+    }
+}
