+struct ZSKurve: View {
+    var stand: ZSHeuteStand?
+    var jetzt: Date
+
+    @State private var finger: ZSMesspunkt? = nil
+
+    private var punkte: [ZSMesspunkt] { stand?.verlauf ?? [] }
+    private var zukunft: [ZSMesspunkt] { stand?.vorhersage ?? [] }
+    private var einheit: HKUnit { stand?.einheit ?? .milligramsPerDeciliter }
+
+    private var zeitraum: ClosedRange<Date> {
+        let ende = max(jetzt, zukunft.last?.datum ?? jetzt)
+        return jetzt.addingTimeInterval(-.hours(3))...ende
+    }
+
+    private var wertebereich: ClosedRange<Double> {
+        let alle = (punkte + zukunft).map(\.mgdl)
+        let unten = min(60, (alle.min() ?? 60) - 10)
+        let oben = max(200, (alle.max() ?? 200) + 10)
+        return unten...oben
+    }
+
+    var body: some View {
+        VStack(spacing: 6) {
+            GeometryReader { geo in
+                let flaeche = CGRect(origin: .zero, size: geo.size)
+                ZStack(alignment: .topLeading) {
+                    zielband(in: flaeche)
+                    if !punkte.isEmpty {
+                        fuellung(in: flaeche)
+                        linie(punkte, in: flaeche)
+                            .stroke(ZSFarbe.orangeLinie, style: StrokeStyle(lineWidth: 2.5, lineCap: .round, lineJoin: .round))
+                        if let letzter = punkte.last, !zukunft.isEmpty {
+                            linie([letzter] + zukunft, in: flaeche)
+                                .stroke(ZSFarbe.orangeLinie.opacity(0.7), style: StrokeStyle(lineWidth: 2, lineCap: .round, dash: [2, 5]))
+                        }
+                        if let letzter = punkte.last {
+                            Circle()
+                                .fill(ZSFarbe.orange)
+                                .overlay(Circle().strokeBorder(ZSFarbe.tinte, lineWidth: 2.5))
+                                .frame(width: 13, height: 13)
+                                .position(position(letzter, in: flaeche))
+                        }
+                    } else {
+                        Text("Noch keine Werte")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                            .frame(maxWidth: .infinity, maxHeight: .infinity)
+                    }
+                    grenzen(in: flaeche)
+                    if let finger {
+                        fingerAnzeige(finger, in: flaeche)
+                    }
+                }
+                .contentShape(Rectangle())
+                .gesture(
+                    DragGesture(minimumDistance: 0)
+                        .onChanged { zug in finger = naechster(zu: zug.location.x, in: flaeche) }
+                        .onEnded { _ in finger = nil }
+                )
+            }
+            achse
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Zuckerkurve der letzten 3 Stunden")
+        .accessibilityValue(barrierefreiWert)
+    }
+
+    private var barrierefreiWert: String {
+        guard let minimum = punkte.min(by: { $0.mgdl < $1.mgdl }), let maximum = punkte.max(by: { $0.mgdl < $1.mgdl }) else {
+            return "keine Werte"
+        }
+        let e = ZSFormat.einheit(einheit)
+        return "tiefster Wert \(ZSFormat.glukose(minimum.mgdl, einheit)) \(e) um \(ZSFormat.uhrzeit(minimum.datum)), höchster Wert \(ZSFormat.glukose(maximum.mgdl, einheit)) \(e) um \(ZSFormat.uhrzeit(maximum.datum))"
+    }
+
+    private var achse: some View {
+        let start = zeitraum.lowerBound
+        let stunden = (1...2).map { start.addingTimeInterval(.hours(Double($0))) }
+        return HStack {
+            Text(ZSFormat.uhrzeit(start))
+            Spacer()
+            ForEach(stunden, id: \.self) { datum in
+                Text(ZSFormat.uhrzeit(datum))
+                Spacer()
+            }
+            Text("jetzt")
+        }
+        .font(ZSSchrift.caption)
+        .foregroundStyle(ZSFarbe.text3)
+        .accessibilityHidden(true)
+    }
+
+    private func x(_ datum: Date, in r: CGRect) -> CGFloat {
+        let gesamt = zeitraum.upperBound.timeIntervalSince(zeitraum.lowerBound)
+        guard gesamt > 0 else { return r.minX }
+        return r.minX + CGFloat(datum.timeIntervalSince(zeitraum.lowerBound) / gesamt) * r.width
+    }
+
+    private func y(_ mgdl: Double, in r: CGRect) -> CGFloat {
+        let b = wertebereich
+        let anteil = (min(max(mgdl, b.lowerBound), b.upperBound) - b.lowerBound) / (b.upperBound - b.lowerBound)
+        return r.maxY - CGFloat(anteil) * r.height
+    }
+
+    private func position(_ p: ZSMesspunkt, in r: CGRect) -> CGPoint {
+        CGPoint(x: x(p.datum, in: r), y: y(p.mgdl, in: r))
+    }
+
+    private func linie(_ werte: [ZSMesspunkt], in r: CGRect) -> Path {
+        Path { pfad in
+            guard let erster = werte.first else { return }
+            pfad.move(to: position(erster, in: r))
+            for p in werte.dropFirst() {
+                pfad.addLine(to: position(p, in: r))
+            }
+        }
+    }
+
+    private func fuellung(in r: CGRect) -> some View {
+        Path { pfad in
+            guard let erster = punkte.first, let letzter = punkte.last else { return }
+            pfad.move(to: CGPoint(x: x(erster.datum, in: r), y: r.maxY))
+            for p in punkte {
+                pfad.addLine(to: position(p, in: r))
+            }
+            pfad.addLine(to: CGPoint(x: x(letzter.datum, in: r), y: r.maxY))
+            pfad.closeSubpath()
+        }
+        .fill(LinearGradient(colors: [ZSFarbe.orange.opacity(0.3), ZSFarbe.orange.opacity(0)], startPoint: .top, endPoint: .bottom))
+    }
+
+    /// Zielband 70–180 als Fläche text bei 5 %, keine Linien.
+    private func zielband(in r: CGRect) -> some View {
+        let oben = y(180, in: r)
+        let unten = y(70, in: r)
+        return Rectangle()
+            .fill(ZSFarbe.text.opacity(0.05))
+            .frame(width: r.width, height: max(0, unten - oben))
+            .offset(y: oben)
+    }
+
+    /// Die zwei Grenzen rechts, caption in text-3. Ist das Band zu schmal (kleines iPhone), steht nur 180 über dem Band.
+    private func grenzen(in r: CGRect) -> some View {
+        let innen = y(70, in: r) - y(180, in: r) >= 44
+        return ZStack(alignment: .topTrailing) {
+            ForEach(innen ? [180.0, 70.0] : [180.0], id: \.self) { grenze in
+                Text(ZSFormat.glukose(grenze, einheit))
+                    .font(ZSSchrift.caption)
+                    .foregroundStyle(ZSFarbe.text3)
+                    .padding(.trailing, 2)
+                    .frame(width: r.width, alignment: .trailing)
+                    .position(x: r.midX, y: y(grenze, in: r) + (grenze > 100 ? 9 : -9) * (innen ? 1 : -1))
+            }
+        }
+        .accessibilityHidden(true)
+    }
+
+    private func naechster(zu fingerX: CGFloat, in r: CGRect) -> ZSMesspunkt? {
+        punkte.min { abs(x($0.datum, in: r) - fingerX) < abs(x($1.datum, in: r) - fingerX) }
+    }
+
+    private func fingerAnzeige(_ p: ZSMesspunkt, in r: CGRect) -> some View {
+        let punkt = position(p, in: r)
+        let text = "\(ZSFormat.glukose(p.mgdl, einheit)) \(ZSFormat.einheit(einheit)) · \(ZSFormat.uhrzeit(p.datum))"
+        return ZStack(alignment: .topLeading) {
+            Rectangle()
+                .fill(ZSFarbe.text3)
+                .frame(width: 1, height: r.height)
+                .position(x: punkt.x, y: r.midY)
+            Circle()
+                .fill(ZSFarbe.text)
+                .frame(width: 9, height: 9)
+                .position(punkt)
+            Text(text)
+                .font(ZSSchrift.caption)
+                .monospacedDigit()
+                .foregroundStyle(ZSFarbe.text)
+                .padding(.horizontal, ZSMass.space2)
+                .padding(.vertical, ZSMass.space1)
+                .background(Capsule().fill(ZSFarbe.flaeche3))
+                .fixedSize()
+                .position(x: min(max(punkt.x, 70), r.maxX - 70), y: 12)
+        }
+    }
+}
