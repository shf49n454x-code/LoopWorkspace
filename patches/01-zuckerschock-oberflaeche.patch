+struct ZSBildmarke: View {
+    var body: some View {
+        ZSSchockTropfen()
+            .fill(ZSFarbe.orange, style: FillStyle(eoFill: true))
+            .aspectRatio(416 / 598, contentMode: .fit)
+            .accessibilityHidden(true)
+    }
