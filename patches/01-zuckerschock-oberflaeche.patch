+// MARK: - Pod-/Sensor-Karte
+
+private struct ZSGeraeteKarte: View {
+    var pumpe: ZSGeraet?
+    var sensor: ZSGeraet?
+    var gestapelt: Bool
+
+    var body: some View {
+        let layout = gestapelt ? AnyLayout(VStackLayout(spacing: ZSMass.space3)) : AnyLayout(HStackLayout(alignment: .top, spacing: ZSMass.space4))
+        layout {
+            ZSGeraeteSpalte(geraet: pumpe ?? ZSGeraet(name: "Pumpe", anteil: nil, zustand: .ohne, detail: "nicht verbunden"))
+            ZSGeraeteSpalte(geraet: sensor ?? ZSGeraet(name: "Sensor", anteil: nil, zustand: .ohne, detail: "nicht verbunden"))
+        }
+        .padding(.vertical, -ZSMass.space1)
+        .zsKarte()
+    }
+}
+
+private struct ZSGeraeteSpalte: View {
+    var geraet: ZSGeraet
+
+    private var farbe: Color {
+        switch geraet.zustand {
+        case .normal: return ZSFarbe.orange
+        case .bald: return ZSFarbe.hoch
+        case .jetzt: return ZSFarbe.tief
+        case .ohne: return ZSFarbe.text3
+        }
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space2) {
+            HStack(alignment: .firstTextBaseline, spacing: ZSMass.space2) {
+                Text(geraet.name)
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                    .lineLimit(1)
+                Spacer(minLength: 0)
+                if let detail = geraet.detail {
+                    Text(detail)
+                        .font(ZSSchrift.caption)
+                        .foregroundStyle(geraet.zustand == .bald || geraet.zustand == .jetzt ? farbe : ZSFarbe.text2)
+                        .lineLimit(1)
+                        .minimumScaleFactor(0.8)
+                }
+            }
+            GeometryReader { geo in
+                ZStack(alignment: .leading) {
+                    Capsule().fill(ZSFarbe.flaeche2)
+                    if let anteil = geraet.anteil {
+                        Capsule()
+                            .fill(farbe)
+                            .frame(width: max(6, geo.size.width * CGFloat(min(max(anteil, 0), 1))))
+                    }
+                }
+            }
+            .frame(height: 6)
+        }
+        .frame(maxWidth: .infinity)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(geraet.name)
+        .accessibilityValue(barrierefreiWert)
+    }
+
+    private var barrierefreiWert: String {
+        var teile: [String] = []
+        if let anteil = geraet.anteil {
+            teile.append("\(Int((anteil * 100).rounded())) Prozent der Laufzeit verbraucht")
+        }
+        if let detail = geraet.detail {
+            teile.append(detail)
+        }
+        return teile.joined(separator: ", ")
+    }
+}
