+/// Beispielwerte wie in der Klick-Demo. Wird nur im Simulator mit ZS_VORSCHAU=1 benutzt.
+final class ZSVorschauQuelle: ZSHeuteQuelle {
+    enum Szenario: String {
+        case normal, tief, alt, hoch
+    }
+
+    private let szenario: Szenario
+
+    init(szenario: Szenario) {
+        self.szenario = szenario
+    }
+
+    var aenderungen: AnyPublisher<Void, Never> { Empty().eraseToAnyPublisher() }
+
+    func laden(_ fertig: @escaping (ZSHeuteStand) -> Void) {
+        let jetzt = Date()
+        let alterMin: Double = szenario == .alt ? 14 : 2
+        let letzter = jetzt.addingTimeInterval(-.minutes(alterMin))
+
+        // Frühstücksspitze wie in der Demo, alle 5 Minuten ein Wert über 3 Stunden.
+        let form: [Double] = [
+            104, 106, 107, 107, 108, 115, 128, 142, 156, 168, 177, 181, 180, 176, 166, 150, 137, 130,
+            126, 122, 119, 118, 117, 118, 116, 115, 116, 117, 115, 114, 114, 113, 114, 115, 114, 114, 114
+        ]
+        let verschiebung: Double
+        switch szenario {
+        case .tief: verschiebung = -52
+        case .hoch: verschiebung = 98
+        case .normal, .alt: verschiebung = 0
+        }
+        let verlauf = form.enumerated().map { index, wert -> ZSMesspunkt in
+            let datum = letzter.addingTimeInterval(-.minutes(Double(form.count - 1 - index) * 5))
+            let anteil = Double(index) / Double(form.count - 1)
+            return ZSMesspunkt(datum: datum, mgdl: wert + verschiebung * anteil * anteil)
+        }
+        let aktuell = verlauf.last!
+        let richtung: Double = szenario == .hoch ? 2.5 : (szenario == .tief ? -1.4 : -0.7)
+        let vorhersage = (0...6).map { schritt in
+            ZSMesspunkt(datum: aktuell.datum.addingTimeInterval(.minutes(Double(schritt) * 5)),
+                        mgdl: aktuell.mgdl + richtung * Double(schritt) * 4)
+        }
+
+        let trend: ZSTrend
+        switch szenario {
+        case .tief: trend = .faellt
+        case .hoch: trend = .steigt
+        case .normal, .alt: trend = .faellt
+        }
+
+        fertig(ZSHeuteStand(
+            einheit: .milligramsPerDeciliter,
+            aktuell: aktuell,
+            trend: trend,
+            aenderung15Min: richtung * 12,
+            verlauf: verlauf,
+            vorhersage: vorhersage,
+            insulinAktiv: 1.35,
+            khAktiv: 24,
+            loopStand: szenario == .alt ? letzter : jetzt.addingTimeInterval(-.minutes(1)),
+            in30Min: aktuell.mgdl + richtung * 24,
+            loop: szenario == .alt ? .alt(seit: letzter) : .aktiv,
+            pumpe: ZSGeraet(name: "Pod", anteil: 0.75, zustand: .normal, detail: "38 IE übrig"),
+            sensor: ZSGeraet(name: "G7", anteil: 0.7, zustand: .normal, detail: nil),
+            aktionenMoeglich: true))
+    }
+}
