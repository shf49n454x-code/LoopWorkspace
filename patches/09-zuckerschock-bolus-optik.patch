diff --git a/Loop/Loop/Zuckerschock/ZuckerschockTheme.swift b/Loop/Loop/Zuckerschock/ZuckerschockTheme.swift
index e36f902..6d9ef1d 100644
--- a/Loop/Loop/Zuckerschock/ZuckerschockTheme.swift
+++ b/Loop/Loop/Zuckerschock/ZuckerschockTheme.swift
@@ -318,3 +318,97 @@ struct ZSBildmarke: View {
             .accessibilityHidden(true)
     }
 }
+
+// MARK: - Schieben zum Bestätigen
+
+/// Insulin-Abgabe nie per Antippen: Der Knopf muss ganz nach rechts geschoben werden.
+/// Loslassen vorher springt zurück. Liefert `bestaetigt` false (z. B. Face ID abgebrochen,
+/// Prüfung von Loop schlägt an), springt der Schieber zurück. VoiceOver: eigene, benannte Aktion.
+struct ZSSchieber: View {
+    var text: String
+    var aktiv: Bool = true
+    var bestaetigt: () async -> Bool
+
+    @State private var versatz: CGFloat = 0
+    @State private var laeuft = false
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    private let hoehe: CGFloat = 60
+
+    var body: some View {
+        GeometryReader { geo in
+            let weg = max(1, geo.size.width - hoehe)
+            ZStack(alignment: .leading) {
+                Capsule(style: .continuous)
+                    .fill(ZSFarbe.flaeche2)
+                Capsule(style: .continuous)
+                    .fill(ZSVerlauf.primaer)
+                    .frame(width: hoehe + versatz)
+                Text(text)
+                    .font(ZSSchrift.headline)
+                    .foregroundStyle(ZSFarbe.text)
+                    .lineLimit(1)
+                    .minimumScaleFactor(0.7)
+                    .frame(maxWidth: .infinity)
+                    .padding(.leading, hoehe)
+                    .padding(.trailing, ZSMass.space4)
+                    .opacity(Double(max(0, 1 - versatz / (weg * 0.6))))
+                Circle()
+                    .fill(ZSFarbe.text)
+                    .frame(width: hoehe - 8, height: hoehe - 8)
+                    .overlay {
+                        if laeuft {
+                            ProgressView().tint(ZSFarbe.grund)
+                        } else {
+                            Image(systemName: "chevron.right.2")
+                                .font(.headline)
+                                .foregroundStyle(ZSFarbe.grund)
+                        }
+                    }
+                    .offset(x: versatz + 4)
+                    .gesture(ziehen(weg: weg))
+            }
+        }
+        .frame(height: hoehe)
+        .opacity(aktiv ? 1 : 0.45)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(text)
+        .accessibilityHint("Zum Bestätigen den Knopf ganz nach rechts schieben.")
+        .accessibilityAction(named: Text(text)) { ausloesen() }
+    }
+
+    private func ziehen(weg: CGFloat) -> some Gesture {
+        DragGesture(minimumDistance: 2)
+            .onChanged { wert in
+                guard aktiv, !laeuft else { return }
+                versatz = min(max(0, wert.translation.width), weg)
+            }
+            .onEnded { _ in
+                guard aktiv, !laeuft else { return }
+                if versatz >= weg * 0.95 {
+                    versatz = weg
+                    ausloesen()
+                } else {
+                    zurueck()
+                }
+            }
+    }
+
+    private func ausloesen() {
+        guard aktiv, !laeuft else { return }
+        laeuft = true
+        Task { @MainActor in
+            let erledigt = await bestaetigt()
+            laeuft = false
+            if !erledigt { zurueck() }
+        }
+    }
+
+    private func zurueck() {
+        if reduceMotion {
+            versatz = 0
+        } else {
+            withAnimation(.spring(response: 0.35, dampingFraction: 0.75)) { versatz = 0 }
+        }
+    }
+}
