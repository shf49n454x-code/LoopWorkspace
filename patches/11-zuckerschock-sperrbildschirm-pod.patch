diff --git a/Loop/Loop/Zuckerschock/ZuckerschockReklamation.swift b/Loop/Loop/Zuckerschock/ZuckerschockReklamation.swift
new file mode 100644
index 0000000..18b383e
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockReklamation.swift
@@ -0,0 +1,344 @@
+//
+//  ZuckerschockReklamation.swift
+//  Loop
+//
+//  Zuckerschock: Pod reklamieren. Fehlerart wählen, Etikett fotografieren (LOT und SN werden auf dem iPhone
+//  gelesen), dann öffnet sich die Mail-App fertig ausgefüllt. Die App sendet nie selbst.
+//  Persönliche Angaben bleiben auf dem iPhone (Datei mit Dateischutz).
+//
+
+import MessageUI
+import SwiftUI
+import UIKit
+import Vision
+
+// MARK: - Angaben
+
+struct ZSReklamationsDaten: Codable, Equatable {
+    var name = ""
+    var kundennummer = ""
+    var anschrift = ""
+    var telefon = ""
+    /// Aus den deutschen Omnipod-Bedienungsanleitungen; änderbar.
+    var empfaenger = "omnipod-DE@insulet.com"
+}
+
+final class ZSReklamationsSpeicher: ObservableObject {
+    static let shared = ZSReklamationsSpeicher()
+
+    @Published var daten: ZSReklamationsDaten { didSet { sichern() } }
+    private let datei: URL
+
+    init(ordner: URL? = nil) {
+        let basis = ordner ?? (FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? FileManager.default.temporaryDirectory)
+        let verzeichnis = basis.appendingPathComponent("Zuckerschock", isDirectory: true)
+        try? FileManager.default.createDirectory(at: verzeichnis, withIntermediateDirectories: true)
+        datei = verzeichnis.appendingPathComponent("reklamation.json")
+        daten = (try? Data(contentsOf: datei)).flatMap { try? JSONDecoder().decode(ZSReklamationsDaten.self, from: $0) } ?? ZSReklamationsDaten()
+    }
+
+    private func sichern() {
+        guard let inhalt = try? JSONEncoder().encode(daten) else { return }
+        try? inhalt.write(to: datei, options: [.atomic, .completeFileProtection])
+    }
+}
+
+enum ZSPodFehler: String, CaseIterable, Identifiable {
+    case alarm = "Pod-Alarm (Dauerton, Pod-Fehler)"
+    case aktivierung = "Aktivierung fehlgeschlagen"
+    case verschluss = "Verschluss (Okklusion)"
+    case kanuele = "Kanüle nicht richtig gesetzt"
+    case pflaster = "Pflaster hält nicht"
+    case sonstiges = "Sonstiges"
+
+    var id: String { rawValue }
+}
+
+// MARK: - Etikett lesen (auf dem Gerät)
+
+enum ZSEtikett {
+    /// Liest LOT und SN aus einem Foto der Pod-Verpackung. Vision läuft auf dem iPhone, nichts wird verschickt.
+    static func lesen(_ bild: UIImage, fertig: @escaping (_ lot: String?, _ sn: String?) -> Void) {
+        guard let cg = bild.cgImage else { fertig(nil, nil); return }
+        let anfrage = VNRecognizeTextRequest { anfrage, _ in
+            let zeilen = (anfrage.results as? [VNRecognizedTextObservation] ?? []).compactMap { $0.topCandidates(1).first?.string }
+            let ergebnis = auswerten(zeilen)
+            DispatchQueue.main.async { fertig(ergebnis.lot, ergebnis.sn) }
+        }
+        anfrage.recognitionLevel = .accurate
+        anfrage.usesLanguageCorrection = false
+        DispatchQueue.global(qos: .userInitiated).async {
+            let handler = VNImageRequestHandler(cgImage: cg, orientation: ausrichtung(bild.imageOrientation), options: [:])
+            do { try handler.perform([anfrage]) } catch { DispatchQueue.main.async { fertig(nil, nil) } }
+        }
+    }
+
+    /// Sucht „LOT …“ und „SN …“ sowie die GS1-Kennungen (10) und (21).
+    static func auswerten(_ zeilen: [String]) -> (lot: String?, sn: String?) {
+        let text = zeilen.joined(separator: " ").uppercased()
+        func finde(_ muster: [String]) -> String? {
+            for m in muster {
+                guard let regex = try? NSRegularExpression(pattern: m) else { continue }
+                let bereich = NSRange(text.startIndex..., in: text)
+                if let treffer = regex.firstMatch(in: text, range: bereich), treffer.numberOfRanges > 1,
+                   let r = Range(treffer.range(at: 1), in: text) {
+                    return String(text[r])
+                }
+            }
+            return nil
+        }
+        let lot = finde([#"\(10\)\s*([A-Z0-9-]{3,20})"#, #"\bLOT\b[\s:#.]*([A-Z0-9-]{3,20})"#])
+        let sn = finde([#"\(21\)\s*([A-Z0-9-]{3,20})"#, #"\b(?:SN|S/N)\b[\s:#.]*([A-Z0-9-]{3,20})"#])
+        return (lot, sn)
+    }
+
+    private static func ausrichtung(_ o: UIImage.Orientation) -> CGImagePropertyOrientation {
+        switch o {
+        case .up: return .up
+        case .down: return .down
+        case .left: return .left
+        case .right: return .right
+        case .upMirrored: return .upMirrored
+        case .downMirrored: return .downMirrored
+        case .leftMirrored: return .leftMirrored
+        case .rightMirrored: return .rightMirrored
+        @unknown default: return .up
+        }
+    }
+}
+
+// MARK: - Mail
+
+struct ZSMailBlatt: UIViewControllerRepresentable {
+    var empfaenger: String
+    var betreff: String
+    var text: String
+    var fertig: () -> Void
+
+    func makeUIViewController(context: Context) -> MFMailComposeViewController {
+        let mail = MFMailComposeViewController()
+        mail.mailComposeDelegate = context.coordinator
+        mail.setToRecipients([empfaenger])
+        mail.setSubject(betreff)
+        mail.setMessageBody(text, isHTML: false)
+        return mail
+    }
+
+    func updateUIViewController(_ uiViewController: MFMailComposeViewController, context: Context) {}
+
+    func makeCoordinator() -> Koordinator { Koordinator(fertig: fertig) }
+
+    final class Koordinator: NSObject, MFMailComposeViewControllerDelegate {
+        let fertig: () -> Void
+        init(fertig: @escaping () -> Void) { self.fertig = fertig }
+
+        func mailComposeController(_ controller: MFMailComposeViewController, didFinishWith result: MFMailComposeResult, error: Error?) {
+            fertig()
+        }
+    }
+}
+
+// MARK: - Blatt
+
+struct ZSReklamationView: View {
+    @ObservedObject var speicher: ZSReklamationsSpeicher
+    /// Wann der Pod aktiviert wurde (letzter erkannter Wechsel), falls bekannt.
+    var podAktiviert: Date?
+    var schliessen: () -> Void
+
+    @State private var fehler: ZSPodFehler = .alarm
+    @State private var zeitpunkt = Date()
+    @State private var bemerkung = ""
+    @State private var lot = ""
+    @State private var sn = ""
+    @State private var kameraOffen = false
+    @State private var liest = false
+    @State private var etikettHinweis: String?
+    @State private var mailOffen = false
+
+    private static func datum(_ d: Date) -> String {
+        d.formatted(.dateTime.day().month(.twoDigits).year().hour().minute().locale(Locale(identifier: "de_DE")))
+    }
+
+    var betreff: String {
+        var teile = ["Pod-Reklamation, Bitte um Ersatz"]
+        if !lot.isEmpty { teile.append("LOT \(lot)") }
+        if !speicher.daten.kundennummer.isEmpty { teile.append("Kundennr. \(speicher.daten.kundennummer)") }
+        return teile.joined(separator: " · ")
+    }
+
+    var mailText: String {
+        let d = speicher.daten
+        var zeilen: [String] = []
+        zeilen.append("Sehr geehrte Damen und Herren,")
+        zeilen.append("")
+        zeilen.append("am \(Self.datum(zeitpunkt)) Uhr ist mein Omnipod-Pod ausgefallen: \(fehler.rawValue).")
+        if !bemerkung.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+            zeilen.append(bemerkung.trimmingCharacters(in: .whitespacesAndNewlines))
+        }
+        zeilen.append("")
+        zeilen.append("Angaben zum Pod:")
+        zeilen.append("- LOT: \(lot.isEmpty ? "–" : lot)")
+        zeilen.append("- SN: \(sn.isEmpty ? "–" : sn)")
+        if let podAktiviert { zeilen.append("- Aktiviert am: \(Self.datum(podAktiviert)) Uhr") }
+        zeilen.append("- Ausfall am: \(Self.datum(zeitpunkt)) Uhr")
+        zeilen.append("")
+        zeilen.append("Ich bitte um kostenlosen Ersatz für diesen Pod. Den Pod bewahre ich auf und schicke ihn auf Wunsch gern zurück.")
+        zeilen.append("")
+        zeilen.append("Meine Angaben:")
+        if !d.name.isEmpty { zeilen.append("Name: \(d.name)") }
+        if !d.kundennummer.isEmpty { zeilen.append("Kundennummer: \(d.kundennummer)") }
+        if !d.anschrift.isEmpty { zeilen.append("Anschrift: \(d.anschrift)") }
+        if !d.telefon.isEmpty { zeilen.append("Telefon: \(d.telefon)") }
+        zeilen.append("")
+        zeilen.append("Mit freundlichen Grüßen")
+        zeilen.append(d.name.isEmpty ? "" : d.name)
+        return zeilen.joined(separator: "\n")
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Pod reklamieren", abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space6) {
+                    Text("Wähle, was passiert ist, und fotografiere das Etikett der Pod-Verpackung. Danach öffnet sich die Mail-App fertig ausgefüllt. Senden tust du selbst.")
+                        .font(ZSSchrift.subhead)
+                        .foregroundStyle(ZSFarbe.text2)
+                        .fixedSize(horizontal: false, vertical: true)
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Was ist passiert?")
+                        ZSEingabeFeld(titel: "Fehler") {
+                            Picker("Fehler", selection: $fehler) {
+                                ForEach(ZSPodFehler.allCases) { Text($0.rawValue).tag($0) }
+                            }
+                            .pickerStyle(.menu)
+                            .tint(ZSFarbe.text)
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                        }
+                        ZSEingabeFeld(titel: "Wann") {
+                            DatePicker("Wann", selection: $zeitpunkt, in: ...Date())
+                                .labelsHidden()
+                                .frame(maxWidth: .infinity, alignment: .leading)
+                        }
+                        ZSEingabeFeld(titel: "Bemerkung (optional)") {
+                            TextField("z. B. Alarm 2 Std. nach dem Setzen", text: $bemerkung, axis: .vertical)
+                                .lineLimit(1...4)
+                        }
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Pod")
+                        Button {
+                            kameraOffen = true
+                        } label: {
+                            Label(liest ? "Etikett wird gelesen …" : "Etikett fotografieren", systemImage: "camera.viewfinder")
+                                .font(ZSSchrift.headline)
+                        }
+                        .buttonStyle(ZSDruckStil(art: .sekundaer))
+                        .disabled(liest)
+                        if let etikettHinweis {
+                            Text(etikettHinweis)
+                                .font(ZSSchrift.footnote)
+                                .foregroundStyle(ZSFarbe.text2)
+                        }
+                        ZSEingabeFeld(titel: "LOT") {
+                            TextField("steht auf der Verpackung", text: $lot)
+                                .textInputAutocapitalization(.characters)
+                                .autocorrectionDisabled()
+                        }
+                        ZSEingabeFeld(titel: "SN (Seriennummer)") {
+                            TextField("steht auf der Verpackung", text: $sn)
+                                .textInputAutocapitalization(.characters)
+                                .autocorrectionDisabled()
+                        }
+                        if let podAktiviert {
+                            Text("Aktiviert am \(Self.datum(podAktiviert)) Uhr (letzter erkannter Pod-Wechsel).")
+                                .font(ZSSchrift.footnote)
+                                .foregroundStyle(ZSFarbe.text3)
+                        }
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Deine Angaben")
+                        Text("Einmal eintragen, die App merkt sie sich. Sie bleiben auf dem iPhone.")
+                            .font(ZSSchrift.footnote)
+                            .foregroundStyle(ZSFarbe.text3)
+                        ZSEingabeFeld(titel: "Name") {
+                            TextField("Vor- und Nachname", text: $speicher.daten.name)
+                                .textContentType(.name)
+                        }
+                        ZSEingabeFeld(titel: "Kundennummer bei Insulet") {
+                            TextField("z. B. von der Lieferung", text: $speicher.daten.kundennummer)
+                                .autocorrectionDisabled()
+                        }
+                        ZSEingabeFeld(titel: "Anschrift für den Ersatz") {
+                            TextField("Straße, PLZ, Ort", text: $speicher.daten.anschrift, axis: .vertical)
+                                .textContentType(.fullStreetAddress)
+                                .lineLimit(1...3)
+                        }
+                        ZSEingabeFeld(titel: "Telefon (optional)") {
+                            TextField("für Rückfragen", text: $speicher.daten.telefon)
+                                .keyboardType(.phonePad)
+                                .textContentType(.telephoneNumber)
+                        }
+                        ZSEingabeFeld(titel: "Empfänger") {
+                            TextField("E-Mail des Kundenservice", text: $speicher.daten.empfaenger)
+                                .keyboardType(.emailAddress)
+                                .textInputAutocapitalization(.never)
+                                .autocorrectionDisabled()
+                        }
+                    }
+
+                    Button(action: mailVorbereiten) {
+                        Text("Mail vorbereiten").font(ZSSchrift.headline)
+                    }
+                    .buttonStyle(ZSDruckStil(art: .primaer))
+
+                    Text("Die App sendet nichts selbst. In der Mail-App kannst du den Text noch ändern, senden oder als Entwurf sichern.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text3)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .sheet(isPresented: $kameraOffen) {
+            ZSKameraBlatt { bild in
+                kameraOffen = false
+                guard let bild else { return }
+                liest = true
+                etikettHinweis = nil
+                ZSEtikett.lesen(bild) { gefundenLot, gefundenSn in
+                    liest = false
+                    if let gefundenLot { lot = gefundenLot }
+                    if let gefundenSn { sn = gefundenSn }
+                    switch (gefundenLot, gefundenSn) {
+                    case (.some, .some): etikettHinweis = "LOT und SN erkannt. Bitte kurz mit der Verpackung vergleichen."
+                    case (nil, nil): etikettHinweis = "Nichts erkannt. Etikett näher und gerade fotografieren oder abtippen."
+                    default: etikettHinweis = "Nur teilweise erkannt. Bitte den Rest abtippen."
+                    }
+                }
+            }
+            .ignoresSafeArea()
+        }
+        .sheet(isPresented: $mailOffen) {
+            ZSMailBlatt(empfaenger: speicher.daten.empfaenger, betreff: betreff, text: mailText) { mailOffen = false }
+                .ignoresSafeArea()
+        }
+    }
+
+    private func mailVorbereiten() {
+        if MFMailComposeViewController.canSendMail() {
+            mailOffen = true
+            return
+        }
+        // Ohne eingerichtete Mail-App: Standard-Mail-Programm über mailto öffnen.
+        var teile = URLComponents()
+        teile.scheme = "mailto"
+        teile.path = speicher.daten.empfaenger
+        teile.queryItems = [URLQueryItem(name: "subject", value: betreff), URLQueryItem(name: "body", value: mailText)]
+        if let url = teile.url { UIApplication.shared.open(url) }
+    }
+}
