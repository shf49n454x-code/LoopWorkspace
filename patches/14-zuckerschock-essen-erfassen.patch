+                    } label: {
+                        Label("Von Claude schätzen lassen", systemImage: "sparkles")
+                            .font(ZSSchrift.headline)
+                    }
+                    .buttonStyle(ZSDruckStil(art: .primaer))
+                    .disabled(!bereit || laedt)
+                    .opacity(bereit && !laedt ? 1 : 0.5)
+
+                    Text("Fotos und Text gehen mit deinem eigenen API-Schlüssel an Claude. In der App wird nichts davon gespeichert.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text3)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                .padding(ZSMass.space5)
+            }
+            .scrollDismissesKeyboard(.interactively)
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .fullScreenCover(isPresented: $kameraOffen) {
+            ZSKameraBlatt { bild in
+                kameraOffen = false
+                if let bild { hinzufuegen([bild]) }
