+        .onChange(of: auswahl) { _, neu in laden(neu) }
+        .onAppear {
+            switch start {
+            case .fotos: auswahlOffen = true
+            case .beschreiben: textFokus = true
+            case .normal: break
+            }
+        }
+    }
+
+    private func vorschau(_ bild: UIImage, index: Int) -> some View {
+        Image(uiImage: bild)
+            .resizable()
+            .scaledToFill()
+            .frame(width: 96, height: 96)
+            .clipShape(RoundedRectangle(cornerRadius: ZSMass.radiusM, style: .continuous))
+            .overlay(alignment: .topTrailing) {
+                Button {
+                    bilder.remove(at: index)
+                } label: {
+                    Image(systemName: "xmark.circle.fill")
+                        .font(.title3)
+                        .symbolRenderingMode(.palette)
+                        .foregroundStyle(ZSFarbe.text, ZSFarbe.grund.opacity(0.7))
+                        .padding(4)
+                }
+                .accessibilityLabel("Foto \(index + 1) entfernen")
+            }
+    }
+
+    private func kachel(titel: String, symbol: String, aktion: @escaping () -> Void) -> some View {
+        Button(action: aktion) {
+            VStack(spacing: ZSMass.space1) {
+                Image(systemName: symbol)
+                    .font(.title3)
+                Text(titel)
+                    .font(ZSSchrift.caption.weight(.semibold))
+            }
+            .foregroundStyle(ZSFarbe.text2)
+            .frame(width: 96, height: 96)
+            .background(RoundedRectangle(cornerRadius: ZSMass.radiusM, style: .continuous).strokeBorder(ZSFarbe.randSteuer, style: StrokeStyle(lineWidth: 1, dash: [4, 4])))
+        }
+        .buttonStyle(.plain)
+    }
+
+    private func hinzufuegen(_ neu: [UIImage]) {
+        bilder.append(contentsOf: neu.prefix(frei).map(ZSFotoKH.verkleinert))
+    }
+
+    private func laden(_ eintraege: [PhotosPickerItem]) {
+        guard !eintraege.isEmpty else { return }
+        laedt = true
+        Task {
+            var neu: [UIImage] = []
+            for eintrag in eintraege {
+                if let daten = try? await eintrag.loadTransferable(type: Data.self), let bild = UIImage(data: daten) {
+                    neu.append(bild)
+                }
+            }
+            await MainActor.run {
+                hinzufuegen(neu)
+                auswahl = []
+                laedt = false
+            }
+        }
+    }
+}
