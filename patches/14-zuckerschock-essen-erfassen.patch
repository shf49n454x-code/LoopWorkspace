+                                if frei > 0 {
+                                    kachel(titel: "Kamera", symbol: "camera") { kameraOffen = true }
+                                    kachel(titel: laedt ? "Lädt …" : "Aus Fotos", symbol: "photo.on.rectangle") { auswahlOffen = true }
+                                        .disabled(laedt)
+                                }
+                            }
+                        }
+                        Text("Tipp: Verpackung mit Nährwerttabelle mitfotografieren. Dann rechnet Claude mit den echten Werten statt zu schätzen.")
+                            .font(ZSSchrift.footnote)
+                            .foregroundStyle(ZSFarbe.text2)
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Beschreibung")
+                        ZSEingabeFeld(titel: "Was isst du, wie viel?") {
+                            TextField("z. B. 2 Scheiben Vollkornbrot, 30 g Gouda, 150 g Joghurt", text: $beschreibung, axis: .vertical)
+                                .lineLimit(2...6)
+                                .focused($textFokus)
