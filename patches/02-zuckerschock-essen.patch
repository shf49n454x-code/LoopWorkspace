+// MARK: - Schätzung
+
+private struct ZSSchaetzungBlatt: View {
+    let bild: UIImage
+    @ObservedObject var speicher: ZSSpeicher
+    var abbrechen: () -> Void
+    var weiter: (ZSAuswahl) -> Void
+
+    @State private var ergebnis: ZSSchaetzung?
+    @State private var fehler: String?
+    @State private var kh: Double = 0
+    @State private var aufgabe: Task<Void, Never>?
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Schätzung") {
+                aufgabe?.cancel()
+                abbrechen()
+            }
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    Image(uiImage: bild)
+                        .resizable()
+                        .scaledToFill()
+                        .frame(height: 180)
+                        .frame(maxWidth: .infinity)
+                        .clipShape(RoundedRectangle(cornerRadius: ZSMass.radiusKarte, style: .continuous))
+                        .accessibilityLabel("Dein Foto")
+
+                    if let ergebnis {
+                        ergebnisAnsicht(ergebnis)
+                    } else if let fehler {
+                        VStack(alignment: .leading, spacing: ZSMass.space3) {
+                            Text(fehler)
+                                .font(ZSSchrift.body)
+                                .foregroundStyle(ZSFarbe.text)
+                            Text("Du kannst die KH auch ohne Foto eintragen.")
+                                .font(ZSSchrift.subhead)
+                                .foregroundStyle(ZSFarbe.text2)
+                        }
+                        .zsKarte()
+                    } else {
+                        HStack(spacing: ZSMass.space4) {
+                            ZSBlitzLaden()
+                            VStack(alignment: .leading, spacing: 2) {
+                                Text("Claude erkennt dein Essen")
+                                    .font(ZSSchrift.headline)
+                                    .foregroundStyle(ZSFarbe.text)
+                                Text("Das dauert ein paar Sekunden.")
+                                    .font(ZSSchrift.subhead)
+                                    .foregroundStyle(ZSFarbe.text2)
+                            }
+                        }
+                        .zsKarte()
+                        .accessibilityElement(children: .combine)
+                    }
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .onAppear(perform: starten)
+        .onDisappear { aufgabe?.cancel() }
+    }
+
+    private func starten() {
+        guard aufgabe == nil else { return }
+        guard let schluessel = ZSSchluessel.wert else {
+            fehler = ZSFotoKHFehler.keinSchluessel.errorDescription
+            return
+        }
+        aufgabe = Task {
+            do {
+                let neu = try await ZSFotoKH.schaetzen(bild, schluessel: schluessel)
+                guard !Task.isCancelled else { return }
+                await MainActor.run {
+                    ergebnis = neu
+                    kh = neu.khGramm.rounded()
+                }
+            } catch is CancellationError {
+            } catch let fehlerWert as URLError where fehlerWert.code == .cancelled {
+            } catch {
+                await MainActor.run { fehler = error.localizedDescription }
+            }
+        }
+    }
+
+    @ViewBuilder
+    private func ergebnisAnsicht(_ e: ZSSchaetzung) -> some View {
+        VStack(alignment: .leading, spacing: ZSMass.space2) {
+            Text(e.gericht)
+                .font(ZSSchrift.title2)
+                .foregroundStyle(ZSFarbe.text)
+            Text("Spanne \(ZSFormat.zahl(e.khMin, stellen: 0)) bis \(ZSFormat.zahl(e.khMax, stellen: 0)) g, Sicherheit \(e.sicherheit)")
+                .font(ZSSchrift.subhead)
+                .foregroundStyle(ZSFarbe.text2)
+            if !e.hinweis.isEmpty {
+                Text(e.hinweis)
+                    .font(ZSSchrift.footnote)
+                    .foregroundStyle(ZSFarbe.text2)
+            }
+        }
+
+        ZSMengenWaehler(wert: $kh, einheit: "g KH", schritt: 2)
+            .padding(.vertical, ZSMass.space2)
+
+        HStack {
+            Text("Fett und Eiweiß")
+                .font(ZSSchrift.subhead)
+                .foregroundStyle(ZSFarbe.text2)
+            Spacer()
+            Text("\(ZSFormat.zahl(e.fpe, stellen: 1)) FPE")
+                .zsZahl(.wertKlein)
+                .foregroundStyle(ZSFarbe.text)
+        }
+        .zsKarte()
+
+        if let erfahrung = speicher.erfahrung(fuer: e.gericht) {
+            VStack(alignment: .leading, spacing: ZSMass.space1) {
+                Text("Deine Erfahrung")
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                Text("\(erfahrung.anzahl)× gegessen, meist \(ZSFormat.zahl(erfahrung.meistKH, stellen: 0)) g\(erfahrung.mehr > erfahrung.weniger ? ", oft waren es mehr" : (erfahrung.weniger > erfahrung.mehr ? ", oft waren es weniger" : ""))")
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSFarbe.text2)
+            }
+            .zsKarte()
+        }
+
+        Button {
+            weiter(ZSAuswahl(name: e.gericht, kh: kh, fpe: e.fpe, quelle: .foto, schaetzungKH: e.khGramm))
+        } label: {
+            Text("Weiter zum Bolus")
+                .font(ZSSchrift.headline)
+        }
+        .buttonStyle(ZSDruckStil(art: .primaer))
+
+        Text("Schätzung, kein Messwert. Du prüfst die Menge, Loop rechnet.")
+            .font(ZSSchrift.footnote)
+            .foregroundStyle(ZSFarbe.text2)
+    }
+}
