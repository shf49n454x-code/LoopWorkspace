+                        Text("\(ZSFormat.uhrzeit(mahlzeit.datum)) · \(ZSFormat.zahl(mahlzeit.kh, stellen: 0)) g KH\(mahlzeit.fpe.map { " · \(ZSFormat.zahl($0, stellen: 1)) FPE" } ?? "")")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                    }
+
+                    VStack(alignment: .leading, spacing: ZSMass.space2) {
+                        ZSRueckblickKurve(punkte: punkte, mahlzeit: mahlzeit.datum, spitze: spitze)
+                            .frame(height: 160)
+                        if let spitze, let start {
+                            let anstieg = spitze.mgdl - start.mgdl
+                            Text("Spitze \(ZSFormat.glukose(spitze.mgdl, quelle.einheit)) \(ZSFormat.einheit(quelle.einheit)) nach \(Int(spitze.datum.timeIntervalSince(mahlzeit.datum) / 60)) Min, \(ZSFormat.aenderung(anstieg, quelle.einheit)) seit dem Essen")
+                                .font(ZSSchrift.subhead)
+                                .foregroundStyle(ZSFarbe.text2)
+                        } else {
+                            Text("Für diese Zeit gibt es keine Werte.")
+                                .font(ZSSchrift.subhead)
+                                .foregroundStyle(ZSFarbe.text2)
+                        }
+                    }
+                    .zsKarte()
+
+                    Text("Stimmten die KH?")
+                        .font(ZSSchrift.headline)
+                        .foregroundStyle(ZSFarbe.text)
+                    HStack(spacing: ZSMass.space3) {
+                        antwort("Waren mehr", .mehr)
+                        antwort("Passte", .passte)
+                        antwort("Waren weniger", .weniger)
+                    }
+                    Text("Deine Antwort hilft der nächsten Schätzung. Sie ändert nichts an Loop.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .onAppear {
+            quelle.glukose(von: mahlzeit.datum.addingTimeInterval(-.minutes(30)), bis: mahlzeit.datum.addingTimeInterval(.hours(4))) { punkte = $0 }
+        }
+    }
+
+    private func antwort(_ titel: String, _ wert: ZSRueckmeldung) -> some View {
+        Button(titel) { antworten(wert) }
+            .font(ZSSchrift.subhead.weight(.semibold))
+            .buttonStyle(ZSRandStil())
+    }
+}
+
+/// Sekundärbutton mit Rand rand-steuer.
+struct ZSRandStil: ButtonStyle {
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .foregroundStyle(ZSFarbe.text)
+            .multilineTextAlignment(.center)
+            .padding(.horizontal, ZSMass.space2)
+            .frame(maxWidth: .infinity, minHeight: ZSMass.tap)
+            .background(Capsule().strokeBorder(ZSFarbe.randSteuer, lineWidth: 1))
+            .background(Capsule().fill(configuration.isPressed ? ZSFarbe.flaeche2 : Color.clear))
+    }
+}
+
+private struct ZSRueckblickKurve: View {
+    var punkte: [ZSMesspunkt]
+    var mahlzeit: Date
+    var spitze: ZSMesspunkt?
+
+    var body: some View {
+        GeometryReader { geo in
+            let r = CGRect(origin: .zero, size: geo.size)
+            let anfang = punkte.first?.datum ?? mahlzeit
+            let ende = punkte.last?.datum ?? mahlzeit.addingTimeInterval(.hours(4))
+            let werte = punkte.map(\.mgdl)
+            let unten = min(60, (werte.min() ?? 60) - 10)
+            let oben = max(200, (werte.max() ?? 200) + 10)
+            let x: (Date) -> CGFloat = { d in
+                let gesamt = max(1, ende.timeIntervalSince(anfang))
+                return CGFloat(d.timeIntervalSince(anfang) / gesamt) * r.width
+            }
+            let y: (Double) -> CGFloat = { v in r.maxY - CGFloat((v - unten) / (oben - unten)) * r.height }
+
+            ZStack(alignment: .topLeading) {
+                Rectangle()
+                    .fill(ZSFarbe.text.opacity(0.05))
+                    .frame(width: r.width, height: max(0, y(70) - y(180)))
+                    .offset(y: y(180))
+                Rectangle()
+                    .fill(ZSFarbe.text3)
+                    .frame(width: 1, height: r.height)
+                    .offset(x: x(mahlzeit))
+                Path { p in
+                    guard let erster = punkte.first else { return }
+                    p.move(to: CGPoint(x: x(erster.datum), y: y(erster.mgdl)))
+                    for punkt in punkte.dropFirst() {
+                        p.addLine(to: CGPoint(x: x(punkt.datum), y: y(punkt.mgdl)))
+                    }
+                }
+                .stroke(ZSFarbe.orangeLinie, style: StrokeStyle(lineWidth: 2.5, lineCap: .round, lineJoin: .round))
+                // Schock-Spitze: im Rückblick markiert der Blitz die höchste Spitze.
+                if let spitze {
+                    ZSBlitzForm()
+                        .fill(ZSFarbe.orange)
+                        .frame(width: 12, height: 20)
+                        .position(x: x(spitze.datum), y: max(10, y(spitze.mgdl) - 14))
+                        .accessibilityHidden(true)
+                }
+            }
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Zuckerkurve rund um die Mahlzeit")
+    }
+}
