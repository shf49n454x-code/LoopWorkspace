+/// FPE, die nach der Mahlzeit noch als verzögerte KH in Loop eingetragen werden können.
+struct ZSOffeneFPE: Equatable {
+    var name: String
+    var fpe: Double
+    var gramm: Double
+    var wirkdauer: TimeInterval
+}
