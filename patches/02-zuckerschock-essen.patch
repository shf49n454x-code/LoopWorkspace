+//
+//  ZuckerschockEssenView.swift
+//  Loop
+//
+//  Zuckerschock: der Essen-Tab. Schätzt, rechnet KH und FPE aus Rezepten,
+//  übergibt die KH an Loops bestehende KH-Eingabe. Keine Dosis.
+//
+
+import HealthKit
+import LoopCore
+import SwiftUI
+import UIKit
+
+/// Steuert den Essen-Tab von außen (z. B. „Essen“ auf Heute öffnet die Kamera).
+final class ZSEssenSteuerung: ObservableObject {
+    enum Anfrage: Equatable { case kamera, manuell }
+    @Published var anfrage: Anfrage?
+}
+
+enum ZSEssenBlatt: Identifiable {
+    case kamera
+    case schaetzung(UIImage)
+    case manuell
+    case standard(ZSStandardmahlzeit)
+    case standardNeu
+    case rezept(ZSRezept)
+    case rezeptBearbeiten(ZSRezept)
+    case rueckblick(ZSMahlzeit)
+    case einstellungen
+
+    var id: String {
+        switch self {
+        case .kamera: return "kamera"
+        case .schaetzung: return "schaetzung"
+        case .manuell: return "manuell"
+        case .standard(let s): return "standard-\(s.id)"
+        case .standardNeu: return "standardNeu"
+        case .rezept(let r): return "rezept-\(r.id)"
+        case .rezeptBearbeiten(let r): return "rezeptBearbeiten-\(r.id)"
+        case .rueckblick(let m): return "rueckblick-\(m.id)"
+        case .einstellungen: return "einstellungen"
+        }
+    }
+}
