+/// Der Blitz aus der Bildmarke (ohne Tropfen).
+struct ZSBlitzForm: Shape {
+    func path(in rect: CGRect) -> Path {
+        // Umriss aus blitz-24 (Bildmarken-Blitz), Bezugsrahmen 418,378 bis 606,706
+        let punkte: [(CGFloat, CGFloat)] = [
+            (556.2, 400.8), (552.9, 386.2), (543.9, 379.4), (532.5, 378.8), (522.8, 384.6),
+            (421.4, 555.7), (419, 562.6), (420.5, 573.5), (427.6, 581.7), (438.1, 584.8),
+            (480.5, 584.8), (462.7, 683), (464.1, 694.4), (471.7, 703), (482.7, 705.8),
+            (493.4, 701.9), (498.5, 696.1), (602.7, 514.7), (605, 507.8), (603.5, 497),
+            (596.4, 488.8), (585.9, 485.7), (541.6, 485.7)
+        ]
+        let quelle = CGRect(x: 418.8, y: 378.2, width: 186.4, height: 327.6)
+        let massstab = min(rect.width / quelle.width, rect.height / quelle.height)
+        let dx = rect.midX - quelle.midX * massstab
+        let dy = rect.midY - quelle.midY * massstab
+        var p = Path()
+        p.move(to: CGPoint(x: punkte[0].0 * massstab + dx, y: punkte[0].1 * massstab + dy))
+        for punkt in punkte.dropFirst() {
+            p.addLine(to: CGPoint(x: punkt.0 * massstab + dx, y: punkt.1 * massstab + dy))
+        }
+        p.closeSubpath()
+        return p
+    }
+}
