+// MARK: - Rezept (Topfgewicht-Methode)
+
+private struct ZSRezeptBlatt: View {
+    @State var rezept: ZSRezept
+    @ObservedObject var speicher: ZSSpeicher
+    var abbrechen: () -> Void
+    var bearbeiten: () -> Void
+    var weiter: (ZSAuswahl) -> Void
+
+    @State private var teller: Double = 350
+    @State private var fertig: Double?
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Rezept", abbrechen: abbrechen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    HStack(alignment: .firstTextBaseline) {
+                        VStack(alignment: .leading, spacing: 2) {
+                            Text(rezept.name)
+                                .font(ZSSchrift.title2)
+                                .foregroundStyle(ZSFarbe.text)
+                            Text("Rezeptkartei, für \(rezept.portionen) Personen")
+                                .font(ZSSchrift.subhead)
+                                .foregroundStyle(ZSFarbe.text2)
+                        }
+                        Spacer()
+                        Button("Bearbeiten", action: bearbeiten)
+                            .foregroundStyle(ZSFarbe.orangeText)
+                    }
+
+                    zeile("Aus den Zutaten, ganzer Topf", "\(ZSFormat.zahl(rezept.khGesamt, stellen: 0)) g KH, \(ZSFormat.zahl(rezept.fpeGesamt, stellen: 1)) FPE")
+                        .zsKarte()
+
+                    ZSEingabeFeld(titel: "Fertig gewogen ohne Topf oder Form (g)") {
+                        TextField("Gewicht", value: $fertig, format: .number)
+                            .keyboardType(.numberPad)
+                    }
+
+                    if let je100 = gewogen.khJe100, let fpe100 = gewogen.fpeJe100 {
+                        zeile("Je 100 g", "\(ZSFormat.zahl(je100, stellen: 1)) g KH, \(ZSFormat.zahl(fpe100, stellen: 1)) FPE")
+                            .zsKarte()
+
+                        VStack(alignment: .leading, spacing: ZSMass.space2) {
+                            Text("Dein Teller")
+                                .font(ZSSchrift.headline)
+                                .foregroundStyle(ZSFarbe.text)
+                            ZSMengenWaehler(wert: $teller, einheit: "g", schritt: 10, bereich: 0...3000)
+                        }
+
+                        let kh = je100 * teller / 100
+                        let fpe = fpe100 * teller / 100
+                        HStack(spacing: ZSMass.space3) {
+                            kachel("\(ZSFormat.zahl(kh, stellen: 0)) g", "Kohlenhydrate")
+                            kachel("\(ZSFormat.zahl(fpe, stellen: 1)) FPE", "Fett und Eiweiß")
+                        }
+
+                        Button {
+                            sichernGewicht()
+                            weiter(ZSAuswahl(name: rezept.name, kh: kh, fpe: fpe, quelle: .rezept, schaetzungKH: nil))
+                        } label: {
+                            Text("Weiter zum Bolus").font(ZSSchrift.headline)
+                        }
+                        .buttonStyle(ZSDruckStil(art: .primaer))
+                    }
+
+                    Text("Den Topf wiegst du einmal pro Kochen, danach nur noch den Teller.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .onAppear { fertig = rezept.fertigGramm }
+    }
+
+    private var gewogen: ZSRezept {
+        var kopie = rezept
+        kopie.fertigGramm = fertig
+        return kopie
+    }
+
+    private func sichernGewicht() {
+        guard fertig != rezept.fertigGramm, let index = speicher.rezepte.firstIndex(where: { $0.id == rezept.id }) else { return }
+        speicher.rezepte[index].fertigGramm = fertig
+        speicher.rezepte[index].zuletztGewogen = Date()
+    }
+
+    private func zeile(_ titel: String, _ wert: String) -> some View {
+        VStack(alignment: .leading, spacing: 2) {
+            Text(titel)
+                .font(ZSSchrift.subhead)
+                .foregroundStyle(ZSFarbe.text2)
+            Text(wert)
+                .zsZahl(.wertKlein)
+                .foregroundStyle(ZSFarbe.text)
+        }
+        .accessibilityElement(children: .combine)
+    }
+
+    private func kachel(_ wert: String, _ label: String) -> some View {
+        VStack(alignment: .leading, spacing: 2) {
+            Text(wert)
+                .zsZahl(.wert)
+                .foregroundStyle(ZSFarbe.text)
+            Text(label)
+                .font(ZSSchrift.footnote)
+                .foregroundStyle(ZSFarbe.text2)
+        }
+        .zsKarte()
+        .accessibilityElement(children: .combine)
+    }
+}
