new file mode 100644
index 0000000..ba27004
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockEssenDaten.swift
@@ -0,0 +1,352 @@
+//
+//  ZuckerschockEssenDaten.swift
+//  Loop
+//
+//  Zuckerschock: Mahlzeiten, Rezeptkartei, Standardmahlzeiten, Therapieplan.
+//  Alles bleibt lokal auf dem iPhone. Keine Insulindosis wird berechnet:
+//  KH gehen an Loops bestehende KH-Eingabe, Loop rechnet wie bisher.
+//
+
+import Combine
+import Foundation
+import HealthKit
+import LoopCore
+import LoopKit
+import Security
+
+// MARK: - Fett-Protein-Einheiten (Warschauer Methode)
+
+enum ZSFPE {
+    /// 1 FPE = 100 kcal aus Fett und Eiweiß (Fett 9 kcal/g, Eiweiß 4 kcal/g).
+    static func einheiten(fettGramm: Double, eiweissGramm: Double) -> Double {
+        max(0, (fettGramm * 9 + eiweissGramm * 4) / 100)
+    }
+
+    /// Wirkdauer nach dem Warschauer Schema: 1 FPE 3 Std., 2 FPE 4 Std., 3 FPE 5 Std., ab 4 FPE 8 Std.
+    static func wirkdauer(fpe: Double) -> TimeInterval {
+        switch fpe {
+        case ..<1.5: return .hours(3)
+        case ..<2.5: return .hours(4)
+        case ..<3.5: return .hours(5)
+        default: return .hours(8)
+        }
+    }
+}
+
+// MARK: - Therapieplan (vom Diabetes-Team, Jon trägt ein)
+
+struct ZSTherapieplan: Codable, Equatable {
+    /// Gramm KH-Äquivalent je FPE, wie vom Diabetes-Team festgelegt. Ohne Wert keine FPE-Übergabe.
+    var khJeFPE: Double?
+    /// Schnelle KH bei Unterzucker: Gramm je Plättchen und Anzahl laut Plan.
+    var hypoGrammJePlaettchen: Double?
+    var hypoPlaettchen: Int?
+    /// Wartezeit nach dem Essen bei Unterzucker, laut Plan.
+    var hypoWarteMinuten: Int?
+    /// Spritz-Ess-Abstand laut Plan.
+    var spritzEssAbstandMinuten: Int?
+
+    static let leer = ZSTherapieplan()
+}
+
+// MARK: - Mahlzeiten
+
+enum ZSMahlzeitQuelle: String, Codable {
+    case foto, rezept, standard, manuell
+}
+
+enum ZSRueckmeldung: String, Codable {
+    case mehr, passte, weniger
+}
+
+struct ZSMahlzeit: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var name: String
+    var datum: Date
+    var kh: Double
+    var fpe: Double?
+    var quelle: ZSMahlzeitQuelle
+    /// Von der Foto-Schätzung (für den Rückblick, nie für eine Dosis).
+    var schaetzungKH: Double?
+    var rueckmeldung: ZSRueckmeldung?
+}
+
+struct ZSStandardmahlzeit: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var name: String
+    var kh: Double
+    var fpe: Double?
+}
+
+// MARK: - Rezeptkartei (Topfgewicht-Methode)
+
+struct ZSZutat: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var name: String
+    var gramm: Double
+    /// Nährwerte je 100 g laut Packung.
+    var khJe100: Double
+    var fettJe100: Double
+    var eiweissJe100: Double
+
+    var kh: Double { gramm * khJe100 / 100 }
+    var fett: Double { gramm * fettJe100 / 100 }
+    var eiweiss: Double { gramm * eiweissJe100 / 100 }
+}
+
+struct ZSRezept: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var name: String
+    var portionen: Int = 4
+    var zutaten: [ZSZutat] = []
+    /// Fertig gekochtes Gewicht ohne Topf oder Form.
+    var fertigGramm: Double?
+    var zuletztGewogen: Date?
+
+    var khGesamt: Double { zutaten.reduce(0) { $0 + $1.kh } }
+    var fpeGesamt: Double { ZSFPE.einheiten(fettGramm: zutaten.reduce(0) { $0 + $1.fett }, eiweissGramm: zutaten.reduce(0) { $0 + $1.eiweiss }) }
+
+    /// KH je 100 g fertigem Essen, nur wenn gewogen.
+    var khJe100: Double? {
+        guard let fertigGramm, fertigGramm > 0 else { return nil }
+        return khGesamt / fertigGramm * 100
+    }
+
+    var fpeJe100: Double? {
+        guard let fertigGramm, fertigGramm > 0 else { return nil }
+        return fpeGesamt / fertigGramm * 100
+    }
+}
+
+// MARK: - Speicher
+
+/// Einfacher JSON-Speicher in Application Support.
+final class ZSSpeicher: ObservableObject {
+    static let shared = ZSSpeicher()
+
+    @Published var mahlzeiten: [ZSMahlzeit] = [] { didSet { sichern(mahlzeiten, "mahlzeiten") } }
+    @Published var rezepte: [ZSRezept] = [] { didSet { sichern(rezepte, "rezepte") } }
+    @Published var standard: [ZSStandardmahlzeit] = [] { didSet { sichern(standard, "standard") } }
+    @Published var plan: ZSTherapieplan = .leer { didSet { sichern(plan, "therapieplan") } }
+
+    private let ordner: URL
+    private var laedt = false
+
+    init(ordner: URL? = nil) {
+        let basis = ordner ?? (FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? FileManager.default.temporaryDirectory)
+        self.ordner = basis.appendingPathComponent("Zuckerschock", isDirectory: true)
+        try? FileManager.default.createDirectory(at: self.ordner, withIntermediateDirectories: true)
+        laedt = true
+        mahlzeiten = laden("mahlzeiten") ?? []
+        rezepte = laden("rezepte") ?? []
+        standard = laden("standard") ?? []
+        plan = laden("therapieplan") ?? .leer
+        laedt = false
+    }
+
+    func laden<T: Decodable>(_ name: String) -> T? {
+        let url = ordner.appendingPathComponent("\(name).json")
+        guard let daten = try? Data(contentsOf: url) else { return nil }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        return try? decoder.decode(T.self, from: daten)
+    }
+
+    func sichern<T: Encodable>(_ wert: T, _ name: String) {
+        guard !laedt else { return }
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        guard let daten = try? encoder.encode(wert) else { return }
+        try? daten.write(to: ordner.appendingPathComponent("\(name).json"), options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    }
+
+    // MARK: Erfahrung
+
+    struct Erfahrung {
+        var anzahl: Int
+        var meistKH: Double
+        var mehr: Int
+        var weniger: Int
+    }
+
+    /// Wie oft gab es das schon, und mit wie viel KH (Median)?
+    func erfahrung(fuer name: String) -> Erfahrung? {
+        let gleiche = mahlzeiten.filter { $0.name.compare(name, options: [.caseInsensitive, .diacriticInsensitive]) == .orderedSame }
+        guard !gleiche.isEmpty else { return nil }
+        let sortiert = gleiche.map(\.kh).sorted()
+        let median = sortiert[sortiert.count / 2]
+        return Erfahrung(anzahl: gleiche.count,
+                         meistKH: median,
+                         mehr: gleiche.filter { $0.rueckmeldung == .mehr }.count,
+                         weniger: gleiche.filter { $0.rueckmeldung == .weniger }.count)
+    }
+
+    /// Mahlzeiten, die mindestens 3 Stunden her sind und noch keine Rückmeldung haben (letzte 3 Tage).
+    func offeneRueckblicke(jetzt: Date = Date()) -> [ZSMahlzeit] {
+        mahlzeiten
+            .filter { $0.rueckmeldung == nil && jetzt.timeIntervalSince($0.datum) >= .hours(3) && jetzt.timeIntervalSince($0.datum) <= .days(3) }
+            .sorted { $0.datum > $1.datum }
+    }
+}
+
+// MARK: - Schlüsselbund (eigener API-Schlüssel)
+
+enum ZSSchluessel {
+    private static let dienst = "Zuckerschock.FotoKH"
+    private static let konto = "anthropic-api-key"
+
+    static var wert: String? {
+        let abfrage: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: dienst,
+            kSecAttrAccount as String: konto,
+            kSecReturnData as String: true,
+            kSecMatchLimit as String: kSecMatchLimitOne
+        ]
+        var ergebnis: AnyObject?
+        guard SecItemCopyMatching(abfrage as CFDictionary, &ergebnis) == errSecSuccess,
+              let daten = ergebnis as? Data,
+              let text = String(data: daten, encoding: .utf8), !text.isEmpty else {
+            return nil
+        }
+        return text
+    }
+
+    static func setzen(_ neu: String?) {
+        let basis: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: dienst,
+            kSecAttrAccount as String: konto
+        ]
+        SecItemDelete(basis as CFDictionary)
+        guard let neu = neu?.trimmingCharacters(in: .whitespacesAndNewlines), !neu.isEmpty else { return }
+        var eintrag = basis
+        eintrag[kSecValueData as String] = Data(neu.utf8)
+        // Nur lesbar, solange das iPhone entsperrt ist; nie in iCloud oder auf andere Geräte.
+        eintrag[kSecAttrAccessible as String] = kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+        SecItemAdd(eintrag as CFDictionary, nil)
+    }
+}
+
+// MARK: - Übergabe an Loop
+
+/// Was an Loops KH-Eingabe übergeben wird. Loop zeigt es an, der Nutzer prüft und speichert dort.
+struct ZSKHUebergabe {
+    var name: String
+    var gramm: Double
+    var wirkdauer: TimeInterval?
+    var datum = Date()
+
+    var aktivitaet: NSUserActivity {
+        let aktivitaet = NSUserActivity.forNewCarbEntry()
+        let eintrag = NewCarbEntry(
+            date: datum,
+            // Nie mehr als Loops eigene Obergrenze vorschlagen; Loop prüft und bestätigt danach selbst.
+            quantity: HKQuantity(unit: .gram(), doubleValue: min(max(0, gramm), LoopConstants.maxCarbEntryQuantity.doubleValue(for: .gram())).rounded()),
+            startDate: datum,
+            foodType: name,
+            absorptionTime: wirkdauer)
+        aktivitaet.update(from: eintrag)
+        return aktivitaet
+    }
+}
+
+// MARK: - Quelle für KH heute und Rückblick (nur lesend)
+
+protocol ZSEssenQuelle: AnyObject {
+    var einheit: HKUnit { get }
+    /// Summe der heute in Loop eingetragenen KH.
+    func khHeute(_ fertig: @escaping (Double?) -> Void)
+    func glukose(von: Date, bis: Date, _ fertig: @escaping ([ZSMesspunkt]) -> Void)
+}
+
+final class ZSLoopEssenQuelle: ZSEssenQuelle {
+    private let deviceManager: DeviceDataManager
+
+    init(deviceManager: DeviceDataManager) {
+        self.deviceManager = deviceManager
+    }
+
+    var einheit: HKUnit { deviceManager.displayGlucosePreference.unit }
+
+    func khHeute(_ fertig: @escaping (Double?) -> Void) {
+        let start = Calendar.current.startOfDay(for: Date())
+        deviceManager.carbStore.getCarbEntries(start: start, end: nil) { ergebnis in
+            let summe: Double?
+            switch ergebnis {
+            case .success(let eintraege):
+                summe = eintraege.reduce(0) { $0 + $1.quantity.doubleValue(for: .gram()) }
+            case .failure:
+                summe = nil
+            }
+            DispatchQueue.main.async { fertig(summe) }
+        }
+    }
+
+    func glukose(von: Date, bis: Date, _ fertig: @escaping ([ZSMesspunkt]) -> Void) {
+        deviceManager.glucoseStore.getGlucoseSamples(start: von, end: bis) { ergebnis in
+            var punkte: [ZSMesspunkt] = []
+            if case .success(let werte) = ergebnis {
+                punkte = werte
+                    .map { ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: .milligramsPerDeciliter)) }
+                    .sorted { $0.datum < $1.datum }
+            }
+            DispatchQueue.main.async { fertig(punkte) }
+        }
+    }
+}
+
+#if targetEnvironment(simulator)
+final class ZSVorschauEssenQuelle: ZSEssenQuelle {
+    var einheit: HKUnit { .milligramsPerDeciliter }
+
+    func khHeute(_ fertig: @escaping (Double?) -> Void) {
+        fertig(117)
+    }
+
+    func glukose(von: Date, bis: Date, _ fertig: @escaping ([ZSMesspunkt]) -> Void) {
+        let schritte = Int(bis.timeIntervalSince(von) / .minutes(5))
+        let punkte = (0...max(0, schritte)).map { i -> ZSMesspunkt in
+            let t = Double(i) / Double(max(1, schritte))
+            let spitze = 64 * exp(-pow((t - 0.3) / 0.15, 2))
+            return ZSMesspunkt(datum: von.addingTimeInterval(.minutes(Double(i) * 5)), mgdl: 104 + spitze + 8 * t)
+        }
+        fertig(punkte)
+    }
+}
+
