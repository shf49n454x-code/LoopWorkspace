diff --git a/Loop/Loop/Zuckerschock/ZuckerschockFotoKH.swift b/Loop/Loop/Zuckerschock/ZuckerschockFotoKH.swift
new file mode 100644
index 0000000..74d8916
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockFotoKH.swift
@@ -0,0 +1,160 @@
+//
+//  ZuckerschockFotoKH.swift
+//  Loop
+//
+//  Zuckerschock: KH-Schätzung aus einem Foto mit dem eigenen Claude-API-Schlüssel des Nutzers.
+//  Das Ergebnis ist eine Schätzung, kein Messwert. Der Nutzer prüft die Menge, Loop rechnet.
+//
+
+import Foundation
+import UIKit
+
+struct ZSSchaetzung: Codable, Equatable {
+    var gericht: String
+    var khGramm: Double
+    var khMin: Double
+    var khMax: Double
+    var fettGramm: Double
+    var eiweissGramm: Double
+    var sicherheit: String
+    var hinweis: String
+
+    enum CodingKeys: String, CodingKey {
+        case gericht
+        case khGramm = "kh_gramm"
+        case khMin = "kh_min"
+        case khMax = "kh_max"
+        case fettGramm = "fett_gramm"
+        case eiweissGramm = "eiweiss_gramm"
+        case sicherheit
+        case hinweis
+    }
+
+    var fpe: Double { ZSFPE.einheiten(fettGramm: fettGramm, eiweissGramm: eiweissGramm) }
+}
+
+enum ZSFotoKHFehler: LocalizedError {
+    case keinSchluessel
+    case bild
+    case abgelehnt
+    case antwort(String)
+    case http(Int, String)
+
+    var errorDescription: String? {
+        switch self {
+        case .keinSchluessel: return "Kein API-Schlüssel hinterlegt. Trag die KH von Hand ein."
+        case .bild: return "Das Foto ließ sich nicht verarbeiten."
+        case .abgelehnt: return "Für dieses Foto gibt es keine Schätzung. Trag die KH von Hand ein."
+        case .antwort(let text): return "Die Antwort war nicht lesbar. \(text)"
+        case .http(let code, let text):
+            switch code {
+            case 401: return "Der API-Schlüssel wurde nicht angenommen."
+            case 429: return "Zu viele Anfragen. Versuch es gleich noch einmal."
+            default: return "Fehler \(code). \(text)"
+            }
+        }
+    }
+}
+
+enum ZSFotoKH {
+    static let endpunkt = URL(string: "https://api.anthropic.com/v1/messages")!
+    static let modell = "claude-opus-5-5"
+
+    private static let anweisung = """
+    Du schätzt Kohlenhydrate für einen Menschen mit Typ-1-Diabetes. Auf dem Foto ist eine Mahlzeit.
+    Schätze für die gesamte sichtbare Portion: Kohlenhydrate in Gramm (beste Schätzung und eine realistische Spanne), \
+    Fett und Eiweiß in Gramm. Nenne das Gericht kurz auf Deutsch.
+    Sicherheit: "hoch", wenn Gericht und Portion klar sind, "mittel" bei Unsicherheit über Portion oder Zutaten, \
+    "niedrig", wenn kaum etwas erkennbar ist. Im Hinweis ein kurzer Satz, was die Schätzung unsicher macht.
+    Nenne nie eine Insulinmenge und gib keinen Rat zur Dosis.
+    """
+
+    private static let schema: [String: Any] = [
+        "type": "object",
+        "properties": [
+            "gericht": ["type": "string"],
+            "kh_gramm": ["type": "number"],
+            "kh_min": ["type": "number"],
+            "kh_max": ["type": "number"],
+            "fett_gramm": ["type": "number"],
+            "eiweiss_gramm": ["type": "number"],
+            "sicherheit": ["type": "string", "enum": ["niedrig", "mittel", "hoch"]],
+            "hinweis": ["type": "string"]
+        ],
+        "required": ["gericht", "kh_gramm", "kh_min", "kh_max", "fett_gramm", "eiweiss_gramm", "sicherheit", "hinweis"],
+        "additionalProperties": false
+    ]
+
+    /// Verkleinert auf höchstens 1568 px an der langen Kante und kodiert als JPEG.
+    static func jpeg(_ bild: UIImage) -> Data? {
+        let lang = max(bild.size.width, bild.size.height)
+        let faktor = min(1, 1568 / max(lang, 1))
+        let ziel = CGSize(width: (bild.size.width * faktor).rounded(), height: (bild.size.height * faktor).rounded())
+        let format = UIGraphicsImageRendererFormat.default()
+        format.scale = 1
+        let klein = UIGraphicsImageRenderer(size: ziel, format: format).image { _ in
+            bild.draw(in: CGRect(origin: .zero, size: ziel))
+        }
+        return klein.jpegData(compressionQuality: 0.75)
+    }
+
+    static func schaetzen(_ bild: UIImage, schluessel: String) async throws -> ZSSchaetzung {
+        guard let daten = jpeg(bild) else { throw ZSFotoKHFehler.bild }
+
+        let koerper: [String: Any] = [
+            "model": modell,
+            "max_tokens": 4000,
+            // Bei einer Ablehnung übernimmt serverseitig ein passendes Ausweichmodell.
+            "fallbacks": "default",
+            "output_config": [
+                "effort": "medium",
+                "format": ["type": "json_schema", "schema": schema]
+            ],
+            "system": anweisung,
+            "messages": [[
+                "role": "user",
+                "content": [
+                    ["type": "image", "source": ["type": "base64", "media_type": "image/jpeg", "data": daten.base64EncodedString()]],
+                    ["type": "text", "text": "Wie viele Kohlenhydrate hat diese Mahlzeit?"]
+                ]
+            ]]
+        ]
+
+        var anfrage = URLRequest(url: endpunkt, timeoutInterval: 90)
+        anfrage.httpMethod = "POST"
+        anfrage.setValue("application/json", forHTTPHeaderField: "content-type")
+        anfrage.setValue(schluessel, forHTTPHeaderField: "x-api-key")
+        anfrage.setValue("2026-10-21", forHTTPHeaderField: "anthropic-version")
+        anfrage.setValue("server-side-fallback-2026-07-01", forHTTPHeaderField: "anthropic-beta")
+        anfrage.httpBody = try JSONSerialization.data(withJSONObject: koerper)
+
+        let (antwortDaten, antwort) = try await URLSession.shared.data(for: anfrage)
+        try Task.checkCancellation()
+
+        let status = (antwort as? HTTPURLResponse)?.statusCode ?? 0
+        let json = (try? JSONSerialization.jsonObject(with: antwortDaten)) as? [String: Any]
+        guard status == 200 else {
+            let fehler = (json?["error"] as? [String: Any])?["message"] as? String ?? ""
+            throw ZSFotoKHFehler.http(status, fehler)
+        }
+        if json?["stop_reason"] as? String == "refusal" {
+            throw ZSFotoKHFehler.abgelehnt
+        }
+        let bloecke = json?["content"] as? [[String: Any]] ?? []
+        guard let text = bloecke.first(where: { $0["type"] as? String == "text" })?["text"] as? String,
+              let textDaten = text.data(using: .utf8) else {
+            throw ZSFotoKHFehler.antwort("Kein Text in der Antwort.")
+        }
+        do {
+            var ergebnis = try JSONDecoder().decode(ZSSchaetzung.self, from: textDaten)
+            // Spanne sauber halten und nie über Loops eigene Obergrenze für einen KH-Eintrag.
+            let obergrenze = LoopConstants.maxCarbEntryQuantity.doubleValue(for: .gram())
+            ergebnis.khGramm = min(max(0, ergebnis.khGramm), obergrenze)
+            ergebnis.khMin = min(max(0, ergebnis.khMin), ergebnis.khGramm)
+            ergebnis.khMax = min(max(ergebnis.khMax, ergebnis.khGramm), obergrenze)
+            return ergebnis
+        } catch {
+            throw ZSFotoKHFehler.antwort(error.localizedDescription)
+        }
+    }
+}
