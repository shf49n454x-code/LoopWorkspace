+    // MARK: Blätter
+
+    @ViewBuilder
+    private func inhalt(_ blatt: ZSEssenBlatt) -> some View {
+        switch blatt {
+        case .kamera:
+            ZSKameraBlatt { bild in
+                self.blatt = bild.map { .schaetzung($0) }
+            }
+            .ignoresSafeArea()
+        case .schaetzung(let bild):
+            ZSSchaetzungBlatt(bild: bild, speicher: speicher, abbrechen: { self.blatt = nil }, weiter: vormerken)
+        case .manuell:
+            ZSManuellBlatt(speicher: speicher, abbrechen: { self.blatt = nil }, weiter: vormerken)
+        case .standard(let mahlzeit):
+            ZSBestaetigenBlatt(name: mahlzeit.name, startKH: mahlzeit.kh, fpe: mahlzeit.fpe, quelle: .standard, speicher: speicher, abbrechen: { self.blatt = nil }, weiter: vormerken)
+        case .standardNeu:
+            ZSStandardNeuBlatt(abbrechen: { self.blatt = nil }) { neu in
+                speicher.standard.append(neu)
+                self.blatt = nil
+            }
+        case .rezept(let rezept):
+            ZSRezeptBlatt(rezept: rezept, speicher: speicher, abbrechen: { self.blatt = nil }, bearbeiten: { self.blatt = .rezeptBearbeiten(rezept) }, weiter: vormerken)
+        case .rezeptBearbeiten(let rezept):
+            ZSRezeptBearbeitenBlatt(rezept: rezept, abbrechen: { self.blatt = nil }) { neu in
+                if let index = speicher.rezepte.firstIndex(where: { $0.id == neu.id }) {
+                    speicher.rezepte[index] = neu
+                } else {
+                    speicher.rezepte.append(neu)
+                }
+                self.blatt = nil
+            } loeschen: {
+                speicher.rezepte.removeAll { $0.id == rezept.id }
+                self.blatt = nil
+            }
+        case .rueckblick(let mahlzeit):
+            ZSRueckblickBlatt(mahlzeit: mahlzeit, quelle: quelle, abbrechen: { self.blatt = nil }) { antwort in
+                if let index = speicher.mahlzeiten.firstIndex(where: { $0.id == mahlzeit.id }) {
+                    speicher.mahlzeiten[index].rueckmeldung = antwort
+                }
+                self.blatt = nil
+            }
+        case .einstellungen:
+            ZSEssenEinstellungenBlatt(speicher: speicher) { self.blatt = nil }
+        }
+    }
+
+    /// Merkt die Übergabe vor, schließt das Blatt; übergeben wird erst, wenn es zu ist.
+    private func vormerken(_ auswahl: ZSAuswahl) {
+        speicher.mahlzeiten.append(ZSMahlzeit(name: auswahl.name, datum: Date(), kh: auswahl.kh, fpe: auswahl.fpe, quelle: auswahl.quelle, schaetzungKH: auswahl.schaetzungKH))
+        if let fpe = auswahl.fpe, fpe >= 1, let faktor = speicher.plan.khJeFPE, faktor > 0 {
+            offeneFPE = ZSOffeneFPE(name: auswahl.name, fpe: fpe, gramm: fpe * faktor, wirkdauer: ZSFPE.wirkdauer(fpe: fpe))
+        }
+        ausstehend = ZSKHUebergabe(name: auswahl.name, gramm: auswahl.kh, wirkdauer: nil)
+        blatt = nil
+    }
+
+    private func uebergabeAusfuehren() {
+        guard let uebergabe = ausstehend else { return }
+        ausstehend = nil
+        aktionen.uebergeben(uebergabe)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2) { laden() }
+    }
+}
