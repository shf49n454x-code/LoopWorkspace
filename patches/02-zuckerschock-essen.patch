+
+    @State private var punkte: [ZSMesspunkt] = []
+
+    private var spitze: ZSMesspunkt? {
+        punkte.filter { $0.datum >= mahlzeit.datum }.max { $0.mgdl < $1.mgdl }
+    }
+
+    private var start: ZSMesspunkt? {
+        punkte.last { $0.datum <= mahlzeit.datum } ?? punkte.first
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Rückblick", abbrechen: abbrechen)
