+// MARK: - Muster
+
+/// Wann lagen Werte unter 70? Sieben Zeilen (Mo–So) mal 24 Stunden, Punktfläche wächst mit der Anzahl.
+struct ZSTiefMuster: View {
+    var raster: [[Int]]
+    var grenze: String
+
+    private var maximum: Int { raster.flatMap { $0 }.max() ?? 0 }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space3) {
+            HStack(alignment: .firstTextBaseline) {
+                Text("Wann du unter \(grenze) warst")
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                    .accessibilityAddTraits(.isHeader)
+                Spacer()
+                Text("30 Tage")
+                    .font(ZSSchrift.caption)
+                    .foregroundStyle(ZSFarbe.text3)
+            }
+
+            if maximum == 0 {
+                Text("Keine Werte unter \(grenze) in den letzten 30 Tagen.")
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSFarbe.text2)
+            } else {
+                GeometryReader { geo in
+                    let zelle = (geo.size.width - 24) / 24
+                    VStack(alignment: .leading, spacing: 0) {
+                        ForEach(0..<7, id: \.self) { zeile in
+                            HStack(spacing: 0) {
+                                Text(["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"][zeile])
+                                    .font(.system(size: 9, weight: .medium))
+                                    .foregroundStyle(ZSFarbe.text3)
+                                    .frame(width: 24, alignment: .leading)
+                                ForEach(0..<24, id: \.self) { stunde in
+                                    punkt(raster[zeile][stunde], zelle: zelle)
+                                        .frame(width: zelle, height: zelle)
+                                }
+                            }
+                        }
+                        HStack(spacing: 0) {
+                            Color.clear.frame(width: 24)
+                            ForEach([0, 6, 12, 18], id: \.self) { stunde in
+                                Text("\(stunde) Uhr")
+                                    .font(.system(size: 9, weight: .medium))
+                                    .foregroundStyle(ZSFarbe.text3)
+                                    .frame(width: zelle * 6, alignment: .leading)
+                            }
+                        }
+                        .padding(.top, 4)
+                    }
+                }
+                .aspectRatio(24.0 / 9.0, contentMode: .fit)
+                .accessibilityElement(children: .ignore)
+                .accessibilityLabel(barrierefrei)
+
+                Text("Je größer der Punkt, desto mehr Messwerte lagen zu dieser Zeit unter \(grenze). Nur ein Muster, keine Empfehlung.")
+                    .font(ZSSchrift.caption)
+                    .foregroundStyle(ZSFarbe.text3)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+        }
+    }
+
+    private func punkt(_ anzahl: Int, zelle: CGFloat) -> some View {
+        let anteil = maximum > 0 ? sqrt(Double(anzahl) / Double(maximum)) : 0
+        return ZStack {
+            Circle()
+                .fill(ZSFarbe.flaeche2)
+                .frame(width: 3, height: 3)
+            if anzahl > 0 {
+                Circle()
+                    .fill(ZSFarbe.tief.opacity(0.35 + 0.55 * anteil))
+                    .frame(width: max(4, zelle * 0.86 * CGFloat(anteil)), height: max(4, zelle * 0.86 * CGFloat(anteil)))
+            }
+        }
+    }
+
+    private var barrierefrei: String {
+        let tage = ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"]
+        var beste: (zeile: Int, stunde: Int, anzahl: Int) = (0, 0, 0)
+        for zeile in 0..<7 { for stunde in 0..<24 where raster[zeile][stunde] > beste.anzahl { beste = (zeile, stunde, raster[zeile][stunde]) } }
+        return "Häufigste Zeit unter \(grenze): \(tage[beste.zeile]) gegen \(beste.stunde) Uhr"
+    }
+}
