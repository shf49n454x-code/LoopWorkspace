+/// Kurve von 0 bis 24 Uhr mit Zielzone; Essen als Marken oben, Werte unter 70 rot.
+struct ZSTagesKurve: View {
+    var auswertung: ZSTagesAuswertung
+
+    var body: some View {
+        VStack(spacing: 4) {
+            GeometryReader { geo in
+                let r = CGRect(origin: .zero, size: geo.size)
+                let unten = min(50, (auswertung.werte.map(\.mgdl).min() ?? 50) - 5)
+                let oben = max(250, (auswertung.werte.map(\.mgdl).max() ?? 250) + 10)
+                let x: (Date) -> CGFloat = { r.width * CGFloat($0.timeIntervalSince(auswertung.tag) / 86_400) }
+                let y: (Double) -> CGFloat = { r.height * CGFloat(1 - ($0 - unten) / (oben - unten)) }
+                ZStack(alignment: .topLeading) {
+                    Rectangle()
+                        .fill(ZSFarbe.ziel.opacity(0.10))
+                        .frame(width: r.width, height: y(70) - y(180))
+                        .offset(y: y(180))
+                    Path { p in
+                        for grenze in [70.0, 180.0] {
+                            p.move(to: CGPoint(x: 0, y: y(grenze)))
+                            p.addLine(to: CGPoint(x: r.width, y: y(grenze)))
+                        }
+                    }
+                    .stroke(ZSFarbe.ziel.opacity(0.45), style: StrokeStyle(lineWidth: 1, dash: [3, 4]))
+                    Path { p in
+                        var vorher: ZSMesspunkt?
+                        for w in auswertung.werte {
+                            let punkt = CGPoint(x: x(w.datum), y: y(w.mgdl))
+                            if let v = vorher, w.datum.timeIntervalSince(v.datum) < 20 * 60 {
+                                p.addLine(to: punkt)
+                            } else {
+                                p.move(to: punkt)
+                            }
+                            vorher = w
+                        }
+                    }
+                    .stroke(ZSFarbe.orangeLinie, style: StrokeStyle(lineWidth: 2, lineCap: .round, lineJoin: .round))
+                    ForEach(auswertung.werte.filter { $0.mgdl < 70 }) { w in
+                        Circle().fill(ZSFarbe.tief).frame(width: 4, height: 4).position(x: x(w.datum), y: y(w.mgdl))
+                    }
+                    ForEach(auswertung.ereignisse.filter(\.istEssen)) { e in
+                        Image(systemName: "fork.knife")
+                            .font(.system(size: 9, weight: .bold))
+                            .foregroundStyle(ZSFarbe.text2)
+                            .frame(width: 18, height: 18)
+                            .background(Circle().fill(ZSFarbe.flaeche3))
+                            .position(x: min(max(x(e.datum), 9), r.width - 9), y: 9)
+                    }
+                }
+            }
+            HStack {
+                ForEach([0, 6, 12, 18], id: \.self) { stunde in
+                    Text("\(stunde) Uhr")
+                    Spacer()
+                }
+                Text("24")
+            }
+            .font(.system(size: 10, weight: .medium))
+            .foregroundStyle(ZSFarbe.text3)
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Zuckerkurve des Tages")
+    }
+}
