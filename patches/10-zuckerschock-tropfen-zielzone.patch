+//
+//  ZuckerschockZielzeit.swift
+//  Loop
+//
+//  Zuckerschock: „Zeit im Ziel“. Ringe (heute, 7 und 14 Tage), Kalender Tag für Tag (13 Wochen)
+//  und das Muster der Werte unter 70 nach Wochentag und Uhrzeit (30 Tage).
+//  Nur Anzeige von Messwerten aus Apple Health, keine Empfehlung, keine Berechnung von Insulin.
+//
+
+import Foundation
+import HealthKit
+import LoopKit
+import SwiftUI
+
+// MARK: - Auswertung
+
+/// Etwas, das an einem Tag passiert ist (Essen, Pod-Wechsel, Keton, Unterzucker-Begleiter).
+struct ZSTagesEreignis: Identifiable {
+    var id = UUID()
+    var datum: Date
+    var symbol: String
+    var text: String
+    var istEssen = false
+}
+
+struct ZSZielzeitDaten {
+    /// Aufsteigend nach Datum, mg/dl.
+    var werte: [ZSMesspunkt]
+    var bis: Date
+    /// KH-Einträge aus Apple Health und Ereignisse aus der App, für die Tagesansicht.
+    var ereignisse: [ZSTagesEreignis] = []
+
+    static let ziel: ClosedRange<Double> = 70...180
+    static let tief: Double = 70
+
+    private static var kalender: Calendar {
+        var k = Calendar(identifier: .gregorian)
+        k.locale = Locale(identifier: "de_DE")
+        k.firstWeekday = 2
+        return k
+    }
+
+    /// Anteil im Ziel ab `von`; erst ab einer Stunde Werte (12 × 5 Minuten).
+    func anteil(von: Date) -> Double? {
+        let auswahl = werte.filter { $0.datum >= von && $0.datum <= bis }
+        guard auswahl.count >= 12 else { return nil }
+        return Double(auswahl.filter { Self.ziel.contains($0.mgdl) }.count) / Double(auswahl.count)
+    }
+
+    var heute: Double? { anteil(von: Self.kalender.startOfDay(for: bis)) }
+    var tage7: Double? { anteil(von: bis.addingTimeInterval(-7 * 86_400)) }
+    var tage14: Double? { anteil(von: bis.addingTimeInterval(-14 * 86_400)) }
+
+    /// 13 Wochen, Montag zuerst; je Tag der Anteil im Ziel (nil ohne genug Werte, Zukunft = nil).
+    struct Tag: Identifiable {
+        var datum: Date
+        var anteil: Double?
+        var zukunft: Bool
+        var id: Date { datum }
+    }
+
+    var wochen: [[Tag]] {
+        let k = Self.kalender
+        let heuteStart = k.startOfDay(for: bis)
+        let wochenStart = k.dateInterval(of: .weekOfYear, for: heuteStart)?.start ?? heuteStart
+        let erster = k.date(byAdding: .day, value: -7 * 12, to: wochenStart) ?? wochenStart
+
+        var jeTag: [Date: (imZiel: Int, alle: Int)] = [:]
+        for wert in werte where wert.datum >= erster {
+            let tag = k.startOfDay(for: wert.datum)
+            var eintrag = jeTag[tag] ?? (0, 0)
+            eintrag.alle += 1
+            if Self.ziel.contains(wert.mgdl) { eintrag.imZiel += 1 }
+            jeTag[tag] = eintrag
+        }
+
+        return (0..<13).map { woche in
+            (0..<7).map { tagNr in
+                let datum = k.date(byAdding: .day, value: woche * 7 + tagNr, to: erster) ?? erster
+                let eintrag = jeTag[datum]
+                let anteil = eintrag.flatMap { $0.alle >= 12 ? Double($0.imZiel) / Double($0.alle) : nil }
+                return Tag(datum: datum, anteil: anteil, zukunft: datum > heuteStart)
+            }
+        }
+    }
+
+    /// [Wochentag Mo…So][Stunde 0…23]: Anzahl der 5-Minuten-Werte unter 70 in den letzten 30 Tagen.
+    var muster: [[Int]] {
+        let k = Self.kalender
+        let ab = bis.addingTimeInterval(-30 * 86_400)
+        var raster = Array(repeating: Array(repeating: 0, count: 24), count: 7)
+        for wert in werte where wert.datum >= ab && wert.mgdl < Self.tief {
+            let teile = k.dateComponents([.weekday, .hour], from: wert.datum)
+            guard let wochentag = teile.weekday, let stunde = teile.hour else { continue }
+            let zeile = (wochentag + 5) % 7 // So=1 → 6, Mo=2 → 0
+            raster[zeile][stunde] += 1
+        }
+        return raster
+    }
+
+    static func laden(healthStore: HKHealthStore, fertig: @escaping (ZSZielzeitDaten?) -> Void) {
+        let bis = Date()
+        let von = bis.addingTimeInterval(-92 * 86_400)
+        let gruppe = DispatchGroup()
+        var werte: [ZSMesspunkt] = []
+        var khEintraege: [ZSTagesEreignis] = []
+
+        gruppe.enter()
+        healthStore.execute(HKSampleQuery(
+            sampleType: HKQuantityType(.bloodGlucose),
+            predicate: HKQuery.predicateForSamples(withStart: von, end: bis),
+            limit: HKObjectQueryNoLimit,
+            sortDescriptors: [NSSortDescriptor(key: HKSampleSortIdentifierStartDate, ascending: true)]) { _, proben, _ in
+            werte = (proben as? [HKQuantitySample] ?? []).map {
+                ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: .milligramsPerDeciliter))
+            }
+            gruppe.leave()
+        })
+
+        // KH, die Loop nach Apple Health schreibt; ohne Leserecht bleibt die Liste leer.
+        gruppe.enter()
+        healthStore.execute(HKSampleQuery(
+            sampleType: HKQuantityType(.dietaryCarbohydrates),
+            predicate: HKQuery.predicateForSamples(withStart: von, end: bis),
+            limit: HKObjectQueryNoLimit,
+            sortDescriptors: [NSSortDescriptor(key: HKSampleSortIdentifierStartDate, ascending: true)]) { _, proben, _ in
+            khEintraege = (proben as? [HKQuantitySample] ?? []).map {
+                let gramm = $0.quantity.doubleValue(for: .gram())
+                return ZSTagesEreignis(datum: $0.startDate, symbol: "fork.knife", text: "\(ZSFormat.zahl(gramm, stellen: 0)) g KH", istEssen: true)
+            }
+            gruppe.leave()
+        })
+
+        gruppe.notify(queue: .main) {
+            fertig(ZSZielzeitDaten(werte: werte, bis: bis, ereignisse: khEintraege))
+        }
+    }
+}
+
+// MARK: - Blatt
+
+struct ZSZielzeitView: View {
+    var einheit: HKUnit
+    var laden: (@escaping (ZSZielzeitDaten?) -> Void) -> Void
+    var schliessen: () -> Void
+
+    @State private var daten: ZSZielzeitDaten?
+    @State private var laedt = true
+    @State private var tag: ZSTagAuswahl?
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Zeit im Ziel", art: .fertig, abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    if let daten {
+                        ZSZielRinge(heute: daten.heute, tage7: daten.tage7, tage14: daten.tage14)
+                            .zsKarte()
+                            .zsAuftritt(0)
+                        ZSZielKalender(wochen: daten.wochen) { tag = ZSTagAuswahl(datum: $0) }
+                            .zsKarte()
+                            .zsAuftritt(1)
+                        ZSTiefMuster(raster: daten.muster, grenze: ZSFormat.glukose(ZSZielzeitDaten.tief, einheit) + " " + ZSFormat.einheit(einheit))
+                            .zsKarte()
+                            .zsAuftritt(2)
+                    } else if laedt {
+                        ProgressView()
+                            .tint(ZSFarbe.text2)
+                            .frame(maxWidth: .infinity, minHeight: 200)
+                    } else {
+                        Text("Keine Werte aus Apple Health. Prüfe in den Einstellungen von Health, ob die App Blutzucker lesen darf.")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                            .zsKarte()
+                    }
+
+                    Text("Zielbereich \(ZSFormat.glukose(70, einheit))–\(ZSFormat.glukose(180, einheit)) \(ZSFormat.einheit(einheit)). Werte aus Apple Health. Nur Anzeige: Änderungen an der Therapie besprichst du mit deinem Diabetes-Team.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text3)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .sheet(item: $tag) { auswahl in
+            if let daten {
+                ZSTagView(auswertung: ZSTagesAuswertung(daten: daten, tag: auswahl.datum), einheit: einheit)
+                    .presentationDragIndicator(.visible)
+            }
+        }
+        .onAppear {
+            laden { neu in
+                daten = (neu?.werte.isEmpty ?? true) ? nil : neu
+                laedt = false
+            }
+        }
+    }
+}
