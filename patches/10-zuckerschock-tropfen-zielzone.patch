+}
+
+/// Oranger Tropfen. Bei jedem Tabwechsel: in die Länge ziehen (Fahrt), leicht überschwingen
+/// (Ankommen), dann ruhig. „Bewegung reduzieren“ zeigt nur den Kreis.
+private struct ZSWassertropfen: View {
+    var tab: ZSTab
+    var ruhig: Bool
+
+    var body: some View {
+        if ruhig {
+            Circle().fill(ZSFarbe.orange)
+        } else {
+            Circle()
+                .fill(ZSFarbe.orange)
+                .keyframeAnimator(initialValue: ZSTropfenForm(), trigger: tab) { inhalt, form in
+                    inhalt
+                        .scaleEffect(x: form.breit, y: form.hoch)
+                        .background {
+                            Circle()
+                                .stroke(ZSFarbe.orange, lineWidth: 1.5)
+                                .scaleEffect(1 + 0.45 * form.ring)
+                                .opacity(form.ring > 0 ? Double(0.45 * (1 - form.ring)) : 0)
+                        }
+                } keyframes: { _ in
+                    KeyframeTrack(\.breit) {
+                        CubicKeyframe(1.55, duration: 0.16)
+                        SpringKeyframe(0.9, duration: 0.2, spring: .snappy)
+                        SpringKeyframe(1.0, duration: 0.3, spring: .bouncy)
+                    }
+                    KeyframeTrack(\.hoch) {
+                        CubicKeyframe(0.8, duration: 0.16)
+                        SpringKeyframe(1.08, duration: 0.2, spring: .snappy)
+                        SpringKeyframe(1.0, duration: 0.3, spring: .bouncy)
+                    }
+                    KeyframeTrack(\.ring) {
+                        LinearKeyframe(0, duration: 0.3)
+                        LinearKeyframe(0.01, duration: 0.01)
+                        CubicKeyframe(1, duration: 0.45)
+                        LinearKeyframe(0, duration: 0.01)
+                    }
+                }
+        }
+    }
+}
+
