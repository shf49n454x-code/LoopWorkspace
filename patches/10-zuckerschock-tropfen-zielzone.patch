+// MARK: - Blatt
+
+struct ZSZielzeitView: View {
+    var einheit: HKUnit
+    var laden: (@escaping (ZSZielzeitDaten?) -> Void) -> Void
+    var schliessen: () -> Void
+
+    @State private var daten: ZSZielzeitDaten?
+    @State private var laedt = true
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Zeit im Ziel", art: .fertig, abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    if let daten {
+                        ZSZielRinge(heute: daten.heute, tage7: daten.tage7, tage14: daten.tage14)
+                            .zsKarte()
+                            .zsAuftritt(0)
+                        ZSZielKalender(wochen: daten.wochen)
+                            .zsKarte()
+                            .zsAuftritt(1)
+                        ZSTiefMuster(raster: daten.muster, grenze: ZSFormat.glukose(ZSZielzeitDaten.tief, einheit) + " " + ZSFormat.einheit(einheit))
+                            .zsKarte()
+                            .zsAuftritt(2)
+                    } else if laedt {
+                        ProgressView()
+                            .tint(ZSFarbe.text2)
+                            .frame(maxWidth: .infinity, minHeight: 200)
+                    } else {
+                        Text("Keine Werte aus Apple Health. Prüfe in den Einstellungen von Health, ob die App Blutzucker lesen darf.")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                            .zsKarte()
+                    }
+
+                    Text("Zielbereich \(ZSFormat.glukose(70, einheit))–\(ZSFormat.glukose(180, einheit)) \(ZSFormat.einheit(einheit)). Werte aus Apple Health. Nur Anzeige: Änderungen an der Therapie besprichst du mit deinem Diabetes-Team.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text3)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .onAppear {
+            laden { neu in
+                daten = (neu?.werte.isEmpty ?? true) ? nil : neu
+                laedt = false
+            }
+        }
+    }
+}
