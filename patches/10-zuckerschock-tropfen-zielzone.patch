+struct ZSTagView: View {
+    var auswertung: ZSTagesAuswertung
+    var einheit: HKUnit
+
+    @Environment(\.dismiss) private var dismiss
+
+    private func g(_ mgdl: Double) -> String { ZSFormat.glukose(mgdl, einheit) }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: ZSTagesAuswertung.titel(auswertung.tag), art: .fertig, abbrechen: { dismiss() })
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space4) {
+                    verteilung.zsKarte()
+                    VStack(alignment: .leading, spacing: ZSMass.space2) {
+                        Text("Der Tag")
+                            .font(ZSSchrift.subhead.weight(.semibold))
+                            .foregroundStyle(ZSFarbe.text)
+                        ZSTagesKurve(auswertung: auswertung)
+                            .frame(height: 170)
+                    }
+                    .zsKarte()
+                    auffaelligkeiten.zsKarte()
+                    if !sonstige.isEmpty {
+                        ereignisListe.zsKarte()
+                    }
+                    Text("Nur Beobachtungen aus deinen Werten und Einträgen. Was du daraus ableitest, besprichst du mit deinem Diabetes-Team.")
+                        .font(ZSSchrift.footnote)
+                        .foregroundStyle(ZSFarbe.text3)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+    }
+
+    private var verteilung: some View {
+        let a = auswertung.anteile
+        return VStack(alignment: .leading, spacing: ZSMass.space3) {
+            HStack(alignment: .firstTextBaseline, spacing: ZSMass.space2) {
+                Text("\(Int((a.ziel * 100).rounded())) %")
+                    .font(.system(size: 40, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .foregroundStyle(ZSFarbe.text)
+                Text("im Ziel")
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSFarbe.text2)
+            }
+            GeometryReader { geo in
+                HStack(spacing: 2) {
+                    ForEach([(a.tief, ZSFarbe.tief), (a.ziel, ZSFarbe.ziel), (a.hoch, ZSFarbe.hoch)].indices, id: \.self) { i in
+                        let teil = [(a.tief, ZSFarbe.tief), (a.ziel, ZSFarbe.ziel), (a.hoch, ZSFarbe.hoch)][i]
+                        if teil.0 > 0 {
+                            RoundedRectangle(cornerRadius: 3, style: .continuous)
+                                .fill(teil.1)
+                                .frame(width: max(4, (geo.size.width - 4) * CGFloat(teil.0)))
+                        }
+                    }
+                }
+            }
+            .frame(height: 10)
+            .accessibilityHidden(true)
+            HStack(spacing: ZSMass.space4) {
+                anteil("unter \(g(70))", a.tief, ZSFarbe.tief)
+                anteil("im Ziel", a.ziel, ZSFarbe.ziel)
+                anteil("über \(g(180))", a.hoch, ZSFarbe.hoch)
+            }
+        }
+    }
+
+    private func anteil(_ titel: String, _ wert: Double, _ farbe: Color) -> some View {
+        HStack(spacing: 5) {
+            Circle().fill(farbe).frame(width: 7, height: 7)
+            Text("\(Int((wert * 100).rounded())) %")
+                .font(ZSSchrift.caption.weight(.semibold))
+                .monospacedDigit()
+                .foregroundStyle(ZSFarbe.text)
+            Text(titel)
+                .font(ZSSchrift.caption)
+                .foregroundStyle(ZSFarbe.text3)
+        }
+        .accessibilityElement(children: .combine)
+    }
+
+    private static func uhr(_ d: Date) -> String { ZSFormat.uhrzeit(d) }
+
+    private static func dauer(_ t: TimeInterval) -> String {
+        let minuten = Int((t / 60).rounded())
+        return minuten >= 60 ? "\(minuten / 60) Std\(minuten % 60 > 0 ? " \(minuten % 60) Min" : "")" : "\(minuten) Min"
+    }
+
+    private var auffaelligkeiten: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space3) {
+            Text("Was an diesem Tag auffiel")
+                .font(ZSSchrift.subhead.weight(.semibold))
+                .foregroundStyle(ZSFarbe.text)
+                .accessibilityAddTraits(.isHeader)
+            let phasen = auswertung.phasen
+            let luecken = auswertung.luecken
+            if phasen.isEmpty && luecken.isEmpty {
+                Text("Keine längeren Phasen außerhalb des Ziels.")
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSFarbe.text2)
+            }
+            ForEach(phasen) { phase in
+                zeile(symbol: phase.hoch ? "arrow.up.right" : "arrow.down.right",
+                      farbe: phase.hoch ? ZSFarbe.hoch : ZSFarbe.tief,
+                      titel: "\(Self.uhr(phase.start))–\(Self.uhr(phase.ende)) \(phase.hoch ? "über \(g(180))" : "unter \(g(70))")",
+                      text: "\(Self.dauer(phase.dauer)) · \(phase.hoch ? "höchster" : "tiefster") Wert \(g(phase.extrem))",
+                      zusatz: phase.hoch ? auswertung.essenVor(phase).map { "Davor \(Self.uhr($0.datum)): \($0.text)" } : nil)
+            }
+            ForEach(Array(luecken.enumerated()), id: \.offset) { _, luecke in
+                zeile(symbol: "antenna.radiowaves.left.and.right.slash", farbe: ZSFarbe.text3,
+                      titel: "\(Self.uhr(luecke.von))–\(Self.uhr(luecke.bis)) keine Sensorwerte",
+                      text: Self.dauer(luecke.bis.timeIntervalSince(luecke.von)), zusatz: nil)
+            }
+        }
+    }
+
+    /// Ereignisse außer Essen (Pod-Wechsel, Keton, Unterzucker-Begleiter); Essen steht in der Kurve.
+    private var sonstige: [ZSTagesEreignis] { auswertung.ereignisse.filter { !$0.istEssen } }
+
+    private var ereignisListe: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space3) {
+            Text("Einträge")
+                .font(ZSSchrift.subhead.weight(.semibold))
+                .foregroundStyle(ZSFarbe.text)
+                .accessibilityAddTraits(.isHeader)
+            ForEach(sonstige) { e in
+                zeile(symbol: e.symbol, farbe: ZSFarbe.text2, titel: "\(Self.uhr(e.datum)) \(e.text)", text: nil, zusatz: nil)
+            }
+        }
+    }
+
+    private func zeile(symbol: String, farbe: Color, titel: String, text: String?, zusatz: String?) -> some View {
+        HStack(alignment: .top, spacing: ZSMass.space3) {
+            Image(systemName: symbol)
+                .font(.system(size: 14, weight: .semibold))
+                .foregroundStyle(farbe)
+                .frame(width: 22)
+            VStack(alignment: .leading, spacing: 2) {
+                Text(titel)
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                if let text {
+                    Text(text)
+                        .font(ZSSchrift.caption)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+                if let zusatz {
+                    Label(zusatz, systemImage: "fork.knife")
+                        .font(ZSSchrift.caption)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+            }
+            Spacer(minLength: 0)
+        }
+        .accessibilityElement(children: .combine)
+    }
+}
