+                    .rotationEffect(.degrees(-90))
+            }
+            .frame(width: 16, height: 16)
+            Text(anteil.map { "\(Int(($0 * 100).rounded())) % im Ziel" } ?? "Zeit im Ziel")
+                .font(ZSSchrift.caption.weight(.semibold))
+                .monospacedDigit()
+                .foregroundStyle(ZSFarbe.text)
+                .lineLimit(1)
+            Image(systemName: "chevron.right")
+                .font(.system(size: 10, weight: .semibold))
+                .foregroundStyle(ZSFarbe.text3)
+        }
+        .padding(.horizontal, 10)
+        .frame(minHeight: 30)
+        .background(Capsule().fill(ZSFarbe.flaeche2))
+        .contentShape(Capsule())
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(anteil.map { "Heute \(Int(($0 * 100).rounded())) Prozent im Zielbereich" } ?? "Zeit im Ziel")
+        .accessibilityHint("Öffnet Zeit im Ziel mit Ringen, Kalender und Muster")
+        .accessibilityAddTraits(.isButton)
+    }
+}
