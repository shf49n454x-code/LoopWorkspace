+// MARK: - Auftritt
+
+/// Karten erscheinen beim ersten Anzeigen weich: von 18 pt tiefer und 98,5 %, nacheinander um 70 ms versetzt.
+/// Der Endzustand hängt nie an der Animation: „Bewegung reduzieren“ zeigt sofort alles, und spätestens
+/// nach 2,5 Sekunden steht jede Karte fertig da.
+struct ZSAuftritt: ViewModifier {
+    var index: Int
+
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var da = false
+
+    func body(content: Content) -> some View {
+        let sichtbar = da || reduceMotion
+        content
+            .opacity(sichtbar ? 1 : 0)
+            .offset(y: sichtbar ? 0 : 18)
+            .scaleEffect(sichtbar ? 1 : 0.985)
+            .onAppear {
+                guard !da else { return }
+                withAnimation(.spring(response: 0.6, dampingFraction: 0.82).delay(Double(index) * 0.07)) { da = true }
+                DispatchQueue.main.asyncAfter(deadline: .now() + 2.5) { if !da { da = true } }
+            }
+    }
+}
+
+extension View {
+    func zsAuftritt(_ index: Int) -> some View { modifier(ZSAuftritt(index: index)) }
+}
