+#if targetEnvironment(simulator)
+extension ZSZielzeitDaten {
+    /// 92 Tage Beispielwerte: Tageswelle, Mahlzeitenspitzen, gelegentlich nachts unter 70.
+    static func vorschau() -> ZSZielzeitDaten {
+        let bis = Date()
+        var werte: [ZSMesspunkt] = []
+        var zufall: UInt64 = 42
+        func naechste() -> Double {
+            zufall = zufall &* 6364136223846793005 &+ 1442695040888963407
+            return Double(zufall >> 33) / Double(1 << 31)
+        }
+        var tagesVersatz = 0.0
+        let anzahl = 92 * 288
+        for i in 0..<anzahl {
+            let datum = bis.addingTimeInterval(-Double(anzahl - 1 - i) * 300)
+            let stunde = Double(Calendar.current.component(.hour, from: datum)) + Double(Calendar.current.component(.minute, from: datum)) / 60
+            if i % 288 == 0 { tagesVersatz = (naechste() - 0.35) * 90 }
+            var mgdl = 125 + tagesVersatz
+            mgdl += 55 * exp(-pow((stunde - 8.5) / 1.1, 2))
+            mgdl += 45 * exp(-pow((stunde - 13.5) / 1.3, 2))
+            mgdl += 60 * exp(-pow((stunde - 19.5) / 1.4, 2))
+            mgdl -= 50 * exp(-pow((stunde - 3.5) / 1.2, 2)) * (naechste() < 0.3 ? 1 : 0.4)
+            mgdl += (naechste() - 0.5) * 12
+            werte.append(ZSMesspunkt(datum: datum, mgdl: max(45, mgdl)))
+        }
+        var ereignisse: [ZSTagesEreignis] = []
+        let k = Calendar.current
+        for tag in 0..<92 {
+            guard let start = k.date(byAdding: .day, value: -tag, to: k.startOfDay(for: bis)) else { continue }
+            for (stunde, name) in [(8.0, "Müsli · 45 g KH"), (13.0, "Pasta · 70 g KH"), (19.0, "Pizza · 85 g KH")] {
+                let datum = start.addingTimeInterval(stunde * 3600 - 30 * 60)
+                if datum < bis { ereignisse.append(ZSTagesEreignis(datum: datum, symbol: "fork.knife", text: name, istEssen: true)) }
+            }
+            if tag % 3 == 1 {
+                ereignisse.append(ZSTagesEreignis(datum: start.addingTimeInterval(18.3 * 3600), symbol: "circle.dotted", text: "Pod-Wechsel · Bauch links"))
+            }
+        }
+        return ZSZielzeitDaten(werte: werte, bis: bis, ereignisse: ereignisse)
+    }
+}
+#endif
