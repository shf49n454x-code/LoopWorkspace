+    var tage7: Double?
+    var tage14: Double?
+
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var gezeichnet = false
+
+    private var eintraege: [(titel: String, wert: Double?, deckkraft: Double)] {
+        [("heute", heute, 1), ("7 Tage", tage7, 0.72), ("14 Tage", tage14, 0.48)]
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space4) {
+            Text("Im Zielbereich")
+                .font(ZSSchrift.subhead.weight(.semibold))
+                .foregroundStyle(ZSFarbe.text)
+                .accessibilityAddTraits(.isHeader)
+            HStack(spacing: ZSMass.space5) {
+                ZStack {
+                    ForEach(Array(eintraege.enumerated()), id: \.offset) { index, eintrag in
+                        let groesse = 148 - CGFloat(index) * 38
+                        Circle()
+                            .stroke(ZSFarbe.flaeche2, lineWidth: 14)
+                            .frame(width: groesse, height: groesse)
+                        Circle()
+                            .trim(from: 0, to: (gezeichnet || reduceMotion) ? CGFloat(eintrag.wert ?? 0) : 0)
+                            .stroke(ZSFarbe.ziel.opacity(eintrag.deckkraft), style: StrokeStyle(lineWidth: 14, lineCap: .round))
+                            .rotationEffect(.degrees(-90))
+                            .frame(width: groesse, height: groesse)
+                            .animation(reduceMotion ? nil : .spring(response: 1.0, dampingFraction: 0.85).delay(Double(index) * 0.12), value: gezeichnet)
+                    }
+                }
+                .frame(width: 148, height: 148)
+                .accessibilityHidden(true)
+
+                VStack(alignment: .leading, spacing: ZSMass.space3) {
+                    ForEach(Array(eintraege.enumerated()), id: \.offset) { _, eintrag in
+                        HStack(alignment: .firstTextBaseline, spacing: ZSMass.space2) {
+                            Circle()
+                                .fill(ZSFarbe.ziel.opacity(eintrag.deckkraft))
+                                .frame(width: 9, height: 9)
+                            Text(eintrag.wert.map { "\(Int(($0 * 100).rounded())) %" } ?? "–")
+                                .font(.system(.title3, design: .rounded).weight(.semibold))
+                                .monospacedDigit()
+                                .foregroundStyle(ZSFarbe.text)
+                            Text(eintrag.titel)
+                                .font(ZSSchrift.subhead)
+                                .foregroundStyle(ZSFarbe.text2)
