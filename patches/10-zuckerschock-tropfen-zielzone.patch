+            blattZeigen { schliessen in AnyView(ZSZielzeitView(einheit: .milligramsPerDeciliter, laden: { $0(ZSZielzeitDaten.vorschau()) }, schliessen: schliessen)) }
         case "sperrbildschirm":
             if #available(iOS 16.2, *) {
                 blattZeigen { schliessen in AnyView(ZSGlukoseAktivitaetVorschau(schliessen: schliessen)) }
