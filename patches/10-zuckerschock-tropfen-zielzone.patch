+// MARK: - Kalender
+
+/// Ein Kästchen je Tag, Wochen als Spalten, Montag oben. Je grüner, desto mehr Zeit im Ziel.
+struct ZSZielKalender: View {
+    var wochen: [[ZSZielzeitDaten.Tag]]
+
+    private static let stufen: [Double] = [0.16, 0.32, 0.52, 0.76, 1.0]
+
+    static func deckkraft(_ anteil: Double) -> Double {
+        switch anteil {
+        case ..<0.4: return stufen[0]
+        case ..<0.55: return stufen[1]
+        case ..<0.7: return stufen[2]
+        case ..<0.85: return stufen[3]
+        default: return stufen[4]
+        }
+    }
+
+    private var tageMitWert: [ZSZielzeitDaten.Tag] { wochen.flatMap { $0 }.filter { $0.anteil != nil } }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space3) {
+            HStack(alignment: .firstTextBaseline) {
+                Text("Tag für Tag")
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                    .accessibilityAddTraits(.isHeader)
+                Spacer()
+                Text("13 Wochen")
+                    .font(ZSSchrift.caption)
+                    .foregroundStyle(ZSFarbe.text3)
+            }
+
+            GeometryReader { geo in
+                let abstand: CGFloat = 3
+                let spalteBreite = (geo.size.width - 22 - abstand * 12) / 13
+                let kante = min(22, max(8, spalteBreite))
+                HStack(alignment: .top, spacing: abstand) {
+                    VStack(alignment: .leading, spacing: abstand) {
+                        Color.clear.frame(height: 14)
+                        ForEach(Array(["Mo", "", "Mi", "", "Fr", "", "So"].enumerated()), id: \.offset) { _, name in
+                            Text(name)
+                                .font(.system(size: 9, weight: .medium))
+                                .foregroundStyle(ZSFarbe.text3)
+                                .frame(width: 19, height: kante, alignment: .leading)
+                        }
+                    }
+                    ForEach(Array(wochen.enumerated()), id: \.offset) { index, woche in
+                        VStack(spacing: abstand) {
+                            Text(monatsMarke(woche: woche, index: index))
+                                .font(.system(size: 9, weight: .medium))
+                                .foregroundStyle(ZSFarbe.text3)
+                                .fixedSize()
+                                .frame(width: kante, height: 14, alignment: .leading)
+                            ForEach(woche) { tag in
+                                kaestchen(tag, kante: kante)
+                            }
+                        }
+                    }
+                }
+            }
+            .frame(height: 14 + 7 * 22 + 6 * 3)
+            .accessibilityHidden(true)
+
+            HStack(spacing: 4) {
+                Text("weniger")
+                ForEach(Self.stufen, id: \.self) { stufe in
+                    RoundedRectangle(cornerRadius: 3, style: .continuous)
+                        .fill(ZSFarbe.ziel.opacity(stufe))
+                        .frame(width: 11, height: 11)
+                }
+                Text("mehr im Ziel")
+                Spacer()
+                Text("\(tageMitWert.filter { ($0.anteil ?? 0) >= 0.7 }.count) von \(tageMitWert.count) Tagen ≥ 70 %")
+                    .monospacedDigit()
+            }
+            .font(ZSSchrift.caption)
+            .foregroundStyle(ZSFarbe.text3)
+            .accessibilityElement(children: .ignore)
+            .accessibilityLabel("\(tageMitWert.filter { ($0.anteil ?? 0) >= 0.7 }.count) von \(tageMitWert.count) Tagen mit mindestens 70 Prozent Zeit im Ziel")
+        }
+    }
+
+    private func kaestchen(_ tag: ZSZielzeitDaten.Tag, kante: CGFloat) -> some View {
+        let istHeute = Calendar.current.isDateInToday(tag.datum)
+        return RoundedRectangle(cornerRadius: 4, style: .continuous)
+            .fill(tag.zukunft ? Color.clear : (tag.anteil.map { ZSFarbe.ziel.opacity(Self.deckkraft($0)) } ?? ZSFarbe.flaeche2))
+            .overlay {
+                if istHeute {
+                    RoundedRectangle(cornerRadius: 4, style: .continuous)
+                        .strokeBorder(ZSFarbe.text, lineWidth: 1.5)
+                }
+            }
+            .frame(width: kante, height: kante)
+    }
+
+    /// Monatsname über der Woche, in der ein Monat beginnt (und über der ersten Woche).
+    private func monatsMarke(woche: [ZSZielzeitDaten.Tag], index: Int) -> String {
+        let k = Calendar.current
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "de_DE")
+        formatter.dateFormat = "LLL"
+        if index == 0, let erster = woche.first { return formatter.string(from: erster.datum) }
+        if let monatsErster = woche.first(where: { k.component(.day, from: $0.datum) == 1 }) {
+            return formatter.string(from: monatsErster.datum)
+        }
+        return ""
+    }
+}
