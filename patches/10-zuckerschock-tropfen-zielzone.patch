+/// Was an einem Tag auffiel: nur Beobachtungen aus Messwerten und Einträgen, nie ein „weil“, nie eine Empfehlung.
+struct ZSTagesAuswertung {
+    var tag: Date
+    var werte: [ZSMesspunkt]
+    var ereignisse: [ZSTagesEreignis]
+
+    init(daten: ZSZielzeitDaten, tag: Date) {
+        let start = Calendar.current.startOfDay(for: tag)
+        let ende = start.addingTimeInterval(86_400)
+        self.tag = start
+        werte = daten.werte.filter { $0.datum >= start && $0.datum < ende }
+        ereignisse = daten.ereignisse.filter { $0.datum >= start && $0.datum < ende }.sorted { $0.datum < $1.datum }
+    }
+
+    static func titel(_ datum: Date) -> String {
+        datum.formatted(.dateTime.weekday(.wide).day().month(.wide).locale(Locale(identifier: "de_DE")))
+    }
+
+    /// Anteile unter 70, im Ziel, über 180.
+    var anteile: (tief: Double, ziel: Double, hoch: Double) {
+        guard !werte.isEmpty else { return (0, 0, 0) }
+        let n = Double(werte.count)
+        return (Double(werte.filter { $0.mgdl < 70 }.count) / n,
+                Double(werte.filter { (70...180).contains($0.mgdl) }.count) / n,
+                Double(werte.filter { $0.mgdl > 180 }.count) / n)
+    }
+
+    struct Phase: Identifiable {
+        var start: Date
+        var ende: Date
+        var extrem: Double
+        var hoch: Bool
+        var id: Date { start }
+        var dauer: TimeInterval { ende.timeIntervalSince(start) }
+    }
+
+    /// Zusammenhängende Phasen über 180 (ab 30 Min) und unter 70 (ab 15 Min); Lücken bis 15 Min zählen mit.
+    var phasen: [Phase] {
+        func suche(hoch: Bool) -> [Phase] {
+            var ergebnis: [Phase] = []
+            var laufend: Phase?
+            for wert in werte {
+                let drin = hoch ? wert.mgdl > 180 : wert.mgdl < 70
+                if drin {
+                    if var p = laufend, wert.datum.timeIntervalSince(p.ende) <= 15 * 60 {
+                        p.ende = wert.datum
+                        p.extrem = hoch ? max(p.extrem, wert.mgdl) : min(p.extrem, wert.mgdl)
+                        laufend = p
+                    } else {
+                        if let p = laufend { ergebnis.append(p) }
+                        laufend = Phase(start: wert.datum, ende: wert.datum, extrem: wert.mgdl, hoch: hoch)
+                    }
+                } else if let p = laufend, wert.datum.timeIntervalSince(p.ende) > 15 * 60 {
+                    ergebnis.append(p)
+                    laufend = nil
+                }
+            }
+            if let p = laufend { ergebnis.append(p) }
+            return ergebnis.filter { $0.dauer >= (hoch ? 30 : 15) * 60 }
+        }
+        return (suche(hoch: true) + suche(hoch: false)).sorted { $0.start < $1.start }
+    }
+
+    /// Sensorlücken ab einer Stunde.
+    var luecken: [(von: Date, bis: Date)] {
+        zip(werte, werte.dropFirst()).compactMap { a, b in
+            b.datum.timeIntervalSince(a.datum) >= 3600 ? (von: a.datum, bis: b.datum) : nil
+        }
+    }
+
+    /// Das letzte Essen bis 3 Stunden vor (oder 15 Minuten nach) Beginn einer hohen Phase.
+    func essenVor(_ phase: Phase) -> ZSTagesEreignis? {
+        ereignisse.filter { $0.istEssen && $0.datum >= phase.start.addingTimeInterval(-3 * 3600) && $0.datum <= phase.start.addingTimeInterval(15 * 60) }.last
+    }
+}
