+//
+//  ZuckerschockZielzeit.swift
+//  Loop
+//
+//  Zuckerschock: „Zeit im Ziel“. Ringe (heute, 7 und 14 Tage), Kalender Tag für Tag (13 Wochen)
+//  und das Muster der Werte unter 70 nach Wochentag und Uhrzeit (30 Tage).
+//  Nur Anzeige von Messwerten aus Apple Health, keine Empfehlung, keine Berechnung von Insulin.
+//
+
+import Foundation
+import HealthKit
+import LoopKit
+import SwiftUI
+
+// MARK: - Auswertung
+
+struct ZSZielzeitDaten {
+    /// Aufsteigend nach Datum, mg/dl.
+    var werte: [ZSMesspunkt]
+    var bis: Date
+
+    static let ziel: ClosedRange<Double> = 70...180
+    static let tief: Double = 70
+
+    private static var kalender: Calendar {
+        var k = Calendar(identifier: .gregorian)
+        k.locale = Locale(identifier: "de_DE")
+        k.firstWeekday = 2
+        return k
+    }
+
+    /// Anteil im Ziel ab `von`; erst ab einer Stunde Werte (12 × 5 Minuten).
+    func anteil(von: Date) -> Double? {
+        let auswahl = werte.filter { $0.datum >= von && $0.datum <= bis }
+        guard auswahl.count >= 12 else { return nil }
+        return Double(auswahl.filter { Self.ziel.contains($0.mgdl) }.count) / Double(auswahl.count)
+    }
+
+    var heute: Double? { anteil(von: Self.kalender.startOfDay(for: bis)) }
+    var tage7: Double? { anteil(von: bis.addingTimeInterval(-7 * 86_400)) }
+    var tage14: Double? { anteil(von: bis.addingTimeInterval(-14 * 86_400)) }
+
+    /// 13 Wochen, Montag zuerst; je Tag der Anteil im Ziel (nil ohne genug Werte, Zukunft = nil).
+    struct Tag: Identifiable {
+        var datum: Date
+        var anteil: Double?
+        var zukunft: Bool
+        var id: Date { datum }
+    }
+
+    var wochen: [[Tag]] {
+        let k = Self.kalender
+        let heuteStart = k.startOfDay(for: bis)
+        let wochenStart = k.dateInterval(of: .weekOfYear, for: heuteStart)?.start ?? heuteStart
+        let erster = k.date(byAdding: .day, value: -7 * 12, to: wochenStart) ?? wochenStart
+
+        var jeTag: [Date: (imZiel: Int, alle: Int)] = [:]
+        for wert in werte where wert.datum >= erster {
+            let tag = k.startOfDay(for: wert.datum)
+            var eintrag = jeTag[tag] ?? (0, 0)
+            eintrag.alle += 1
+            if Self.ziel.contains(wert.mgdl) { eintrag.imZiel += 1 }
+            jeTag[tag] = eintrag
+        }
+
+        return (0..<13).map { woche in
+            (0..<7).map { tagNr in
+                let datum = k.date(byAdding: .day, value: woche * 7 + tagNr, to: erster) ?? erster
+                let eintrag = jeTag[datum]
+                let anteil = eintrag.flatMap { $0.alle >= 12 ? Double($0.imZiel) / Double($0.alle) : nil }
+                return Tag(datum: datum, anteil: anteil, zukunft: datum > heuteStart)
+            }
+        }
+    }
+
+    /// [Wochentag Mo…So][Stunde 0…23]: Anzahl der 5-Minuten-Werte unter 70 in den letzten 30 Tagen.
+    var muster: [[Int]] {
+        let k = Self.kalender
+        let ab = bis.addingTimeInterval(-30 * 86_400)
+        var raster = Array(repeating: Array(repeating: 0, count: 24), count: 7)
+        for wert in werte where wert.datum >= ab && wert.mgdl < Self.tief {
+            let teile = k.dateComponents([.weekday, .hour], from: wert.datum)
+            guard let wochentag = teile.weekday, let stunde = teile.hour else { continue }
+            let zeile = (wochentag + 5) % 7 // So=1 → 6, Mo=2 → 0
+            raster[zeile][stunde] += 1
+        }
+        return raster
+    }
+
+    static func laden(healthStore: HKHealthStore, fertig: @escaping (ZSZielzeitDaten?) -> Void) {
+        let bis = Date()
+        let von = bis.addingTimeInterval(-92 * 86_400)
+        let abfrage = HKSampleQuery(
+            sampleType: HKQuantityType(.bloodGlucose),
+            predicate: HKQuery.predicateForSamples(withStart: von, end: bis),
+            limit: HKObjectQueryNoLimit,
+            sortDescriptors: [NSSortDescriptor(key: HKSampleSortIdentifierStartDate, ascending: true)]) { _, proben, _ in
+            let werte = (proben as? [HKQuantitySample] ?? []).map {
+                ZSMesspunkt(datum: $0.startDate, mgdl: $0.quantity.doubleValue(for: .milligramsPerDeciliter))
+            }
+            DispatchQueue.main.async { fertig(ZSZielzeitDaten(werte: werte, bis: bis)) }
+        }
+        healthStore.execute(abfrage)
+    }
+}
