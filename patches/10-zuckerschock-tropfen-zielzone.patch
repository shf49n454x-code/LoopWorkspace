+// MARK: - Muster
+
+/// Wann lagen Werte unter 70? Sieben Zeilen (Mo–So) mal 12 Blöcke à 2 Stunden, Punktfläche wächst mit der Anzahl.
+struct ZSTiefMuster: View {
+    /// [Wochentag][Stunde 0…23]
+    var raster: [[Int]]
+    var grenze: String
+
+    /// Zu 2-Stunden-Blöcken zusammengefasst, damit die Punkte auf dem iPhone groß genug sind.
+    private var bloecke: [[Int]] {
+        raster.map { zeile in (0..<12).map { zeile[$0 * 2] + zeile[$0 * 2 + 1] } }
+    }
+
+    private var maximum: Int { bloecke.flatMap { $0 }.max() ?? 0 }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space3) {
+            HStack(alignment: .firstTextBaseline) {
+                Text("Wann du unter \(grenze) warst")
+                    .font(ZSSchrift.subhead.weight(.semibold))
+                    .foregroundStyle(ZSFarbe.text)
+                    .accessibilityAddTraits(.isHeader)
+                Spacer()
+                Text("30 Tage")
+                    .font(ZSSchrift.caption)
+                    .foregroundStyle(ZSFarbe.text3)
+            }
+
+            if maximum == 0 {
+                Text("Keine Werte unter \(grenze) in den letzten 30 Tagen.")
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSFarbe.text2)
+            } else {
+                GeometryReader { geo in
+                    let zelle = (geo.size.width - 26) / 12
+                    VStack(alignment: .leading, spacing: 0) {
+                        ForEach(0..<7, id: \.self) { zeile in
+                            HStack(spacing: 0) {
+                                Text(["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"][zeile])
+                                    .font(.system(size: 10, weight: .medium))
+                                    .foregroundStyle(ZSFarbe.text3)
+                                    .frame(width: 26, alignment: .leading)
+                                ForEach(0..<12, id: \.self) { block in
+                                    punkt(bloecke[zeile][block], zelle: zelle)
+                                        .frame(width: zelle, height: zelle * 0.8)
+                                }
+                            }
+                        }
+                        HStack(spacing: 0) {
+                            Color.clear.frame(width: 26)
+                            ForEach([0, 6, 12, 18], id: \.self) { stunde in
+                                Text("\(stunde) Uhr")
+                                    .font(.system(size: 10, weight: .medium))
+                                    .foregroundStyle(ZSFarbe.text3)
+                                    .frame(width: zelle * 3, alignment: .leading)
+                            }
+                        }
+                        .padding(.top, 4)
+                    }
+                }
+                .aspectRatio(12.0 / 6.6, contentMode: .fit)
+                .accessibilityElement(children: .ignore)
+                .accessibilityLabel(barrierefrei)
+
+                Text("Je größer der Punkt, desto mehr Messwerte lagen zu dieser Zeit unter \(grenze). Nur ein Muster, keine Empfehlung.")
+                    .font(ZSSchrift.caption)
+                    .foregroundStyle(ZSFarbe.text3)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+        }
+    }
+
+    private func punkt(_ anzahl: Int, zelle: CGFloat) -> some View {
+        let anteil = maximum > 0 ? sqrt(Double(anzahl) / Double(maximum)) : 0
+        return ZStack {
+            Circle()
+                .fill(ZSFarbe.flaeche2)
+                .frame(width: 3, height: 3)
+            if anzahl > 0 {
+                Circle()
+                    .fill(ZSFarbe.tief.opacity(0.35 + 0.55 * anteil))
+                    .frame(width: max(5, zelle * 0.68 * CGFloat(anteil)), height: max(5, zelle * 0.68 * CGFloat(anteil)))
+            }
+        }
+    }
+
+    private var barrierefrei: String {
+        let tage = ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"]
+        var beste: (zeile: Int, block: Int, anzahl: Int) = (0, 0, 0)
+        for zeile in 0..<7 { for block in 0..<12 where bloecke[zeile][block] > beste.anzahl { beste = (zeile, block, bloecke[zeile][block]) } }
+        return "Häufigste Zeit unter \(grenze): \(tage[beste.zeile]) zwischen \(beste.block * 2) und \(beste.block * 2 + 2) Uhr"
+    }
+}
