diff --git a/Loop/Loop/Zuckerschock/ZuckerschockVorrat.swift b/Loop/Loop/Zuckerschock/ZuckerschockVorrat.swift
new file mode 100644
index 0000000..672945a
--- /dev/null
+++ b/Loop/Loop/Zuckerschock/ZuckerschockVorrat.swift
@@ -0,0 +1,419 @@
+//
+//  ZuckerschockVorrat.swift
+//  Loop
+//
+//  Zuckerschock: Vorrat. Pods zählen bei jedem Pod-Wechsel automatisch herunter,
+//  Sensoren und Insulin trägst du ein. Dazu Reichweite, Rezept- und Liefer-Hinweise.
+//  Liest nur aus Loop (Laufzeit von Pod und Sensor, gelieferte Tagesmenge), steuert nichts.
+//
+
+import Combine
+import Foundation
+import LoopKit
+import LoopKitUI
+import SwiftUI
+import UserNotifications
+
+// MARK: - Modell
+
+enum ZSVorratArt: String, Codable, CaseIterable, Identifiable {
+    case pods, sensoren, insulin, zubehoer
+
+    var id: String { rawValue }
+
+    var titel: String {
+        switch self {
+        case .pods: return "Pods"
+        case .sensoren: return "Sensoren"
+        case .insulin: return "Insulin"
+        case .zubehoer: return "Zubehör"
+        }
+    }
+}
+
+struct ZSVorratStand: Codable, Equatable {
+    var pods = 0
+    var sensoren = 0
+    /// Ampullen oder Pens.
+    var insulin = 0
+    var insulinIEJeStueck: Double = 1000
+    var zubehoer = ""
+
+    /// Laufzeit je Stück in Tagen.
+    var tageJePod: Double = 3
+    var tageJeSensor: Double = 10
+
+    /// Ab dieser Reichweite (Tage) erinnert die App an das Folgerezept.
+    var rezeptHinweisAbTagen = 21
+
+    var rezeptAngefragtAm: Date?
+    var lieferungErwartetAm: Date?
+
+    /// Zuletzt automatisch erkannte Wechsel.
+    var letzterPodWechsel: Date?
+    var letzterSensorWechsel: Date?
+    var letzterHinweis: Date?
+}
+
+final class ZSVorrat: ObservableObject {
+    static let shared = ZSVorrat()
+
+    @Published var stand: ZSVorratStand { didSet { sichern() } }
+
+    private let datei: URL
+
+    init(ordner: URL? = nil) {
+        let basis = ordner ?? (FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ?? FileManager.default.temporaryDirectory)
+        let ordner = basis.appendingPathComponent("Zuckerschock", isDirectory: true)
+        try? FileManager.default.createDirectory(at: ordner, withIntermediateDirectories: true)
+        datei = ordner.appendingPathComponent("vorrat.json")
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        stand = (try? Data(contentsOf: datei)).flatMap { try? decoder.decode(ZSVorratStand.self, from: $0) } ?? ZSVorratStand()
+    }
+
+    private func sichern() {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        guard let daten = try? encoder.encode(stand) else { return }
+        try? daten.write(to: datei, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    }
+
+    // MARK: Reichweite
+
+    /// Bis wann reichen die Pods: Lager × Laufzeit + Rest des aktuellen Pods.
+    func podsReichenBis(restAktuell: TimeInterval?, jetzt: Date = Date()) -> Date {
+        jetzt.addingTimeInterval(Double(stand.pods) * stand.tageJePod * 86_400 + (restAktuell ?? 0))
+    }
+
+    func sensorenReichenBis(restAktuell: TimeInterval?, jetzt: Date = Date()) -> Date {
+        jetzt.addingTimeInterval(Double(stand.sensoren) * stand.tageJeSensor * 86_400 + (restAktuell ?? 0))
+    }
+
+    /// Insulin-Reichweite in Tagen aus Lager und der durchschnittlichen Tagesmenge, die Loop geliefert hat.
+    func insulinTage(tagesmenge: Double?) -> Double? {
+        guard let tagesmenge, tagesmenge > 0 else { return nil }
+        return Double(stand.insulin) * stand.insulinIEJeStueck / tagesmenge
+    }
+
+    // MARK: Wechsel
+
+    func podGewechselt(am datum: Date = Date()) {
+        stand.pods = max(0, stand.pods - 1)
+        stand.letzterPodWechsel = datum
+    }
+
+    func sensorGewechselt(am datum: Date = Date()) {
+        stand.sensoren = max(0, stand.sensoren - 1)
+        stand.letzterSensorWechsel = datum
+    }
+}
+
+// MARK: - Quelle (nur lesend aus Loop)
+
+protocol ZSVorratQuelle: AnyObject {
+    /// Verbleibende Laufzeit des aktuellen Pods bzw. Sensors, aus dem Fortschritt, den das Gerät meldet.
+    var podRest: TimeInterval? { get }
+    var sensorRest: TimeInterval? { get }
+    /// Durchschnittlich von Loop gelieferte IE pro Tag (letzte 7 Tage).
+    func tagesmenge(_ fertig: @escaping (Double?) -> Void)
+}
+
+final class ZSLoopVorratQuelle: ZSVorratQuelle {
+    private let deviceManager: DeviceDataManager
+    private let vorrat: ZSVorrat
+
+    init(deviceManager: DeviceDataManager, vorrat: ZSVorrat) {
+        self.deviceManager = deviceManager
+        self.vorrat = vorrat
+    }
+
+    var podRest: TimeInterval? {
+        guard let anteil = deviceManager.pumpManager?.pumpLifecycleProgress?.percentComplete else { return nil }
+        return max(0, 1 - anteil) * vorrat.stand.tageJePod * 86_400
+    }
+
+    var sensorRest: TimeInterval? {
+        guard let anteil = (deviceManager.cgmManager as? CGMManagerUI)?.cgmLifecycleProgress?.percentComplete else { return nil }
+        return max(0, 1 - anteil) * vorrat.stand.tageJeSensor * 86_400
+    }
+
+    func tagesmenge(_ fertig: @escaping (Double?) -> Void) {
+        deviceManager.doseStore.getTotalUnitsDelivered(since: Date().addingTimeInterval(-.days(7))) { ergebnis in
+            var wert: Double?
+            if case .success(let gesamt) = ergebnis {
+                wert = gesamt.value / 7
+            }
+            DispatchQueue.main.async { fertig(wert) }
+        }
+    }
+}
+
+#if targetEnvironment(simulator)
+final class ZSVorschauVorratQuelle: ZSVorratQuelle {
+    var podRest: TimeInterval? { .hours(18) }
+    var sensorRest: TimeInterval? { .days(3) }
+    func tagesmenge(_ fertig: @escaping (Double?) -> Void) { fertig(38) }
+}
+
+extension ZSVorrat {
+    static func vorschau() -> ZSVorrat {
+        let vorrat = ZSVorrat(ordner: FileManager.default.temporaryDirectory.appendingPathComponent("ZSVorschau-\(UUID().uuidString)"))
+        vorrat.stand = ZSVorratStand(pods: 3, sensoren: 2, insulin: 2, insulinIEJeStueck: 1000, zubehoer: "Pod-Pflaster, Alkoholtupfer",
+                                     rezeptAngefragtAm: Date().addingTimeInterval(-.days(28)),
+                                     letzterPodWechsel: Date().addingTimeInterval(-.hours(54)))
+        return vorrat
+    }
+}
+#endif
+
+// MARK: - Wächter: erkennt Pod-Wechsel und erinnert an das Rezept
+
+/// Beobachtet Loops Pod-Laufzeit. Springt sie von „fast verbraucht“ auf „neu“, war das ein Pod-Wechsel.
+final class ZSVorratWaechter {
+    private let deviceManager: DeviceDataManager
+    private let vorrat: ZSVorrat
+    private var abos = Set<AnyCancellable>()
+    private let speicherSchluessel = "Zuckerschock.letzterPodAnteil"
+
+    init(deviceManager: DeviceDataManager, vorrat: ZSVorrat) {
+        self.deviceManager = deviceManager
+        self.vorrat = vorrat
+
+        let center = NotificationCenter.default
+        Publishers.Merge3(
+            center.publisher(for: .LoopDataUpdated, object: deviceManager.loopManager).map { _ in () },
+            center.publisher(for: .PumpManagerChanged, object: deviceManager).map { _ in () },
+            center.publisher(for: .PumpEventsAdded, object: deviceManager).map { _ in () })
+            .receive(on: DispatchQueue.main)
+            .sink { [weak self] in self?.pruefen() }
+            .store(in: &abos)
+    }
+
+    private var letzterAnteil: Double? {
+        get { UserDefaults.standard.object(forKey: speicherSchluessel) as? Double }
+        set { UserDefaults.standard.set(newValue, forKey: speicherSchluessel) }
+    }
+
+    func pruefen(jetzt: Date = Date()) {
+        if let anteil = deviceManager.pumpManager?.pumpLifecycleProgress?.percentComplete {
+            if let vorher = letzterAnteil, ZSVorratWaechter.istWechsel(vorher: vorher, jetzt: anteil),
+               jetzt.timeIntervalSince(vorrat.stand.letzterPodWechsel ?? .distantPast) > .hours(12) {
+                vorrat.podGewechselt(am: jetzt)
+            }
+            letzterAnteil = anteil
+        }
+        hinweisFallsNoetig(jetzt: jetzt)
+    }
+
+    /// Ein Wechsel: vorher mindestens ein Drittel verbraucht, jetzt fast neu.
+    static func istWechsel(vorher: Double, jetzt: Double) -> Bool {
+        vorher >= 0.33 && jetzt <= 0.1 && jetzt < vorher
+    }
+
+    private func hinweisFallsNoetig(jetzt: Date) {
+        let stand = vorrat.stand
+        guard stand.rezeptAngefragtAm.map({ jetzt.timeIntervalSince($0) > .days(30) }) ?? true else { return }
+        guard jetzt.timeIntervalSince(stand.letzterHinweis ?? .distantPast) > .days(1) else { return }
+        let restPod = deviceManager.pumpManager?.pumpLifecycleProgress.map { max(0, 1 - $0.percentComplete) * stand.tageJePod * 86_400 }
+        let tage = vorrat.podsReichenBis(restAktuell: restPod, jetzt: jetzt).timeIntervalSince(jetzt) / 86_400
+        guard tage < Double(stand.rezeptHinweisAbTagen) else { return }
+
+        vorrat.stand.letzterHinweis = jetzt
+        let inhalt = UNMutableNotificationContent()
+        inhalt.title = "Pods reichen noch etwa \(Int(tage.rounded())) Tage"
+        inhalt.body = stand.pods == 0 ? "Ohne Pods wird's eng. Nachbestellen?" : "Zeit für das Folgerezept."
+        inhalt.sound = .default
+        let anfrage = UNNotificationRequest(identifier: "Zuckerschock.Vorrat.Rezept", content: inhalt, trigger: nil)
+        UNUserNotificationCenter.current().add(anfrage)
+    }
+}
