+// MARK: - Ansicht
+
+struct ZSVorratView: View {
+    @ObservedObject var vorrat: ZSVorrat
+    var quelle: ZSVorratQuelle
+    var schliessen: () -> Void
+
+    @State private var tagesmenge: Double?
+
+    private static let datum: DateFormatter = {
+        let f = DateFormatter()
+        f.locale = Locale(identifier: "de_DE")
+        f.dateFormat = "EE, d. MMM"
+        return f
+    }()
+
+    var body: some View {
+        let podsBis = vorrat.podsReichenBis(restAktuell: quelle.podRest)
+        let sensorenBis = vorrat.sensorenReichenBis(restAktuell: quelle.sensorRest)
+        let podTage = podsBis.timeIntervalSinceNow / 86_400
+
+        VStack(spacing: 0) {
+            ZSBlattKopf(titel: "Vorrat", abbrechen: schliessen)
+            ScrollView {
+                VStack(alignment: .leading, spacing: ZSMass.space6) {
+                    VStack(alignment: .leading, spacing: ZSMass.space2) {
+                        Text("Pods reichen bis")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                        Text(Self.datum.string(from: podsBis))
+                            .zsZahl(.wertGross)
+                            .foregroundStyle(ZSFarbe.text)
+                        Text("\(vorrat.stand.pods) auf Lager\(quelle.podRest.map { " + aktueller Pod (noch \(Int(($0 / 3600).rounded())) Std.)" } ?? "") · etwa \(max(0, Int(podTage.rounded()))) Tage")
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text2)
+                        Text("Zählt bei jedem Pod-Wechsel automatisch mit.")
+                            .font(ZSSchrift.footnote)
+                            .foregroundStyle(ZSFarbe.text2)
+                    }
+                    .zsKarte(hero: true)
+
+                    if vorrat.stand.pods == 0 {
+                        Text("Ohne Pods wird's eng. Nachbestellen?")
+                            .font(ZSSchrift.headline)
+                            .foregroundStyle(ZSFarbe.text)
+                    }
+
+                    if podTage < Double(vorrat.stand.rezeptHinweisAbTagen) {
+                        rezeptHinweis
+                    }
+
+                    VStack(spacing: 0) {
+                        ZSVorratZeile(titel: "Pods", untertitel: "je Pod \(ZSFormat.zahl(vorrat.stand.tageJePod, stellen: 0)) Tage", anzahl: $vorrat.stand.pods, einheit: "Stück")
+                        trenner
+                        ZSVorratZeile(titel: "Sensoren", untertitel: "aktueller bis \(Self.datum.string(from: Date().addingTimeInterval(quelle.sensorRest ?? 0))), reichen bis \(Self.datum.string(from: sensorenBis))", anzahl: $vorrat.stand.sensoren, einheit: "Stück")
+                        trenner
+                        ZSVorratZeile(titel: "Insulin", untertitel: insulinText, anzahl: $vorrat.stand.insulin, einheit: "Stück")
+                    }
+                    .background(RoundedRectangle(cornerRadius: ZSMass.radiusKarte, style: .continuous).fill(ZSFarbe.flaeche1))
+
+                    HStack(spacing: ZSMass.space3) {
+                        Button("Sensor gewechselt") { vorrat.sensorGewechselt() }
+                            .buttonStyle(ZSRandStil())
+                        Button("Pod von Hand abziehen") { vorrat.podGewechselt() }
+                            .buttonStyle(ZSRandStil())
+                    }
+                    .font(ZSSchrift.subhead.weight(.semibold))
+
+                    VStack(alignment: .leading, spacing: ZSMass.space3) {
+                        ZSAbschnittTitel(text: "Rezept und Lieferung")
+                        datumZeile("Folgerezept angefragt", wert: $vorrat.stand.rezeptAngefragtAm)
+                        datumZeile("Lieferung erwartet", wert: $vorrat.stand.lieferungErwartetAm)
+                        ZSEingabeFeld(titel: "Zubehör, Notiz") {
+                            TextField("z. B. Pod-Pflaster", text: $vorrat.stand.zubehoer)
+                        }
+                        Stepper("Rezept-Hinweis ab \(vorrat.stand.rezeptHinweisAbTagen) Tagen Reichweite", value: $vorrat.stand.rezeptHinweisAbTagen, in: 7...60)
+                            .font(ZSSchrift.subhead)
+                            .foregroundStyle(ZSFarbe.text)
+                        Text("Mails mit Rezepten und Lieferungen kommen später über deinen eigenen Server (n8n).")
+                            .font(ZSSchrift.footnote)
+                            .foregroundStyle(ZSFarbe.text2)
+                    }
+                    .zsKarte()
+                }
+                .padding(ZSMass.space5)
+            }
+        }
+        .background(ZSFarbe.grund.ignoresSafeArea())
+        .onAppear { quelle.tagesmenge { tagesmenge = $0 } }
+    }
+
+    private var trenner: some View {
+        Divider().overlay(ZSFarbe.haarlinie).padding(.leading, ZSMass.space4)
+    }
+
+    private var insulinText: String {
+        if let tage = vorrat.insulinTage(tagesmenge: tagesmenge) {
+            return "\(ZSFormat.zahl(vorrat.stand.insulinIEJeStueck, stellen: 0)) IE je Stück, reicht etwa \(Int(tage)) Tage bei \(ZSFormat.zahl(tagesmenge ?? 0, stellen: 0)) IE am Tag"
+        }
+        return "\(ZSFormat.zahl(vorrat.stand.insulinIEJeStueck, stellen: 0)) IE je Stück"
+    }
+
+    private var rezeptHinweis: some View {
+        VStack(alignment: .leading, spacing: ZSMass.space2) {
+            Label("Folgerezept fehlt vielleicht", systemImage: "questionmark.circle")
+                .font(ZSSchrift.headline)
+                .foregroundStyle(ZSFarbe.text)
+            Text(vorrat.stand.rezeptAngefragtAm.map { "Zuletzt angefragt am \(Self.datum.string(from: $0))" } ?? "Noch kein Rezept angefragt.")
+                .font(ZSSchrift.subhead)
+                .foregroundStyle(ZSFarbe.text2)
+            HStack(spacing: ZSMass.space3) {
+                Button("Rezept angefragt") { vorrat.stand.rezeptAngefragtAm = Date() }
+                    .buttonStyle(ZSRandStil())
+                Button("Schon erledigt") { vorrat.stand.rezeptAngefragtAm = Date() }
+                    .buttonStyle(ZSRandStil())
+            }
+            .font(ZSSchrift.subhead.weight(.semibold))
+        }
+        .zsKarte()
+    }
+
+    private func datumZeile(_ titel: String, wert: Binding<Date?>) -> some View {
+        HStack {
+            Text(titel)
+                .font(ZSSchrift.body)
+                .foregroundStyle(ZSFarbe.text)
+            Spacer()
+            if let datum = wert.wrappedValue {
+                DatePicker("", selection: Binding(get: { datum }, set: { wert.wrappedValue = $0 }), displayedComponents: .date)
+                    .labelsHidden()
+                Button {
+                    wert.wrappedValue = nil
+                } label: {
+                    Image(systemName: "xmark.circle.fill")
+                        .foregroundStyle(ZSFarbe.text3)
+                }
+                .accessibilityLabel("\(titel) löschen")
+            } else {
+                Button("Eintragen") { wert.wrappedValue = Date() }
+                    .foregroundStyle(ZSFarbe.orangeText)
+            }
+        }
+        .frame(minHeight: ZSMass.tap)
+    }
+}
+
+private struct ZSVorratZeile: View {
+    var titel: String
+    var untertitel: String
+    @Binding var anzahl: Int
+    var einheit: String
+
+    var body: some View {
+        HStack(spacing: ZSMass.space3) {
+            VStack(alignment: .leading, spacing: 2) {
+                Text(titel)
+                    .font(ZSSchrift.body)
+                    .foregroundStyle(ZSFarbe.text)
+                Text(untertitel)
+                    .font(ZSSchrift.subhead)
+                    .foregroundStyle(ZSFarbe.text2)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+            Spacer(minLength: ZSMass.space2)
+            Stepper(value: $anzahl, in: 0...99) {
+                HStack(alignment: .firstTextBaseline, spacing: ZSMass.space1) {
+                    Text("\(anzahl)")
+                        .zsZahl(.wertKlein)
+                        .foregroundStyle(ZSFarbe.text)
+                    Text(einheit)
+                        .zsZahl(.einheit)
+                        .foregroundStyle(ZSFarbe.text2)
+                }
+            }
+            .fixedSize()
+        }
+        .padding(.horizontal, ZSMass.space4)
+        .padding(.vertical, ZSMass.space3)
+        .accessibilityElement(children: .combine)
+        .accessibilityAdjustableAction { richtung in
+            switch richtung {
+            case .increment: anzahl = min(99, anzahl + 1)
+            case .decrement: anzahl = max(0, anzahl - 1)
+            @unknown default: break
+            }
+        }
+    }
+}
